axiom thm_DEST_REC_INJ [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ x : HOLTheory.recspace A, ∀ y : HOLTheory.recspace A, hol_eq (hol_eq (@_dest_rec T A _ x) (@_dest_rec T A _ y)) (hol_eq x y)
axiom thm_CONSTR_BOT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ c : num, ∀ i : A, ∀ r : num -> HOLTheory.recspace A, HOLTheory.not (hol_eq (@CONSTR T A _ c i r) (@BOTTOM T A _))
axiom thm_CONSTR_INJ [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ c1 : num, ∀ i1 : A, ∀ r1 : num -> HOLTheory.recspace A, ∀ c2 : num, ∀ i2 : A, ∀ r2 : num -> HOLTheory.recspace A, hol_eq (hol_eq (@CONSTR T A _ c1 i1 r1) (@CONSTR T A _ c2 i2 r2)) (hand (hol_eq c1 c2) (hand (hol_eq i1 i2) (hol_eq r1 r2)))
axiom thm_CONSTR_IND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (HOLTheory.recspace A) -> Prop, (hand (P (@BOTTOM T A _)) (∀ c : num, ∀ i : A, ∀ r : num -> HOLTheory.recspace A, (∀ n : num, P (r n)) -> P (@CONSTR T A _ c i r))) -> ∀ x : HOLTheory.recspace A, P x
axiom thm_CONSTR_REC [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ Fn : num -> A -> (num -> HOLTheory.recspace A) -> (num -> B) -> B, ∃ f : (HOLTheory.recspace A) -> B, ∀ c : num, ∀ i : A, ∀ r : num -> HOLTheory.recspace A, hol_eq (f (@CONSTR T A _ c i r)) (Fn c i r (fun n : num => f (r n)))
axiom thm_FCONS [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hand (∀ a : A, ∀ f : num -> A, hol_eq (@FCONS T A _ a f (NUMERAL _0)) a) (∀ a : A, ∀ f : num -> A, ∀ n : num, hol_eq (@FCONS T A _ a f (SUC n)) (f n))
axiom thm_FCONS_UNDO [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ f : num -> A, hol_eq f (@FCONS T A _ (f (NUMERAL _0)) (@o T num num A _ _ _ f SUC))
axiom thm_FNIL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ n : num, hol_eq (@FNIL T A _ n) (@epsilon T A _ (fun x : A => htrue))
axiom thm_sum_INDUCT [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : (HOLTheory.SUM A B) -> Prop, (hand (∀ a : A, P (@INL T A B _ _ a)) (∀ a : B, P (@INR T A B _ _ a))) -> ∀ x : HOLTheory.SUM A B, P x
axiom thm_sum_RECURSION [T : HOLTheory] : ∀ {A B Z' : Type} [Nonempty A] [Nonempty B] [Nonempty Z'], ∀ INL' : A -> Z', ∀ INR' : B -> Z', ∃ fn : (HOLTheory.SUM A B) -> Z', hand (∀ a : A, hol_eq (fn (@INL T A B _ _ a)) (INL' a)) (∀ a : B, hol_eq (fn (@INR T A B _ _ a)) (INR' a))
axiom thm_OUTL [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (x : A), hol_eq (@OUTL T A B _ _ (@INL T A B _ _ x)) x
axiom thm_OUTR [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (y : B), hol_eq (@OUTR T A B _ _ (@INR T A B _ _ y)) y
axiom thm_option_INDUCT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (option A) -> Prop, (hand (P (@NONE T A _)) (∀ a : A, P (@SOME T A _ a))) -> ∀ x : option A, P x
axiom thm_option_RECURSION [T : HOLTheory] : ∀ {A Z' : Type} [Nonempty A] [Nonempty Z'], ∀ NONE' : Z', ∀ SOME' : A -> Z', ∃ fn : (option A) -> Z', hand (hol_eq (fn (@NONE T A _)) NONE') (∀ a : A, hol_eq (fn (@SOME T A _ a)) (SOME' a))
axiom thm_list_INDUCT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (list A) -> Prop, (hand (P (@NIL T A _)) (∀ a0 : A, ∀ a1 : list A, (P a1) -> P (@CONS T A _ a0 a1))) -> ∀ x : list A, P x
axiom thm_list_RECURSION [T : HOLTheory] : ∀ {A Z' : Type} [Nonempty A] [Nonempty Z'], ∀ NIL' : Z', ∀ CONS' : A -> (list A) -> Z' -> Z', ∃ fn : (list A) -> Z', hand (hol_eq (fn (@NIL T A _)) NIL') (∀ a0 : A, ∀ a1 : list A, hol_eq (fn (@CONS T A _ a0 a1)) (CONS' a0 a1 (fn a1)))
axiom thm_FORALL_OPTION_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (option A) -> Prop, hol_eq (∀ x : option A, P x) (hand (P (@NONE T A _)) (∀ a : A, P (@SOME T A _ a)))
axiom thm_EXISTS_OPTION_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (option A) -> Prop, hol_eq (∃ x : option A, P x) (hor (P (@NONE T A _)) (∃ a : A, P (@SOME T A _ a)))
axiom thm_option_DISTINCT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ a : A, HOLTheory.not (hol_eq (@SOME T A _ a) (@NONE T A _))
axiom thm_option_INJ [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ a : A, ∀ b : A, hol_eq (hol_eq (@SOME T A _ a) (@SOME T A _ b)) (hol_eq a b)
axiom thm_ISO [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ g : B -> A, ∀ f : A -> B, hol_eq (@ISO T A B _ _ f g) (hand (∀ x : B, hol_eq (f (g x)) x) (∀ y : A, hol_eq (g (f y)) y))
axiom thm_ISO_REFL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], @ISO T A A _ _ (fun x : A => x) (fun x : A => x)
axiom thm_ISO_FUN [T : HOLTheory] : ∀ {A A' B B' : Type} [Nonempty A] [Nonempty A'] [Nonempty B] [Nonempty B'] (g : B -> B') (f' : A' -> A) (g' : B' -> B) (f : A -> A'), (hand (@ISO T A A' _ _ f f') (@ISO T B B' _ _ g g')) -> @ISO T (A -> B) (A' -> B') _ _ (fun h : A -> B => fun a' : A' => g (h (f' a'))) (fun h : A' -> B' => fun a : A => g' (h (f a)))
axiom thm_ISO_USAGE [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (g : B -> A) (f : A -> B), (@ISO T A B _ _ f g) -> hand (∀ P : A -> Prop, hol_eq (∀ x : A, P x) (∀ x : B, P (g x))) (hand (∀ P : A -> Prop, hol_eq (∃ x : A, P x) (∃ x : B, P (g x))) (∀ a : A, ∀ b : B, hol_eq (hol_eq a (g b)) (hol_eq (f a) b)))
axiom thm_HD [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (t : list A) (h : A), hol_eq (@HD T A _ (@CONS T A _ h t)) h
axiom thm_TL [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (h : A) (t : list A), hol_eq (@TL T A _ (@CONS T A _ h t)) t
axiom thm_APPEND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hand (∀ l : list A, hol_eq (@APPEND T A _ (@NIL T A _) l) l) (∀ h : A, ∀ t : list A, ∀ l : list A, hol_eq (@APPEND T A _ (@CONS T A _ h t) l) (@CONS T A _ h (@APPEND T A _ t l)))
axiom thm_REVERSE [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (l : list A) (x : A), hand (hol_eq (@REVERSE T A _ (@NIL T A _)) (@NIL T A _)) (hol_eq (@REVERSE T A _ (@CONS T A _ x l)) (@APPEND T A _ (@REVERSE T A _ l) (@CONS T A _ x (@NIL T A _))))
axiom thm_LENGTH [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hand (hol_eq (@LENGTH T A _ (@NIL T A _)) (NUMERAL _0)) (∀ h : A, ∀ t : list A, hol_eq (@LENGTH T A _ (@CONS T A _ h t)) (SUC (@LENGTH T A _ t)))
axiom thm_MAP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], hand (∀ f : A -> B, hol_eq (@MAP T A B _ _ f (@NIL T A _)) (@NIL T B _)) (∀ f : A -> B, ∀ h : A, ∀ t : list A, hol_eq (@MAP T A B _ _ f (@CONS T A _ h t)) (@CONS T B _ (f h) (@MAP T A B _ _ f t)))
axiom thm_LAST [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (h : A) (t : list A), hol_eq (@LAST T A _ (@CONS T A _ h t)) (@COND T A _ (hol_eq t (@NIL T A _)) h (@LAST T A _ t))
axiom thm_BUTLAST [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (h : A) (t : list A), hand (hol_eq (@BUTLAST T A _ (@NIL T A _)) (@NIL T A _)) (hol_eq (@BUTLAST T A _ (@CONS T A _ h t)) (@COND T (list A) _ (hol_eq t (@NIL T A _)) (@NIL T A _) (@CONS T A _ h (@BUTLAST T A _ t))))
axiom thm_REPLICATE [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (n : num) (x : A), hand (hol_eq (@REPLICATE T A _ (NUMERAL _0) x) (@NIL T A _)) (hol_eq (@REPLICATE T A _ (SUC n) x) (@CONS T A _ x (@REPLICATE T A _ n x)))
axiom thm_NULL [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (h : A) (t : list A), hand (hol_eq (@NULL T A _ (@NIL T A _)) htrue) (hol_eq (@NULL T A _ (@CONS T A _ h t)) hfalse)
axiom thm_ALL [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (h : A) (P : A -> Prop) (t : list A), hand (hol_eq (@ALL T A _ P (@NIL T A _)) htrue) (hol_eq (@ALL T A _ P (@CONS T A _ h t)) (hand (P h) (@ALL T A _ P t)))
axiom thm_EX [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (h : A) (P : A -> Prop) (t : list A), hand (hol_eq (@EX T A _ P (@NIL T A _)) hfalse) (hol_eq (@EX T A _ P (@CONS T A _ h t)) (hor (P h) (@EX T A _ P t)))
axiom thm_ITLIST [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (h : A) (f : A -> B -> B) (t : list A) (b : B), hand (hol_eq (@ITLIST T A B _ _ f (@NIL T A _) b) b) (hol_eq (@ITLIST T A B _ _ f (@CONS T A _ h t) b) (f h (@ITLIST T A B _ _ f t b)))
axiom thm_MEM [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (h : A) (x : A) (t : list A), hand (hol_eq (@MEM T A _ x (@NIL T A _)) hfalse) (hol_eq (@MEM T A _ x (@CONS T A _ h t)) (hor (hol_eq x h) (@MEM T A _ x t)))
axiom thm_ALL2_DEF [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (h1' : A) (P : A -> B -> Prop) (t1 : list A) (l2 : list B), hand (hol_eq (@ALL2 T A B _ _ P (@NIL T A _) l2) (hol_eq l2 (@NIL T B _))) (hol_eq (@ALL2 T A B _ _ P (@CONS T A _ h1' t1) l2) (@COND T Prop _ (hol_eq l2 (@NIL T B _)) hfalse (hand (P h1' (@HD T B _ l2)) (@ALL2 T A B _ _ P t1 (@TL T B _ l2)))))
axiom thm_ALL2 [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (h1' : A) (h2' : B) (P : A -> B -> Prop) (t1 : list A) (t2 : list B), hand (hol_eq (@ALL2 T A B _ _ P (@NIL T A _) (@NIL T B _)) htrue) (hand (hol_eq (@ALL2 T A B _ _ P (@CONS T A _ h1' t1) (@NIL T B _)) hfalse) (hand (hol_eq (@ALL2 T A B _ _ P (@NIL T A _) (@CONS T B _ h2' t2)) hfalse) (hol_eq (@ALL2 T A B _ _ P (@CONS T A _ h1' t1) (@CONS T B _ h2' t2)) (hand (P h1' h2') (@ALL2 T A B _ _ P t1 t2)))))
axiom thm_MAP2_DEF [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C] (h1' : A) (f : A -> B -> C) (t1 : list A) (l : list B), hand (hol_eq (@MAP2 T A B C _ _ _ f (@NIL T A _) l) (@NIL T C _)) (hol_eq (@MAP2 T A B C _ _ _ f (@CONS T A _ h1' t1) l) (@CONS T C _ (f h1' (@HD T B _ l)) (@MAP2 T A B C _ _ _ f t1 (@TL T B _ l))))
axiom thm_MAP2 [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C] (h1' : A) (h2' : B) (f : A -> B -> C) (t1 : list A) (t2 : list B), hand (hol_eq (@MAP2 T A B C _ _ _ f (@NIL T A _) (@NIL T B _)) (@NIL T C _)) (hol_eq (@MAP2 T A B C _ _ _ f (@CONS T A _ h1' t1) (@CONS T B _ h2' t2)) (@CONS T C _ (f h1' h2') (@MAP2 T A B C _ _ _ f t1 t2)))
axiom thm_EL [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (n : num) (l : list A), hand (hol_eq (@EL T A _ (NUMERAL _0) l) (@HD T A _ l)) (hol_eq (@EL T A _ (SUC n) l) (@EL T A _ n (@TL T A _ l)))
axiom thm_FILTER [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (h : A) (P : A -> Prop) (t : list A), hand (hol_eq (@FILTER T A _ P (@NIL T A _)) (@NIL T A _)) (hol_eq (@FILTER T A _ P (@CONS T A _ h t)) (@COND T (list A) _ (P h) (@CONS T A _ h (@FILTER T A _ P t)) (@FILTER T A _ P t)))
axiom thm_ASSOC [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (h : HOLTheory.prod A B) (a : A) (t : list (HOLTheory.prod A B)), hol_eq (@ASSOC T A B _ _ a (@CONS T (HOLTheory.prod A B) _ h t)) (@COND T B _ (hol_eq (@FST T A B _ _ h) a) (@SND T A B _ _ h) (@ASSOC T A B _ _ a t))
axiom thm_ITLIST2_DEF [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C] (h1' : A) (f : A -> B -> C -> C) (t1 : list A) (l2 : list B) (b : C), hand (hol_eq (@ITLIST2 T A B C _ _ _ f (@NIL T A _) l2 b) b) (hol_eq (@ITLIST2 T A B C _ _ _ f (@CONS T A _ h1' t1) l2 b) (f h1' (@HD T B _ l2) (@ITLIST2 T A B C _ _ _ f t1 (@TL T B _ l2) b)))
axiom thm_ITLIST2 [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C] (h1' : A) (h2' : B) (f : A -> B -> C -> C) (t1 : list A) (t2 : list B) (b : C), hand (hol_eq (@ITLIST2 T A B C _ _ _ f (@NIL T A _) (@NIL T B _) b) b) (hol_eq (@ITLIST2 T A B C _ _ _ f (@CONS T A _ h1' t1) (@CONS T B _ h2' t2) b) (f h1' h2' (@ITLIST2 T A B C _ _ _ f t1 t2 b)))
axiom thm_ZIP_DEF [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (h1' : A) (t1 : list A) (l2 : list B), hand (hol_eq (@ZIP T A B _ _ (@NIL T A _) l2) (@NIL T (HOLTheory.prod A B) _)) (hol_eq (@ZIP T A B _ _ (@CONS T A _ h1' t1) l2) (@CONS T (HOLTheory.prod A B) _ (@Prod_mk T A B _ _ h1' (@HD T B _ l2)) (@ZIP T A B _ _ t1 (@TL T B _ l2))))
axiom thm_ZIP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (h1' : A) (h2' : B) (t1 : list A) (t2 : list B), hand (hol_eq (@ZIP T A B _ _ (@NIL T A _) (@NIL T B _)) (@NIL T (HOLTheory.prod A B) _)) (hol_eq (@ZIP T A B _ _ (@CONS T A _ h1' t1) (@CONS T B _ h2' t2)) (@CONS T (HOLTheory.prod A B) _ (@Prod_mk T A B _ _ h1' h2') (@ZIP T A B _ _ t1 t2)))
axiom thm_ALLPAIRS [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (h : A) (f : A -> B -> Prop) (t : list A) (l : list B), hand (hol_eq (@ALLPAIRS T A B _ _ f (@NIL T A _) l) htrue) (hol_eq (@ALLPAIRS T A B _ _ f (@CONS T A _ h t) l) (hand (@ALL T B _ (f h) l) (@ALLPAIRS T A B _ _ f t l)))
axiom thm_PAIRWISE [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (h : A) (r : A -> A -> Prop) (t : list A), hand (hol_eq (@PAIRWISE T A _ r (@NIL T A _)) htrue) (hol_eq (@PAIRWISE T A _ r (@CONS T A _ h t)) (hand (@ALL T A _ (r h) t) (@PAIRWISE T A _ r t)))
axiom thm_list_of_seq [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (s : num -> A) (n : num), hand (hol_eq (@list_of_seq T A _ s (NUMERAL _0)) (@NIL T A _)) (hol_eq (@list_of_seq T A _ s (SUC n)) (@APPEND T A _ (@list_of_seq T A _ s n) (@CONS T A _ (s n) (@NIL T A _))))
axiom thm_NOT_CONS_NIL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ h : A, ∀ t : list A, HOLTheory.not (hol_eq (@CONS T A _ h t) (@NIL T A _))
axiom thm_LAST_CLAUSES [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (h : A) (k : A) (t : list A), hand (hol_eq (@LAST T A _ (@CONS T A _ h (@NIL T A _))) h) (hol_eq (@LAST T A _ (@CONS T A _ h (@CONS T A _ k t))) (@LAST T A _ (@CONS T A _ k t)))
axiom thm_APPEND_NIL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, hol_eq (@APPEND T A _ l (@NIL T A _)) l
axiom thm_APPEND_ASSOC [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, ∀ m : list A, ∀ n : list A, hol_eq (@APPEND T A _ l (@APPEND T A _ m n)) (@APPEND T A _ (@APPEND T A _ l m) n)
axiom thm_REVERSE_APPEND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, ∀ m : list A, hol_eq (@REVERSE T A _ (@APPEND T A _ l m)) (@APPEND T A _ (@REVERSE T A _ m) (@REVERSE T A _ l))
axiom thm_REVERSE_REVERSE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, hol_eq (@REVERSE T A _ (@REVERSE T A _ l)) l
axiom thm_REVERSE_EQ_EMPTY [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, hol_eq (hol_eq (@REVERSE T A _ l) (@NIL T A _)) (hol_eq l (@NIL T A _))
axiom thm_CONS_11 [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ h1' : A, ∀ h2' : A, ∀ t1 : list A, ∀ t2 : list A, hol_eq (hol_eq (@CONS T A _ h1' t1) (@CONS T A _ h2' t2)) (hand (hol_eq h1' h2') (hol_eq t1 t2))
axiom thm_list_CASES [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, hor (hol_eq l (@NIL T A _)) (∃ h : A, ∃ t : list A, hol_eq l (@CONS T A _ h t))
axiom thm_LIST_EQ [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l1 : list A, ∀ l2 : list A, hol_eq (hol_eq l1 l2) (hand (hol_eq (@LENGTH T A _ l1) (@LENGTH T A _ l2)) (∀ n : num, (Nat_lt n (@LENGTH T A _ l2)) -> hol_eq (@EL T A _ n l1) (@EL T A _ n l2)))
axiom thm_LENGTH_APPEND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, ∀ m : list A, hol_eq (@LENGTH T A _ (@APPEND T A _ l m)) (Nat_add (@LENGTH T A _ l) (@LENGTH T A _ m))
axiom thm_MAP_APPEND [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ l1 : list A, ∀ l2 : list A, hol_eq (@MAP T A B _ _ f (@APPEND T A _ l1 l2)) (@APPEND T B _ (@MAP T A B _ _ f l1) (@MAP T A B _ _ f l2))
axiom thm_LENGTH_MAP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ l : list A, ∀ f : A -> B, hol_eq (@LENGTH T B _ (@MAP T A B _ _ f l)) (@LENGTH T A _ l)
axiom thm_LENGTH_EQ_NIL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, hol_eq (hol_eq (@LENGTH T A _ l) (NUMERAL _0)) (hol_eq l (@NIL T A _))
axiom thm_LENGTH_EQ_CONS [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, ∀ n : num, hol_eq (hol_eq (@LENGTH T A _ l) (SUC n)) (∃ h : A, ∃ t : list A, hand (hol_eq l (@CONS T A _ h t)) (hol_eq (@LENGTH T A _ t) n))
axiom thm_LENGTH_REVERSE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, hol_eq (@LENGTH T A _ (@REVERSE T A _ l)) (@LENGTH T A _ l)
axiom thm_MAP_o [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : A -> B, ∀ g : B -> C, ∀ l : list A, hol_eq (@MAP T A C _ _ (@o T A B C _ _ _ g f) l) (@MAP T B C _ _ g (@MAP T A B _ _ f l))
axiom thm_MAP_EQ [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ g : A -> B, ∀ l : list A, (@ALL T A _ (fun x : A => hol_eq (f x) (g x)) l) -> hol_eq (@MAP T A B _ _ f l) (@MAP T A B _ _ g l)
axiom thm_ALL_IMP [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, ∀ l : list A, (hand (∀ x : A, (hand (@MEM T A _ x l) (P x)) -> Q x) (@ALL T A _ P l)) -> @ALL T A _ Q l
axiom thm_NOT_EX [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ l : list A, hol_eq (HOLTheory.not (@EX T A _ P l)) (@ALL T A _ (fun x : A => HOLTheory.not (P x)) l)
axiom thm_NOT_ALL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ l : list A, hol_eq (HOLTheory.not (@ALL T A _ P l)) (@EX T A _ (fun x : A => HOLTheory.not (P x)) l)
axiom thm_ALL_MAP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : B -> Prop, ∀ f : A -> B, ∀ l : list A, hol_eq (@ALL T B _ P (@MAP T A B _ _ f l)) (@ALL T A _ (@o T A B Prop _ _ _ P f) l)
axiom thm_ALL_EQ [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (R' : A -> Prop) (P : A -> Prop) (Q : A -> Prop), ∀ l : list A, (hand (@ALL T A _ R' l) (∀ x : A, (R' x) -> hol_eq (P x) (Q x))) -> hol_eq (@ALL T A _ P l) (@ALL T A _ Q l)
axiom thm_ALL_T [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, @ALL T A _ (fun x : A => htrue) l
axiom thm_MAP_EQ_ALL2 [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ l : list A, ∀ m : list A, (@ALL2 T A A _ _ (fun x : A => fun y : A => hol_eq (f x) (f y)) l m) -> hol_eq (@MAP T A B _ _ f l) (@MAP T A B _ _ f m)
axiom thm_ALL2_MAP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : B -> A -> Prop, ∀ f : A -> B, ∀ l : list A, hol_eq (@ALL2 T B A _ _ P (@MAP T A B _ _ f l) l) (@ALL T A _ (fun a : A => P (f a) a) l)
axiom thm_MAP_EQ_DEGEN [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, ∀ f : A -> A, (@ALL T A _ (fun x : A => hol_eq (f x) x) l) -> hol_eq (@MAP T A A _ _ f l) l
axiom thm_ALL2_AND_RIGHT [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ l : list A, ∀ m : list B, ∀ P : A -> Prop, ∀ Q : A -> B -> Prop, hol_eq (@ALL2 T A B _ _ (fun x : A => fun y : B => hand (P x) (Q x y)) l m) (hand (@ALL T A _ P l) (@ALL2 T A B _ _ Q l m))
axiom thm_ITLIST_APPEND [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B -> B, ∀ a : B, ∀ l1 : list A, ∀ l2 : list A, hol_eq (@ITLIST T A B _ _ f (@APPEND T A _ l1 l2) a) (@ITLIST T A B _ _ f l1 (@ITLIST T A B _ _ f l2 a))
axiom thm_ITLIST_EXTRA [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (a : A) (b : B), ∀ f : A -> B -> B, ∀ l : list A, hol_eq (@ITLIST T A B _ _ f (@APPEND T A _ l (@CONS T A _ a (@NIL T A _))) b) (@ITLIST T A B _ _ f l (f a b))
axiom thm_ALL_MP [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, ∀ l : list A, (hand (@ALL T A _ (fun x : A => (P x) -> Q x) l) (@ALL T A _ P l)) -> @ALL T A _ Q l
axiom thm_AND_ALL [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (P : A -> Prop) (Q : A -> Prop), ∀ l : list A, hol_eq (hand (@ALL T A _ P l) (@ALL T A _ Q l)) (@ALL T A _ (fun x : A => hand (P x) (Q x)) l)
axiom thm_EX_IMP [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, ∀ l : list A, (hand (∀ x : A, (hand (@MEM T A _ x l) (P x)) -> Q x) (@EX T A _ P l)) -> @EX T A _ Q l
axiom thm_ALL_MEM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ l : list A, hol_eq (∀ x : A, (@MEM T A _ x l) -> P x) (@ALL T A _ P l)
axiom thm_LENGTH_REPLICATE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ n : num, ∀ x : A, hol_eq (@LENGTH T A _ (@REPLICATE T A _ n x)) n
axiom thm_MEM_REPLICATE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ n : num, ∀ x : A, ∀ y : A, hol_eq (@MEM T A _ x (@REPLICATE T A _ n y)) (hand (hol_eq x y) (HOLTheory.not (hol_eq n (NUMERAL _0))))
axiom thm_EX_MAP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : B -> Prop, ∀ f : A -> B, ∀ l : list A, hol_eq (@EX T B _ P (@MAP T A B _ _ f l)) (@EX T A _ (@o T A B Prop _ _ _ P f) l)
axiom thm_EXISTS_EX [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, ∀ l : list B, hol_eq (∃ x : A, @EX T B _ (P x) l) (@EX T B _ (fun s : B => ∃ x : A, P x s) l)
axiom thm_FORALL_ALL [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, ∀ l : list B, hol_eq (∀ x : A, @ALL T B _ (P x) l) (@ALL T B _ (fun s : B => ∀ x : A, P x s) l)
axiom thm_MEM_APPEND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ x : A, ∀ l1 : list A, ∀ l2 : list A, hol_eq (@MEM T A _ x (@APPEND T A _ l1 l2)) (hor (@MEM T A _ x l1) (@MEM T A _ x l2))
axiom thm_MEM_MAP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ y : B, ∀ l : list A, hol_eq (@MEM T B _ y (@MAP T A B _ _ f l)) (∃ x : A, hand (@MEM T A _ x l) (hol_eq y (f x)))
axiom thm_FILTER_APPEND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ l1 : list A, ∀ l2 : list A, hol_eq (@FILTER T A _ P (@APPEND T A _ l1 l2)) (@APPEND T A _ (@FILTER T A _ P l1) (@FILTER T A _ P l2))
axiom thm_FILTER_MAP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : B -> Prop, ∀ f : A -> B, ∀ l : list A, hol_eq (@FILTER T B _ P (@MAP T A B _ _ f l)) (@MAP T A B _ _ f (@FILTER T A _ (@o T A B Prop _ _ _ P f) l))
axiom thm_MEM_FILTER [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ l : list A, ∀ x : A, hol_eq (@MEM T A _ x (@FILTER T A _ P l)) (hand (P x) (@MEM T A _ x l))
axiom thm_LENGTH_FILTER [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ l : list A, Nat_le (@LENGTH T A _ (@FILTER T A _ P l)) (@LENGTH T A _ l)
axiom thm_EX_MEM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ l : list A, hol_eq (∃ x : A, hand (P x) (@MEM T A _ x l)) (@EX T A _ P l)
axiom thm_MAP_FST_ZIP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ l1 : list A, ∀ l2 : list B, (hol_eq (@LENGTH T A _ l1) (@LENGTH T B _ l2)) -> hol_eq (@MAP T (HOLTheory.prod A B) A _ _ (@FST T A B _ _) (@ZIP T A B _ _ l1 l2)) l1
axiom thm_MAP_SND_ZIP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ l1 : list A, ∀ l2 : list B, (hol_eq (@LENGTH T A _ l1) (@LENGTH T B _ l2)) -> hol_eq (@MAP T (HOLTheory.prod A B) B _ _ (@SND T A B _ _) (@ZIP T A B _ _ l1 l2)) l2
axiom thm_LENGTH_ZIP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ l1 : list A, ∀ l2 : list B, (hol_eq (@LENGTH T A _ l1) (@LENGTH T B _ l2)) -> hol_eq (@LENGTH T (HOLTheory.prod A B) _ (@ZIP T A B _ _ l1 l2)) (@LENGTH T B _ l2)
axiom thm_MEM_ASSOC [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ l : list (HOLTheory.prod A B), ∀ x : A, hol_eq (@MEM T (HOLTheory.prod A B) _ (@Prod_mk T A B _ _ x (@ASSOC T A B _ _ x l)) l) (@MEM T A _ x (@MAP T (HOLTheory.prod A B) A _ _ (@FST T A B _ _) l))
axiom thm_ALL_APPEND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ l1 : list A, ∀ l2 : list A, hol_eq (@ALL T A _ P (@APPEND T A _ l1 l2)) (hand (@ALL T A _ P l1) (@ALL T A _ P l2))
axiom thm_MEM_EL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, ∀ n : num, (Nat_lt n (@LENGTH T A _ l)) -> @MEM T A _ (@EL T A _ n l) l
axiom thm_MEM_EXISTS_EL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, ∀ x : A, hol_eq (@MEM T A _ x l) (∃ i : num, hand (Nat_lt i (@LENGTH T A _ l)) (hol_eq x (@EL T A _ i l)))
axiom thm_ALL_EL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ l : list A, hol_eq (∀ i : num, (Nat_lt i (@LENGTH T A _ l)) -> P (@EL T A _ i l)) (@ALL T A _ P l)
axiom thm_ALL2_MAP2 [T : HOLTheory] : ∀ {A B C D : Type} [Nonempty A] [Nonempty B] [Nonempty C] [Nonempty D] (P : B -> D -> Prop), ∀ f : A -> B, ∀ g : C -> D, ∀ l : list A, ∀ m : list C, hol_eq (@ALL2 T B D _ _ P (@MAP T A B _ _ f l) (@MAP T C D _ _ g m)) (@ALL2 T A C _ _ (fun x : A => fun y : C => P (f x) (g y)) l m)
axiom thm_AND_ALL2 [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, ∀ Q : A -> B -> Prop, ∀ l : list A, ∀ m : list B, hol_eq (hand (@ALL2 T A B _ _ P l m) (@ALL2 T A B _ _ Q l m)) (@ALL2 T A B _ _ (fun x : A => fun y : B => hand (P x y) (Q x y)) l m)
axiom thm_ALLPAIRS_SYM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, ∀ l : list A, ∀ m : list B, hol_eq (@ALLPAIRS T A B _ _ P l m) (@ALLPAIRS T B A _ _ (fun x : B => fun y : A => P y x) m l)
axiom thm_ALLPAIRS_MEM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, ∀ l : list A, ∀ m : list B, hol_eq (∀ x : A, ∀ y : B, (hand (@MEM T A _ x l) (@MEM T B _ y m)) -> P x y) (@ALLPAIRS T A B _ _ P l m)
axiom thm_ALLPAIRS_MAP [T : HOLTheory] : ∀ {A B C D : Type} [Nonempty A] [Nonempty B] [Nonempty C] [Nonempty D], ∀ P : B -> D -> Prop, ∀ f : A -> B, ∀ g : C -> D, ∀ l : list A, ∀ m : list C, hol_eq (@ALLPAIRS T B D _ _ P (@MAP T A B _ _ f l) (@MAP T C D _ _ g m)) (@ALLPAIRS T A C _ _ (fun x : A => fun y : C => P (f x) (g y)) l m)
axiom thm_ALLPAIRS_EQ [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (R' : A -> B -> Prop) (R'' : A -> B -> Prop), ∀ l : list A, ∀ m : list B, ∀ P : A -> Prop, ∀ Q : B -> Prop, (hand (@ALL T A _ P l) (hand (@ALL T B _ Q m) (∀ p : A, ∀ q : B, (hand (P p) (Q q)) -> hol_eq (R' p q) (R'' p q)))) -> hol_eq (@ALLPAIRS T A B _ _ R' l m) (@ALLPAIRS T A B _ _ R'' l m)
axiom thm_ALL2_ALL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> A -> Prop, ∀ l : list A, hol_eq (@ALL2 T A A _ _ P l l) (@ALL T A _ (fun x : A => P x x) l)
axiom thm_APPEND_EQ_NIL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, ∀ m : list A, hol_eq (hol_eq (@APPEND T A _ l m) (@NIL T A _)) (hand (hol_eq l (@NIL T A _)) (hol_eq m (@NIL T A _)))
axiom thm_APPEND_LCANCEL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l1 : list A, ∀ l2 : list A, ∀ l3 : list A, hol_eq (hol_eq (@APPEND T A _ l1 l2) (@APPEND T A _ l1 l3)) (hol_eq l2 l3)
axiom thm_APPEND_RCANCEL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l1 : list A, ∀ l2 : list A, ∀ l3 : list A, hol_eq (hol_eq (@APPEND T A _ l1 l3) (@APPEND T A _ l2 l3)) (hol_eq l1 l2)
axiom thm_LENGTH_MAP2 [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : A -> B -> C, ∀ l : list A, ∀ m : list B, (hol_eq (@LENGTH T A _ l) (@LENGTH T B _ m)) -> hol_eq (@LENGTH T C _ (@MAP2 T A B C _ _ _ f l m)) (@LENGTH T B _ m)
axiom thm_EL_MAP2 [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : A -> B -> C, ∀ l : list A, ∀ m : list B, ∀ k : num, (hand (Nat_lt k (@LENGTH T A _ l)) (Nat_lt k (@LENGTH T B _ m))) -> hol_eq (@EL T C _ k (@MAP2 T A B C _ _ _ f l m)) (f (@EL T A _ k l) (@EL T B _ k m))
axiom thm_MAP_EQ_NIL [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ l : list A, hol_eq (hol_eq (@MAP T A B _ _ f l) (@NIL T B _)) (hol_eq l (@NIL T A _))
axiom thm_INJECTIVE_MAP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, hol_eq (∀ l : list A, ∀ m : list A, (hol_eq (@MAP T A B _ _ f l) (@MAP T A B _ _ f m)) -> hol_eq l m) (∀ x : A, ∀ y : A, (hol_eq (f x) (f y)) -> hol_eq x y)
axiom thm_SURJECTIVE_MAP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, hol_eq (∀ m : list B, ∃ l : list A, hol_eq (@MAP T A B _ _ f l) m) (∀ y : B, ∃ x : A, hol_eq (f x) y)
axiom thm_MAP_ID [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, hol_eq (@MAP T A A _ _ (fun x : A => x) l) l
axiom thm_MAP_I [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hol_eq (@MAP T A A _ _ (@I T A _)) (@I T (list A) _)
axiom thm_BUTLAST_CLAUSES [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hand (hol_eq (@BUTLAST T A _ (@NIL T A _)) (@NIL T A _)) (hand (∀ a : A, hol_eq (@BUTLAST T A _ (@CONS T A _ a (@NIL T A _))) (@NIL T A _)) (∀ a : A, ∀ h : A, ∀ t : list A, hol_eq (@BUTLAST T A _ (@CONS T A _ a (@CONS T A _ h t))) (@CONS T A _ a (@BUTLAST T A _ (@CONS T A _ h t)))))
axiom thm_BUTLAST_APPEND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, ∀ m : list A, hol_eq (@BUTLAST T A _ (@APPEND T A _ l m)) (@COND T (list A) _ (hol_eq m (@NIL T A _)) (@BUTLAST T A _ l) (@APPEND T A _ l (@BUTLAST T A _ m)))
axiom thm_APPEND_BUTLAST_LAST [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, (HOLTheory.not (hol_eq l (@NIL T A _))) -> hol_eq (@APPEND T A _ (@BUTLAST T A _ l) (@CONS T A _ (@LAST T A _ l) (@NIL T A _))) l
axiom thm_LAST_APPEND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ p : list A, ∀ q : list A, hol_eq (@LAST T A _ (@APPEND T A _ p q)) (@COND T A _ (hol_eq q (@NIL T A _)) (@LAST T A _ p) (@LAST T A _ q))
axiom thm_LENGTH_TL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, (HOLTheory.not (hol_eq l (@NIL T A _))) -> hol_eq (@LENGTH T A _ (@TL T A _ l)) (Nat_minus (@LENGTH T A _ l) (NUMERAL (BIT1 _0)))
axiom thm_LAST_REVERSE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, (HOLTheory.not (hol_eq l (@NIL T A _))) -> hol_eq (@LAST T A _ (@REVERSE T A _ l)) (@HD T A _ l)
axiom thm_HD_REVERSE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, (HOLTheory.not (hol_eq l (@NIL T A _))) -> hol_eq (@HD T A _ (@REVERSE T A _ l)) (@LAST T A _ l)
axiom thm_EL_APPEND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ k : num, ∀ l : list A, ∀ m : list A, hol_eq (@EL T A _ k (@APPEND T A _ l m)) (@COND T A _ (Nat_lt k (@LENGTH T A _ l)) (@EL T A _ k l) (@EL T A _ (Nat_minus k (@LENGTH T A _ l)) m))
axiom thm_EL_TL [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (l : list A), ∀ n : num, hol_eq (@EL T A _ n (@TL T A _ l)) (@EL T A _ (Nat_add n (NUMERAL (BIT1 _0))) l)
axiom thm_EL_CONS [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ n : num, ∀ h : A, ∀ t : list A, hol_eq (@EL T A _ n (@CONS T A _ h t)) (@COND T A _ (hol_eq n (NUMERAL _0)) h (@EL T A _ (Nat_minus n (NUMERAL (BIT1 _0))) t))
axiom thm_LAST_EL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, (HOLTheory.not (hol_eq l (@NIL T A _))) -> hol_eq (@LAST T A _ l) (@EL T A _ (Nat_minus (@LENGTH T A _ l) (NUMERAL (BIT1 _0))) l)
axiom thm_HD_APPEND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, ∀ m : list A, hol_eq (@HD T A _ (@APPEND T A _ l m)) (@COND T A _ (hol_eq l (@NIL T A _)) (@HD T A _ m) (@HD T A _ l))
axiom thm_CONS_HD_TL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, (HOLTheory.not (hol_eq l (@NIL T A _))) -> hol_eq l (@CONS T A _ (@HD T A _ l) (@TL T A _ l))
axiom thm_EL_MAP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ n : num, ∀ l : list A, (Nat_lt n (@LENGTH T A _ l)) -> hol_eq (@EL T B _ n (@MAP T A B _ _ f l)) (f (@EL T A _ n l))
axiom thm_MAP_REVERSE [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ l : list A, hol_eq (@REVERSE T B _ (@MAP T A B _ _ f l)) (@MAP T A B _ _ f (@REVERSE T A _ l))
axiom thm_ALL_FILTER [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, ∀ l : list A, hol_eq (@ALL T A _ P (@FILTER T A _ Q l)) (@ALL T A _ (fun x : A => (Q x) -> P x) l)
axiom thm_APPEND_SING [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ h : A, ∀ t : list A, hol_eq (@APPEND T A _ (@CONS T A _ h (@NIL T A _)) t) (@CONS T A _ h t)
axiom thm_MEM_APPEND_DECOMPOSE_LEFT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ x : A, ∀ l : list A, hol_eq (@MEM T A _ x l) (∃ l1 : list A, ∃ l2 : list A, hand (HOLTheory.not (@MEM T A _ x l1)) (hol_eq l (@APPEND T A _ l1 (@CONS T A _ x l2))))
axiom thm_MEM_APPEND_DECOMPOSE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ x : A, ∀ l : list A, hol_eq (@MEM T A _ x l) (∃ l1 : list A, ∃ l2 : list A, hol_eq l (@APPEND T A _ l1 (@CONS T A _ x l2)))
axiom thm_PAIRWISE_APPEND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ R' : A -> A -> Prop, ∀ l : list A, ∀ m : list A, hol_eq (@PAIRWISE T A _ R' (@APPEND T A _ l m)) (hand (@PAIRWISE T A _ R' l) (hand (@PAIRWISE T A _ R' m) (∀ x : A, ∀ y : A, (hand (@MEM T A _ x l) (@MEM T A _ y m)) -> R' x y)))
axiom thm_PAIRWISE_MAP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ R' : B -> B -> Prop, ∀ f : A -> B, ∀ l : list A, hol_eq (@PAIRWISE T B _ R' (@MAP T A B _ _ f l)) (@PAIRWISE T A _ (fun x : A => fun y : A => R' (f x) (f y)) l)
axiom thm_PAIRWISE_IMPLIES [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ R' : A -> A -> Prop, ∀ R'' : A -> A -> Prop, ∀ l : list A, (hand (@PAIRWISE T A _ R' l) (∀ x : A, ∀ y : A, (hand (@MEM T A _ x l) (hand (@MEM T A _ y l) (R' x y))) -> R'' x y)) -> @PAIRWISE T A _ R'' l
axiom thm_PAIRWISE_TRANSITIVE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ R' : A -> A -> Prop, ∀ x : A, ∀ y : A, ∀ l : list A, (∀ x' : A, ∀ y' : A, ∀ z : A, (hand (R' x' y') (R' y' z)) -> R' x' z) -> hol_eq (@PAIRWISE T A _ R' (@CONS T A _ x (@CONS T A _ y l))) (hand (R' x y) (@PAIRWISE T A _ R' (@CONS T A _ y l)))
axiom thm_LENGTH_LIST_OF_SEQ [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : num -> A, ∀ n : num, hol_eq (@LENGTH T A _ (@list_of_seq T A _ s n)) n
axiom thm_EL_LIST_OF_SEQ [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : num -> A, ∀ m : num, ∀ n : num, (Nat_lt m n) -> hol_eq (@EL T A _ m (@list_of_seq T A _ s n)) (s m)
axiom thm_LIST_OF_SEQ_EQ_NIL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : num -> A, ∀ n : num, hol_eq (hol_eq (@list_of_seq T A _ s n) (@NIL T A _)) (hol_eq n (NUMERAL _0))
axiom thm_LIST_OF_SEQ_EQ_SELF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, hol_eq (@list_of_seq T A _ (fun i : num => @EL T A _ i l) (@LENGTH T A _ l)) l
axiom thm_LENGTH_EQ_LIST_OF_SEQ [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, ∀ n : num, hol_eq (hol_eq (@LENGTH T A _ l) n) (hol_eq l (@list_of_seq T A _ (fun i : num => @EL T A _ i l) n))
axiom thm_MAP_LIST_OF_SEQ [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : num -> A, ∀ g : A -> B, ∀ n : num, hol_eq (@MAP T A B _ _ g (@list_of_seq T A _ f n)) (@list_of_seq T B _ (@o T num A B _ _ _ g f) n)
axiom thm_LIST_OF_SEQ [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hand (∀ f : num -> A, hol_eq (@list_of_seq T A _ f (NUMERAL _0)) (@NIL T A _)) (∀ f : num -> A, ∀ n : num, hol_eq (@list_of_seq T A _ f (SUC n)) (@CONS T A _ (f (NUMERAL _0)) (@list_of_seq T A _ (@o T num num A _ _ _ f SUC) n)))
axiom thm_MONO_ALL [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (P : A -> Prop) (Q : A -> Prop) (l : list A), (∀ x : A, (P x) -> Q x) -> (@ALL T A _ P l) -> @ALL T A _ Q l
axiom thm_MONO_ALL2 [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (P : A -> B -> Prop) (Q : A -> B -> Prop) (l : list A) (l' : list B), (∀ x : A, ∀ y : B, (P x y) -> Q x y) -> (@ALL2 T A B _ _ P l l') -> @ALL2 T A B _ _ Q l l'
axiom thm_char_INDUCT [T : HOLTheory] : ∀ P : char -> Prop, (∀ a0 : Prop, ∀ a1 : Prop, ∀ a2 : Prop, ∀ a3 : Prop, ∀ a4 : Prop, ∀ a5 : Prop, ∀ a6 : Prop, ∀ a7 : Prop, P (ASCII a0 a1 a2 a3 a4 a5 a6 a7)) -> ∀ x : char, P x
axiom thm_char_RECURSION [T : HOLTheory] : ∀ {Z' : Type} [Nonempty Z'], ∀ f : Prop -> Prop -> Prop -> Prop -> Prop -> Prop -> Prop -> Prop -> Z', ∃ fn : char -> Z', ∀ a0 : Prop, ∀ a1 : Prop, ∀ a2 : Prop, ∀ a3 : Prop, ∀ a4 : Prop, ∀ a5 : Prop, ∀ a6 : Prop, ∀ a7 : Prop, hol_eq (fn (ASCII a0 a1 a2 a3 a4 a5 a6 a7)) (f a0 a1 a2 a3 a4 a5 a6 a7)
axiom thm_dist [T : HOLTheory] : ∀ n : num, ∀ m : num, hol_eq (dist (@Prod_mk T num num _ _ m n)) (Nat_add (Nat_minus m n) (Nat_minus n m))
axiom thm_DIST_REFL [T : HOLTheory] : ∀ n : num, hol_eq (dist (@Prod_mk T num num _ _ n n)) (NUMERAL _0)
axiom thm_DIST_LZERO [T : HOLTheory] : ∀ n : num, hol_eq (dist (@Prod_mk T num num _ _ (NUMERAL _0) n)) n
axiom thm_DIST_RZERO [T : HOLTheory] : ∀ n : num, hol_eq (dist (@Prod_mk T num num _ _ n (NUMERAL _0))) n
axiom thm_DIST_SYM [T : HOLTheory] : ∀ m : num, ∀ n : num, hol_eq (dist (@Prod_mk T num num _ _ m n)) (dist (@Prod_mk T num num _ _ n m))
axiom thm_DIST_LADD [T : HOLTheory] : ∀ m : num, ∀ p : num, ∀ n : num, hol_eq (dist (@Prod_mk T num num _ _ (Nat_add m n) (Nat_add m p))) (dist (@Prod_mk T num num _ _ n p))
axiom thm_DIST_RADD [T : HOLTheory] : ∀ m : num, ∀ p : num, ∀ n : num, hol_eq (dist (@Prod_mk T num num _ _ (Nat_add m p) (Nat_add n p))) (dist (@Prod_mk T num num _ _ m n))
axiom thm_DIST_LADD_0 [T : HOLTheory] : ∀ m : num, ∀ n : num, hol_eq (dist (@Prod_mk T num num _ _ (Nat_add m n) m)) n
axiom thm_DIST_RADD_0 [T : HOLTheory] : ∀ m : num, ∀ n : num, hol_eq (dist (@Prod_mk T num num _ _ m (Nat_add m n))) n
axiom thm_DIST_LMUL [T : HOLTheory] : ∀ m : num, ∀ n : num, ∀ p : num, hol_eq (Nat_mul m (dist (@Prod_mk T num num _ _ n p))) (dist (@Prod_mk T num num _ _ (Nat_mul m n) (Nat_mul m p)))
axiom thm_DIST_RMUL [T : HOLTheory] : ∀ m : num, ∀ n : num, ∀ p : num, hol_eq (Nat_mul (dist (@Prod_mk T num num _ _ m n)) p) (dist (@Prod_mk T num num _ _ (Nat_mul m p) (Nat_mul n p)))
axiom thm_DIST_EQ_0 [T : HOLTheory] : ∀ m : num, ∀ n : num, hol_eq (hol_eq (dist (@Prod_mk T num num _ _ m n)) (NUMERAL _0)) (hol_eq m n)
axiom thm_DIST_ELIM_THM [T : HOLTheory] : ∀ (y : num) (x : num) (P : num -> Prop), hol_eq (P (dist (@Prod_mk T num num _ _ x y))) (∀ d : num, hand ((hol_eq x (Nat_add y d)) -> P d) ((hol_eq y (Nat_add x d)) -> P d))
axiom thm_DIST_TRIANGLE_LE [T : HOLTheory] : ∀ m : num, ∀ n : num, ∀ p : num, ∀ q : num, (Nat_le (Nat_add (dist (@Prod_mk T num num _ _ m n)) (dist (@Prod_mk T num num _ _ n p))) q) -> Nat_le (dist (@Prod_mk T num num _ _ m p)) q
axiom thm_DIST_TRIANGLES_LE [T : HOLTheory] : ∀ m : num, ∀ n : num, ∀ p : num, ∀ q : num, ∀ r : num, ∀ s : num, (hand (Nat_le (dist (@Prod_mk T num num _ _ m n)) r) (Nat_le (dist (@Prod_mk T num num _ _ p q)) s)) -> Nat_le (dist (@Prod_mk T num num _ _ m p)) (Nat_add (dist (@Prod_mk T num num _ _ n q)) (Nat_add r s))
axiom thm_BOUNDS_LINEAR [T : HOLTheory] : ∀ A : num, ∀ B : num, ∀ C : num, hol_eq (∀ n : num, Nat_le (Nat_mul A n) (Nat_add (Nat_mul B n) C)) (Nat_le A B)
axiom thm_BOUNDS_LINEAR_0 [T : HOLTheory] : ∀ A : num, ∀ B : num, hol_eq (∀ n : num, Nat_le (Nat_mul A n) B) (hol_eq A (NUMERAL _0))
axiom thm_BOUNDS_DIVIDED [T : HOLTheory] : ∀ P : num -> num, hol_eq (∃ B : num, ∀ n : num, Nat_le (P n) B) (∃ A : num, ∃ B : num, ∀ n : num, Nat_le (Nat_mul n (P n)) (Nat_add (Nat_mul A n) B))
axiom thm_BOUNDS_NOTZERO [T : HOLTheory] : ∀ P : num -> num -> num, ∀ A : num, ∀ B : num, (hand (hol_eq (P (NUMERAL _0) (NUMERAL _0)) (NUMERAL _0)) (∀ m : num, ∀ n : num, Nat_le (P m n) (Nat_add (Nat_mul A (Nat_add m n)) B))) -> ∃ B' : num, ∀ m : num, ∀ n : num, Nat_le (P m n) (Nat_mul B' (Nat_add m n))
axiom thm_BOUNDS_IGNORE [T : HOLTheory] : ∀ P : num -> num, ∀ Q : num -> num, hol_eq (∃ B : num, ∀ i : num, Nat_le (P i) (Nat_add (Q i) B)) (∃ B : num, ∃ N' : num, ∀ i : num, (Nat_le N' i) -> Nat_le (P i) (Nat_add (Q i) B))
axiom thm_is_nadd [T : HOLTheory] : ∀ x : num -> num, hol_eq (is_nadd x) (∃ B : num, ∀ m : num, ∀ n : num, Nat_le (dist (@Prod_mk T num num _ _ (Nat_mul m (x n)) (Nat_mul n (x m)))) (Nat_mul B (Nat_add m n)))
axiom thm_is_nadd_0 [T : HOLTheory] : is_nadd (fun n : num => NUMERAL _0)
axiom thm_NADD_CAUCHY [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∃ B : num, ∀ m : num, ∀ n : num, Nat_le (dist (@Prod_mk T num num _ _ (Nat_mul m (dest_nadd x n)) (Nat_mul n (dest_nadd x m)))) (Nat_mul B (Nat_add m n))
axiom thm_NADD_BOUND [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∃ A : num, ∃ B : num, ∀ n : num, Nat_le (dest_nadd x n) (Nat_add (Nat_mul A n) B)
axiom thm_NADD_MULTIPLICATIVE [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∃ B : num, ∀ m : num, ∀ n : num, Nat_le (dist (@Prod_mk T num num _ _ (dest_nadd x (Nat_mul m n)) (Nat_mul m (dest_nadd x n)))) (Nat_add (Nat_mul B m) B)
axiom thm_NADD_ADDITIVE [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∃ B : num, ∀ m : num, ∀ n : num, Nat_le (dist (@Prod_mk T num num _ _ (dest_nadd x (Nat_add m n)) (Nat_add (dest_nadd x m) (dest_nadd x n)))) B
axiom thm_NADD_SUC [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∃ B : num, ∀ n : num, Nat_le (dist (@Prod_mk T num num _ _ (dest_nadd x (SUC n)) (dest_nadd x n))) B
axiom thm_NADD_DIST_LEMMA [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∃ B : num, ∀ m : num, ∀ n : num, Nat_le (dist (@Prod_mk T num num _ _ (dest_nadd x (Nat_add m n)) (dest_nadd x m))) (Nat_mul B n)
axiom thm_NADD_DIST [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∃ B : num, ∀ m : num, ∀ n : num, Nat_le (dist (@Prod_mk T num num _ _ (dest_nadd x m) (dest_nadd x n))) (Nat_mul B (dist (@Prod_mk T num num _ _ m n)))
axiom thm_NADD_ALTMUL [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∃ A : num, ∃ B : num, ∀ n : num, Nat_le (dist (@Prod_mk T num num _ _ (Nat_mul n (dest_nadd x (dest_nadd y n))) (Nat_mul (dest_nadd x n) (dest_nadd y n)))) (Nat_add (Nat_mul A n) B)
axiom thm_nadd_eq [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, hol_eq (nadd_eq x y) (∃ B : num, ∀ n : num, Nat_le (dist (@Prod_mk T num num _ _ (dest_nadd x n) (dest_nadd y n))) B)
axiom thm_NADD_EQ_REFL [T : HOLTheory] : ∀ x : HOLTheory.nadd, nadd_eq x x
axiom thm_NADD_EQ_SYM [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, hol_eq (nadd_eq x y) (nadd_eq y x)
axiom thm_NADD_EQ_TRANS [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ z : HOLTheory.nadd, (hand (nadd_eq x y) (nadd_eq y z)) -> nadd_eq x z
axiom thm_nadd_of_num [T : HOLTheory] : ∀ k : num, hol_eq (nadd_of_num k) (mk_nadd (fun n : num => Nat_mul k n))
axiom thm_NADD_OF_NUM [T : HOLTheory] : ∀ k : num, hol_eq (dest_nadd (nadd_of_num k)) (fun n : num => Nat_mul k n)
axiom thm_NADD_OF_NUM_WELLDEF [T : HOLTheory] : ∀ m : num, ∀ n : num, (hol_eq m n) -> nadd_eq (nadd_of_num m) (nadd_of_num n)
axiom thm_NADD_OF_NUM_EQ [T : HOLTheory] : ∀ m : num, ∀ n : num, hol_eq (nadd_eq (nadd_of_num m) (nadd_of_num n)) (hol_eq m n)
axiom thm_nadd_le [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, hol_eq (nadd_le x y) (∃ B : num, ∀ n : num, Nat_le (dest_nadd x n) (Nat_add (dest_nadd y n) B))
axiom thm_NADD_LE_WELLDEF_LEMMA [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ x' : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ y' : HOLTheory.nadd, (hand (nadd_eq x x') (hand (nadd_eq y y') (nadd_le x y))) -> nadd_le x' y'
axiom thm_NADD_LE_WELLDEF [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ x' : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ y' : HOLTheory.nadd, (hand (nadd_eq x x') (nadd_eq y y')) -> hol_eq (nadd_le x y) (nadd_le x' y')
axiom thm_NADD_LE_REFL [T : HOLTheory] : ∀ x : HOLTheory.nadd, nadd_le x x
axiom thm_NADD_LE_TRANS [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ z : HOLTheory.nadd, (hand (nadd_le x y) (nadd_le y z)) -> nadd_le x z
axiom thm_NADD_LE_ANTISYM [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, hol_eq (hand (nadd_le x y) (nadd_le y x)) (nadd_eq x y)
axiom thm_NADD_LE_TOTAL_LEMMA [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, (HOLTheory.not (nadd_le x y)) -> ∀ B : num, ∃ n : num, hand (HOLTheory.not (hol_eq n (NUMERAL _0))) (Nat_lt (Nat_add (dest_nadd y n) B) (dest_nadd x n))
axiom thm_NADD_LE_TOTAL [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, hor (nadd_le x y) (nadd_le y x)
axiom thm_NADD_ARCH [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∃ n : num, nadd_le x (nadd_of_num n)
axiom thm_NADD_OF_NUM_LE [T : HOLTheory] : ∀ m : num, ∀ n : num, hol_eq (nadd_le (nadd_of_num m) (nadd_of_num n)) (Nat_le m n)
axiom thm_nadd_add [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, hol_eq (nadd_add x y) (mk_nadd (fun n : num => Nat_add (dest_nadd x n) (dest_nadd y n)))
axiom thm_NADD_ADD [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, hol_eq (dest_nadd (nadd_add x y)) (fun n : num => Nat_add (dest_nadd x n) (dest_nadd y n))
axiom thm_NADD_ADD_WELLDEF [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ x' : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ y' : HOLTheory.nadd, (hand (nadd_eq x x') (nadd_eq y y')) -> nadd_eq (nadd_add x y) (nadd_add x' y')
axiom thm_NADD_ADD_SYM [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, nadd_eq (nadd_add x y) (nadd_add y x)
axiom thm_NADD_ADD_ASSOC [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ z : HOLTheory.nadd, nadd_eq (nadd_add x (nadd_add y z)) (nadd_add (nadd_add x y) z)
axiom thm_NADD_ADD_LID [T : HOLTheory] : ∀ x : HOLTheory.nadd, nadd_eq (nadd_add (nadd_of_num (NUMERAL _0)) x) x
axiom thm_NADD_ADD_LCANCEL [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ z : HOLTheory.nadd, (nadd_eq (nadd_add x y) (nadd_add x z)) -> nadd_eq y z
axiom thm_NADD_LE_ADD [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, nadd_le x (nadd_add x y)
axiom thm_NADD_LE_EXISTS [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, (nadd_le x y) -> ∃ d : HOLTheory.nadd, nadd_eq y (nadd_add x d)
axiom thm_NADD_OF_NUM_ADD [T : HOLTheory] : ∀ m : num, ∀ n : num, nadd_eq (nadd_add (nadd_of_num m) (nadd_of_num n)) (nadd_of_num (Nat_add m n))
axiom thm_nadd_mul [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, hol_eq (nadd_mul x y) (mk_nadd (fun n : num => dest_nadd x (dest_nadd y n)))
axiom thm_NADD_MUL [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, hol_eq (dest_nadd (nadd_mul x y)) (fun n : num => dest_nadd x (dest_nadd y n))
axiom thm_NADD_MUL_SYM [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, nadd_eq (nadd_mul x y) (nadd_mul y x)
axiom thm_NADD_MUL_ASSOC [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ z : HOLTheory.nadd, nadd_eq (nadd_mul x (nadd_mul y z)) (nadd_mul (nadd_mul x y) z)
axiom thm_NADD_MUL_LID [T : HOLTheory] : ∀ x : HOLTheory.nadd, nadd_eq (nadd_mul (nadd_of_num (NUMERAL (BIT1 _0))) x) x
axiom thm_NADD_LDISTRIB [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ z : HOLTheory.nadd, nadd_eq (nadd_mul x (nadd_add y z)) (nadd_add (nadd_mul x y) (nadd_mul x z))
axiom thm_NADD_MUL_WELLDEF_LEMMA [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ y' : HOLTheory.nadd, (nadd_eq y y') -> nadd_eq (nadd_mul x y) (nadd_mul x y')
axiom thm_NADD_MUL_WELLDEF [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ x' : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ y' : HOLTheory.nadd, (hand (nadd_eq x x') (nadd_eq y y')) -> nadd_eq (nadd_mul x y) (nadd_mul x' y')
axiom thm_NADD_OF_NUM_MUL [T : HOLTheory] : ∀ m : num, ∀ n : num, nadd_eq (nadd_mul (nadd_of_num m) (nadd_of_num n)) (nadd_of_num (Nat_mul m n))
axiom thm_NADD_LE_0 [T : HOLTheory] : ∀ x : HOLTheory.nadd, nadd_le (nadd_of_num (NUMERAL _0)) x
axiom thm_NADD_EQ_IMP_LE [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, (nadd_eq x y) -> nadd_le x y
axiom thm_NADD_LE_LMUL [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ z : HOLTheory.nadd, (nadd_le y z) -> nadd_le (nadd_mul x y) (nadd_mul x z)
axiom thm_NADD_LE_RMUL [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ z : HOLTheory.nadd, (nadd_le x y) -> nadd_le (nadd_mul x z) (nadd_mul y z)
axiom thm_NADD_LE_RADD [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ z : HOLTheory.nadd, hol_eq (nadd_le (nadd_add x z) (nadd_add y z)) (nadd_le x y)
axiom thm_NADD_LE_LADD [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ z : HOLTheory.nadd, hol_eq (nadd_le (nadd_add x y) (nadd_add x z)) (nadd_le y z)
axiom thm_NADD_RDISTRIB [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ z : HOLTheory.nadd, nadd_eq (nadd_mul (nadd_add x y) z) (nadd_add (nadd_mul x z) (nadd_mul y z))
axiom thm_NADD_ARCH_MULT [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ k : num, (HOLTheory.not (nadd_eq x (nadd_of_num (NUMERAL _0)))) -> ∃ N' : num, nadd_le (nadd_of_num k) (nadd_mul (nadd_of_num N') x)
axiom thm_NADD_ARCH_ZERO [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ k : HOLTheory.nadd, (∀ n : num, nadd_le (nadd_mul (nadd_of_num n) x) k) -> nadd_eq x (nadd_of_num (NUMERAL _0))
axiom thm_NADD_ARCH_LEMMA [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∀ y : HOLTheory.nadd, ∀ z : HOLTheory.nadd, (∀ n : num, nadd_le (nadd_mul (nadd_of_num n) x) (nadd_add (nadd_mul (nadd_of_num n) y) z)) -> nadd_le x y
axiom thm_NADD_COMPLETE [T : HOLTheory] : ∀ P : HOLTheory.nadd -> Prop, (hand (∃ x : HOLTheory.nadd, P x) (∃ M : HOLTheory.nadd, ∀ x : HOLTheory.nadd, (P x) -> nadd_le x M)) -> ∃ M : HOLTheory.nadd, hand (∀ x : HOLTheory.nadd, (P x) -> nadd_le x M) (∀ M' : HOLTheory.nadd, (∀ x : HOLTheory.nadd, (P x) -> nadd_le x M') -> nadd_le M M')
axiom thm_NADD_UBOUND [T : HOLTheory] : ∀ x : HOLTheory.nadd, ∃ B : num, ∃ N' : num, ∀ n : num, (Nat_le N' n) -> Nat_le (dest_nadd x n) (Nat_mul B n)
axiom thm_NADD_NONZERO [T : HOLTheory] : ∀ x : HOLTheory.nadd, (HOLTheory.not (nadd_eq x (nadd_of_num (NUMERAL _0)))) -> ∃ N' : num, ∀ n : num, (Nat_le N' n) -> HOLTheory.not (hol_eq (dest_nadd x n) (NUMERAL _0))
axiom thm_NADD_LBOUND [T : HOLTheory] : ∀ x : HOLTheory.nadd, (HOLTheory.not (nadd_eq x (nadd_of_num (NUMERAL _0)))) -> ∃ A : num, ∃ N' : num, ∀ n : num, (Nat_le N' n) -> Nat_le n (Nat_mul A (dest_nadd x n))
axiom thm_nadd_rinv [T : HOLTheory] : ∀ x : HOLTheory.nadd, hol_eq (nadd_rinv x) (fun n : num => DIV (Nat_mul n n) (dest_nadd x n))
