axiom thm_FINITE_REAL_INTERVAL [T : HOLTheory] : hand (∀ a : HOLTheory.Real, HOLTheory.not (@FINITE T HOLTheory.Real _ (@GSPEC T HOLTheory.Real _ (fun GEN_PVAR_202 : HOLTheory.Real => ∃ x : HOLTheory.Real, @SETSPEC T HOLTheory.Real _ GEN_PVAR_202 (real_lt a x) x)))) (hand (∀ a : HOLTheory.Real, HOLTheory.not (@FINITE T HOLTheory.Real _ (@GSPEC T HOLTheory.Real _ (fun GEN_PVAR_203 : HOLTheory.Real => ∃ x : HOLTheory.Real, @SETSPEC T HOLTheory.Real _ GEN_PVAR_203 (real_le a x) x)))) (hand (∀ b : HOLTheory.Real, HOLTheory.not (@FINITE T HOLTheory.Real _ (@GSPEC T HOLTheory.Real _ (fun GEN_PVAR_204 : HOLTheory.Real => ∃ x : HOLTheory.Real, @SETSPEC T HOLTheory.Real _ GEN_PVAR_204 (real_lt x b) x)))) (hand (∀ b : HOLTheory.Real, HOLTheory.not (@FINITE T HOLTheory.Real _ (@GSPEC T HOLTheory.Real _ (fun GEN_PVAR_205 : HOLTheory.Real => ∃ x : HOLTheory.Real, @SETSPEC T HOLTheory.Real _ GEN_PVAR_205 (real_le x b) x)))) (hand (∀ a : HOLTheory.Real, ∀ b : HOLTheory.Real, hol_eq (@FINITE T HOLTheory.Real _ (@GSPEC T HOLTheory.Real _ (fun GEN_PVAR_206 : HOLTheory.Real => ∃ x : HOLTheory.Real, @SETSPEC T HOLTheory.Real _ GEN_PVAR_206 (hand (real_lt a x) (real_lt x b)) x))) (real_le b a)) (hand (∀ a : HOLTheory.Real, ∀ b : HOLTheory.Real, hol_eq (@FINITE T HOLTheory.Real _ (@GSPEC T HOLTheory.Real _ (fun GEN_PVAR_207 : HOLTheory.Real => ∃ x : HOLTheory.Real, @SETSPEC T HOLTheory.Real _ GEN_PVAR_207 (hand (real_le a x) (real_lt x b)) x))) (real_le b a)) (hand (∀ a : HOLTheory.Real, ∀ b : HOLTheory.Real, hol_eq (@FINITE T HOLTheory.Real _ (@GSPEC T HOLTheory.Real _ (fun GEN_PVAR_208 : HOLTheory.Real => ∃ x : HOLTheory.Real, @SETSPEC T HOLTheory.Real _ GEN_PVAR_208 (hand (real_lt a x) (real_le x b)) x))) (real_le b a)) (∀ a : HOLTheory.Real, ∀ b : HOLTheory.Real, hol_eq (@FINITE T HOLTheory.Real _ (@GSPEC T HOLTheory.Real _ (fun GEN_PVAR_209 : HOLTheory.Real => ∃ x : HOLTheory.Real, @SETSPEC T HOLTheory.Real _ GEN_PVAR_209 (hand (real_le a x) (real_le x b)) x))) (real_le b a))))))))
axiom thm_real_INFINITE [T : HOLTheory] : @INFINITE T HOLTheory.Real _ (@UNIV T HOLTheory.Real _)
axiom thm_HAS_SIZE_INDEX [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, ∀ n : num, (@HAS_SIZE T A _ s n) -> ∃ f : num -> A, hand (∀ m : num, (Nat_lt m n) -> @IN T A _ (f m) s) (∀ x : A, (@IN T A _ x s) -> @hexists_one T num _ (fun m : num => hand (Nat_lt m n) (hol_eq (f m) x)))
axiom thm_INFINITE_ENUMERATE [T : HOLTheory] : ∀ s : num -> Prop, (@INFINITE T num _ s) -> ∃ r : num -> num, hand (∀ m : num, ∀ n : num, (Nat_lt m n) -> Nat_lt (r m) (r n)) (hol_eq (@IMAGE T num num _ _ r (@UNIV T num _)) s)
axiom thm_INFINITE_ENUMERATE_EQ [T : HOLTheory] : ∀ s : num -> Prop, hol_eq (@INFINITE T num _ s) (∃ r : num -> num, hand (∀ m : num, ∀ n : num, (Nat_lt m n) -> Nat_lt (r m) (r n)) (hol_eq (@IMAGE T num num _ _ r (@UNIV T num _)) s))
axiom thm_INFINITE_ENUMERATE_SUBSET [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, hol_eq (@INFINITE T A _ s) (∃ f : num -> A, hand (∀ x : num, @IN T A _ (f x) s) (∀ x : num, ∀ y : num, (hol_eq (f x) (f y)) -> hol_eq x y))
axiom thm_set_of_list [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (h : A) (t : list A), hand (hol_eq (@set_of_list T A _ (@NIL T A _)) (@EMPTY T A _)) (hol_eq (@set_of_list T A _ (@CONS T A _ h t)) (@INSERT T A _ h (@set_of_list T A _ t)))
axiom thm_list_of_set [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, hol_eq (@list_of_set T A _ s) (@epsilon T (list A) _ (fun l : list A => hand (hol_eq (@set_of_list T A _ l) s) (hol_eq (@LENGTH T A _ l) (@CARD T A _ s))))
axiom thm_LIST_OF_SET_PROPERTIES [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, (@FINITE T A _ s) -> hand (hol_eq (@set_of_list T A _ (@list_of_set T A _ s)) s) (hol_eq (@LENGTH T A _ (@list_of_set T A _ s)) (@CARD T A _ s))
axiom thm_SET_OF_LIST_OF_SET [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, (@FINITE T A _ s) -> hol_eq (@set_of_list T A _ (@list_of_set T A _ s)) s
axiom thm_LENGTH_LIST_OF_SET [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, (@FINITE T A _ s) -> hol_eq (@LENGTH T A _ (@list_of_set T A _ s)) (@CARD T A _ s)
axiom thm_MEM_LIST_OF_SET [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, (@FINITE T A _ s) -> ∀ x : A, hol_eq (@MEM T A _ x (@list_of_set T A _ s)) (@IN T A _ x s)
axiom thm_FINITE_SET_OF_LIST [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, @FINITE T A _ (@set_of_list T A _ l)
axiom thm_IN_SET_OF_LIST [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ x : A, ∀ l : list A, hol_eq (@IN T A _ x (@set_of_list T A _ l)) (@MEM T A _ x l)
axiom thm_SET_OF_LIST_APPEND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l1 : list A, ∀ l2 : list A, hol_eq (@set_of_list T A _ (@APPEND T A _ l1 l2)) (@UNION T A _ (@set_of_list T A _ l1) (@set_of_list T A _ l2))
axiom thm_SET_OF_LIST_MAP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ l : list A, hol_eq (@set_of_list T B _ (@MAP T A B _ _ f l)) (@IMAGE T A B _ _ f (@set_of_list T A _ l))
axiom thm_SET_OF_LIST_EQ_EMPTY [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ l : list A, hol_eq (hol_eq (@set_of_list T A _ l) (@EMPTY T A _)) (hol_eq l (@NIL T A _))
axiom thm_LIST_OF_SET_EMPTY [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hol_eq (@list_of_set T A _ (@EMPTY T A _)) (@NIL T A _)
axiom thm_LIST_OF_SET_SING [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ a : A, hol_eq (@list_of_set T A _ (@INSERT T A _ a (@EMPTY T A _))) (@CONS T A _ a (@NIL T A _))
axiom thm_pairwise [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, ∀ r : A -> A -> Prop, hol_eq (@pairwise T A _ r s) (∀ x : A, ∀ y : A, (hand (@IN T A _ x s) (hand (@IN T A _ y s) (HOLTheory.not (hol_eq x y)))) -> r x y)
axiom thm_PAIRWISE_EMPTY [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ r : A -> A -> Prop, hol_eq (@pairwise T A _ r (@EMPTY T A _)) htrue
axiom thm_PAIRWISE_SING [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ r : A -> A -> Prop, ∀ x : A, hol_eq (@pairwise T A _ r (@INSERT T A _ x (@EMPTY T A _))) htrue
axiom thm_PAIRWISE_IMP [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> A -> Prop, ∀ Q : A -> A -> Prop, ∀ s : A -> Prop, (hand (@pairwise T A _ P s) (∀ x : A, ∀ y : A, (hand (@IN T A _ x s) (hand (@IN T A _ y s) (hand (P x y) (HOLTheory.not (hol_eq x y))))) -> Q x y)) -> @pairwise T A _ Q s
axiom thm_PAIRWISE_MONO [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ r : A -> A -> Prop, ∀ s : A -> Prop, ∀ t : A -> Prop, (hand (@pairwise T A _ r s) (@SUBSET T A _ t s)) -> @pairwise T A _ r t
axiom thm_PAIRWISE_AND [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ R' : A -> A -> Prop, ∀ R'' : A -> A -> Prop, ∀ s : A -> Prop, hol_eq (hand (@pairwise T A _ R' s) (@pairwise T A _ R'' s)) (@pairwise T A _ (fun x : A => fun y : A => hand (R' x y) (R'' x y)) s)
axiom thm_PAIRWISE_INSERT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ r : A -> A -> Prop, ∀ x : A, ∀ s : A -> Prop, hol_eq (@pairwise T A _ r (@INSERT T A _ x s)) (hand (∀ y : A, (hand (@IN T A _ y s) (HOLTheory.not (hol_eq y x))) -> hand (r x y) (r y x)) (@pairwise T A _ r s))
axiom thm_PAIRWISE_INSERT_SYMMETRIC [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ r : A -> A -> Prop, ∀ x : A, ∀ s : A -> Prop, (∀ y : A, (@IN T A _ y s) -> hol_eq (r x y) (r y x)) -> hol_eq (@pairwise T A _ r (@INSERT T A _ x s)) (hand (∀ y : A, (hand (@IN T A _ y s) (HOLTheory.not (hol_eq y x))) -> r x y) (@pairwise T A _ r s))
axiom thm_PAIRWISE_IMAGE [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B] (s : A -> Prop), ∀ r : B -> B -> Prop, ∀ f : A -> B, hol_eq (@pairwise T B _ r (@IMAGE T A B _ _ f s)) (@pairwise T A _ (fun x : A => fun y : A => (HOLTheory.not (hol_eq (f x) (f y))) -> r (f x) (f y)) s)
axiom thm_PAIRWISE_UNION [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ R' : A -> A -> Prop, ∀ s : A -> Prop, ∀ t : A -> Prop, hol_eq (@pairwise T A _ R' (@UNION T A _ s t)) (hand (@pairwise T A _ R' s) (hand (@pairwise T A _ R' t) (∀ x : A, ∀ y : A, (hand (@IN T A _ x (@DIFF T A _ s t)) (@IN T A _ y (@DIFF T A _ t s))) -> hand (R' x y) (R' y x))))
axiom thm_PAIRWISE_CHAIN_UNIONS [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ R' : A -> A -> Prop, ∀ c : (A -> Prop) -> Prop, (hand (∀ s : A -> Prop, (@IN T (A -> Prop) _ s c) -> @pairwise T A _ R' s) (∀ s : A -> Prop, ∀ t : A -> Prop, (hand (@IN T (A -> Prop) _ s c) (@IN T (A -> Prop) _ t c)) -> hor (@SUBSET T A _ s t) (@SUBSET T A _ t s))) -> @pairwise T A _ R' (@UNIONS T A _ c)
axiom thm_DIFF_UNIONS_PAIRWISE_DISJOINT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : (A -> Prop) -> Prop, ∀ t : (A -> Prop) -> Prop, (hand (@pairwise T (A -> Prop) _ (@DISJOINT T A _) s) (@SUBSET T (A -> Prop) _ t s)) -> hol_eq (@DIFF T A _ (@UNIONS T A _ s) (@UNIONS T A _ t)) (@UNIONS T A _ (@DIFF T (A -> Prop) _ s t))
axiom thm_INTER_UNIONS_PAIRWISE_DISJOINT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : (A -> Prop) -> Prop, ∀ t : (A -> Prop) -> Prop, (@pairwise T (A -> Prop) _ (@DISJOINT T A _) (@UNION T (A -> Prop) _ s t)) -> hol_eq (@INTER T A _ (@UNIONS T A _ s) (@UNIONS T A _ t)) (@UNIONS T A _ (@INTER T (A -> Prop) _ s t))
axiom thm_PSUBSET_UNIONS_PAIRWISE_DISJOINT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ u : (A -> Prop) -> Prop, ∀ v : (A -> Prop) -> Prop, (hand (@pairwise T (A -> Prop) _ (@DISJOINT T A _) v) (@PSUBSET T (A -> Prop) _ u (@DELETE T (A -> Prop) _ v (@EMPTY T A _)))) -> @PSUBSET T A _ (@UNIONS T A _ u) (@UNIONS T A _ v)
axiom thm_UNION_OF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : ((A -> Prop) -> Prop) -> Prop, ∀ Q : (A -> Prop) -> Prop, hol_eq (@UNION_OF T A _ P Q) (fun s : A -> Prop => ∃ u : (A -> Prop) -> Prop, hand (P u) (hand (∀ c : A -> Prop, (@IN T (A -> Prop) _ c u) -> Q c) (hol_eq (@UNIONS T A _ u) s)))
axiom thm_INTERSECTION_OF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : ((A -> Prop) -> Prop) -> Prop, ∀ Q : (A -> Prop) -> Prop, hol_eq (@INTERSECTION_OF T A _ P Q) (fun s : A -> Prop => ∃ u : (A -> Prop) -> Prop, hand (P u) (hand (∀ c : A -> Prop, (@IN T (A -> Prop) _ c u) -> Q c) (hol_eq (@INTERS T A _ u) s)))
axiom thm_UNION_OF_INC [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : ((A -> Prop) -> Prop) -> Prop, ∀ Q : (A -> Prop) -> Prop, ∀ s : A -> Prop, (hand (P (@INSERT T (A -> Prop) _ s (@EMPTY T (A -> Prop) _))) (Q s)) -> @UNION_OF T A _ P Q s
axiom thm_INTERSECTION_OF_INC [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : ((A -> Prop) -> Prop) -> Prop, ∀ Q : (A -> Prop) -> Prop, ∀ s : A -> Prop, (hand (P (@INSERT T (A -> Prop) _ s (@EMPTY T (A -> Prop) _))) (Q s)) -> @INTERSECTION_OF T A _ P Q s
axiom thm_UNION_OF_MONO [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : ((A -> Prop) -> Prop) -> Prop, ∀ Q : (A -> Prop) -> Prop, ∀ Q' : (A -> Prop) -> Prop, ∀ s : A -> Prop, (hand (@UNION_OF T A _ P Q s) (∀ x : A -> Prop, (Q x) -> Q' x)) -> @UNION_OF T A _ P Q' s
axiom thm_INTERSECTION_OF_MONO [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : ((A -> Prop) -> Prop) -> Prop, ∀ Q : (A -> Prop) -> Prop, ∀ Q' : (A -> Prop) -> Prop, ∀ s : A -> Prop, (hand (@INTERSECTION_OF T A _ P Q s) (∀ x : A -> Prop, (Q x) -> Q' x)) -> @INTERSECTION_OF T A _ P Q' s
axiom thm_FORALL_UNION_OF [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (P : ((A -> Prop) -> Prop) -> Prop) (Q : (A -> Prop) -> Prop) (R' : (A -> Prop) -> Prop), hol_eq (∀ s : A -> Prop, (@UNION_OF T A _ P Q s) -> R' s) (∀ t : (A -> Prop) -> Prop, (hand (P t) (∀ c : A -> Prop, (@IN T (A -> Prop) _ c t) -> Q c)) -> R' (@UNIONS T A _ t))
axiom thm_FORALL_INTERSECTION_OF [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (P : ((A -> Prop) -> Prop) -> Prop) (Q : (A -> Prop) -> Prop) (R' : (A -> Prop) -> Prop), hol_eq (∀ s : A -> Prop, (@INTERSECTION_OF T A _ P Q s) -> R' s) (∀ t : (A -> Prop) -> Prop, (hand (P t) (∀ c : A -> Prop, (@IN T (A -> Prop) _ c t) -> Q c)) -> R' (@INTERS T A _ t))
axiom thm_UNION_OF_EMPTY [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : ((A -> Prop) -> Prop) -> Prop, ∀ Q : (A -> Prop) -> Prop, (P (@EMPTY T (A -> Prop) _)) -> @UNION_OF T A _ P Q (@EMPTY T A _)
axiom thm_INTERSECTION_OF_EMPTY [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : ((A -> Prop) -> Prop) -> Prop, ∀ Q : (A -> Prop) -> Prop, (P (@EMPTY T (A -> Prop) _)) -> @INTERSECTION_OF T A _ P Q (@UNIV T A _)
axiom thm_ARBITRARY [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : (A -> Prop) -> Prop, hol_eq (@ARBITRARY T A _ s) htrue
axiom thm_ARBITRARY_UNION_OF_ALT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ B : (A -> Prop) -> Prop, ∀ s : A -> Prop, hol_eq (@UNION_OF T A _ (@ARBITRARY T A _) B s) (∀ x : A, (@IN T A _ x s) -> ∃ u : A -> Prop, hand (@IN T (A -> Prop) _ u B) (hand (@IN T A _ x u) (@SUBSET T A _ u s)))
axiom thm_ARBITRARY_UNION_OF_EMPTY [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, @UNION_OF T A _ (@ARBITRARY T A _) P (@EMPTY T A _)
axiom thm_ARBITRARY_INTERSECTION_OF_EMPTY [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, @INTERSECTION_OF T A _ (@ARBITRARY T A _) P (@UNIV T A _)
axiom thm_ARBITRARY_UNION_OF_INC [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, ∀ s : A -> Prop, (P s) -> @UNION_OF T A _ (@ARBITRARY T A _) P s
axiom thm_ARBITRARY_INTERSECTION_OF_INC [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, ∀ s : A -> Prop, (P s) -> @INTERSECTION_OF T A _ (@ARBITRARY T A _) P s
axiom thm_ARBITRARY_UNION_OF_COMPLEMENT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, ∀ s : A -> Prop, hol_eq (@UNION_OF T A _ (@ARBITRARY T A _) P s) (@INTERSECTION_OF T A _ (@ARBITRARY T A _) (fun s' : A -> Prop => P (@DIFF T A _ (@UNIV T A _) s')) (@DIFF T A _ (@UNIV T A _) s))
axiom thm_ARBITRARY_INTERSECTION_OF_COMPLEMENT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, ∀ s : A -> Prop, hol_eq (@INTERSECTION_OF T A _ (@ARBITRARY T A _) P s) (@UNION_OF T A _ (@ARBITRARY T A _) (fun s' : A -> Prop => P (@DIFF T A _ (@UNIV T A _) s')) (@DIFF T A _ (@UNIV T A _) s))
axiom thm_ARBITRARY_UNION_OF_IDEMPOT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, hol_eq (@UNION_OF T A _ (@ARBITRARY T A _) (@UNION_OF T A _ (@ARBITRARY T A _) P)) (@UNION_OF T A _ (@ARBITRARY T A _) P)
axiom thm_ARBITRARY_INTERSECTION_OF_IDEMPOT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, hol_eq (@INTERSECTION_OF T A _ (@ARBITRARY T A _) (@INTERSECTION_OF T A _ (@ARBITRARY T A _) P)) (@INTERSECTION_OF T A _ (@ARBITRARY T A _) P)
axiom thm_ARBITRARY_UNION_OF_UNIONS [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, ∀ u : (A -> Prop) -> Prop, (∀ s : A -> Prop, (@IN T (A -> Prop) _ s u) -> @UNION_OF T A _ (@ARBITRARY T A _) P s) -> @UNION_OF T A _ (@ARBITRARY T A _) P (@UNIONS T A _ u)
axiom thm_ARBITRARY_UNION_OF_UNION [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, ∀ s : A -> Prop, ∀ t : A -> Prop, (hand (@UNION_OF T A _ (@ARBITRARY T A _) P s) (@UNION_OF T A _ (@ARBITRARY T A _) P t)) -> @UNION_OF T A _ (@ARBITRARY T A _) P (@UNION T A _ s t)
axiom thm_ARBITRARY_INTERSECTION_OF_INTERS [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, ∀ u : (A -> Prop) -> Prop, (∀ s : A -> Prop, (@IN T (A -> Prop) _ s u) -> @INTERSECTION_OF T A _ (@ARBITRARY T A _) P s) -> @INTERSECTION_OF T A _ (@ARBITRARY T A _) P (@INTERS T A _ u)
axiom thm_ARBITRARY_INTERSECTION_OF_INTER [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, ∀ s : A -> Prop, ∀ t : A -> Prop, (hand (@INTERSECTION_OF T A _ (@ARBITRARY T A _) P s) (@INTERSECTION_OF T A _ (@ARBITRARY T A _) P t)) -> @INTERSECTION_OF T A _ (@ARBITRARY T A _) P (@INTER T A _ s t)
axiom thm_ARBITRARY_UNION_OF_INTER_EQ [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, hol_eq (∀ s : A -> Prop, ∀ t : A -> Prop, (hand (@UNION_OF T A _ (@ARBITRARY T A _) P s) (@UNION_OF T A _ (@ARBITRARY T A _) P t)) -> @UNION_OF T A _ (@ARBITRARY T A _) P (@INTER T A _ s t)) (∀ s : A -> Prop, ∀ t : A -> Prop, (hand (P s) (P t)) -> @UNION_OF T A _ (@ARBITRARY T A _) P (@INTER T A _ s t))
axiom thm_ARBITRARY_UNION_OF_INTER [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, (∀ s : A -> Prop, ∀ t : A -> Prop, (hand (P s) (P t)) -> P (@INTER T A _ s t)) -> ∀ s : A -> Prop, ∀ t : A -> Prop, (hand (@UNION_OF T A _ (@ARBITRARY T A _) P s) (@UNION_OF T A _ (@ARBITRARY T A _) P t)) -> @UNION_OF T A _ (@ARBITRARY T A _) P (@INTER T A _ s t)
axiom thm_ARBITRARY_INTERSECTION_OF_UNION_EQ [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, hol_eq (∀ s : A -> Prop, ∀ t : A -> Prop, (hand (@INTERSECTION_OF T A _ (@ARBITRARY T A _) P s) (@INTERSECTION_OF T A _ (@ARBITRARY T A _) P t)) -> @INTERSECTION_OF T A _ (@ARBITRARY T A _) P (@UNION T A _ s t)) (∀ s : A -> Prop, ∀ t : A -> Prop, (hand (P s) (P t)) -> @INTERSECTION_OF T A _ (@ARBITRARY T A _) P (@UNION T A _ s t))
axiom thm_ARBITRARY_INTERSECTION_OF_UNION [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : (A -> Prop) -> Prop, (∀ s : A -> Prop, ∀ t : A -> Prop, (hand (P s) (P t)) -> P (@UNION T A _ s t)) -> ∀ s : A -> Prop, ∀ t : A -> Prop, (hand (@INTERSECTION_OF T A _ (@ARBITRARY T A _) P s) (@INTERSECTION_OF T A _ (@ARBITRARY T A _) P t)) -> @INTERSECTION_OF T A _ (@ARBITRARY T A _) P (@UNION T A _ s t)
