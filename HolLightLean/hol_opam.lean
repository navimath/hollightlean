axiom thm_NUMSEG_COMBINE_L [T : HOLTheory] : ∀ m : num, ∀ p : num, ∀ n : num, (hand (Nat_le m p) (Nat_le p (Nat_add n (NUMERAL (BIT1 _0))))) -> hol_eq (@UNION T num _ (dotdot m (Nat_minus p (NUMERAL (BIT1 _0)))) (dotdot p n)) (dotdot m n)
