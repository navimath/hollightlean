axiom thm_HAS_SUP_LE [T : HOLTheory] : ∀ s : HOLTheory.Real -> Prop, ∀ t : HOLTheory.Real -> Prop, ∀ l : HOLTheory.Real, ∀ m : HOLTheory.Real, (hand (has_sup s l) (hand (has_sup t m) (∀ y : HOLTheory.Real, (@IN T HOLTheory.Real _ y t) -> ∃ x : HOLTheory.Real, hand (@IN T HOLTheory.Real _ x s) (real_le y x)))) -> real_le m l
