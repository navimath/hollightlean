axiom thm_NUM_OF_INT_MUL [T : HOLTheory] : ∀ x : int, ∀ y : int, (hand (int_le (int_of_num (NUMERAL _0)) x) (int_le (int_of_num (NUMERAL _0)) y)) -> hol_eq (num_of_int (int_mul x y)) (Nat_mul (num_of_int x) (num_of_int y))
axiom thm_NUM_OF_INT_POW [T : HOLTheory] : ∀ x : int, ∀ n : num, (int_le (int_of_num (NUMERAL _0)) x) -> hol_eq (num_of_int (int_pow x n)) (EXP (num_of_int x) n)
axiom thm_num_divides [T : HOLTheory] : ∀ a : num, ∀ b : num, hol_eq (num_divides a b) (int_divides (int_of_num a) (int_of_num b))
axiom thm_num_mod [T : HOLTheory] : ∀ n : num, ∀ x : num, ∀ y : num, hol_eq (num_mod n x y) (int_mod (int_of_num n) (int_of_num x) (int_of_num y))
axiom thm_num_congruent [T : HOLTheory] : ∀ x : num, ∀ y : num, ∀ n : num, hol_eq (@eq2 T num _ x y (num_mod n)) (@eq2 T int _ (int_of_num x) (int_of_num y) (int_mod (int_of_num n)))
axiom thm_num_coprime [T : HOLTheory] : ∀ a : num, ∀ b : num, hol_eq (num_coprime (@Prod_mk T num num _ _ a b)) (int_coprime (@Prod_mk T int int _ _ (int_of_num a) (int_of_num b)))
axiom thm_num_gcd [T : HOLTheory] : ∀ a : num, ∀ b : num, hol_eq (num_gcd (@Prod_mk T num num _ _ a b)) (num_of_int (int_gcd (@Prod_mk T int int _ _ (int_of_num a) (int_of_num b))))
axiom thm_num_lcm [T : HOLTheory] : ∀ a : num, ∀ b : num, hol_eq (num_lcm (@Prod_mk T num num _ _ a b)) (num_of_int (int_lcm (@Prod_mk T int int _ _ (int_of_num a) (int_of_num b))))
axiom thm_BINARY_INDUCT [T : HOLTheory] : ∀ P : num -> Prop, (hand (P (NUMERAL _0)) (∀ n : num, (P n) -> hand (P (Nat_mul (NUMERAL (BIT0 (BIT1 _0))) n)) (P (Nat_add (Nat_mul (NUMERAL (BIT0 (BIT1 _0))) n) (NUMERAL (BIT1 _0)))))) -> ∀ n : num, P n
axiom thm_NUM_CASES_BINARY [T : HOLTheory] : ∀ P : num -> Prop, hol_eq (∀ n : num, P n) (hand (∀ n : num, P (Nat_mul (NUMERAL (BIT0 (BIT1 _0))) n)) (∀ n : num, P (Nat_add (Nat_mul (NUMERAL (BIT0 (BIT1 _0))) n) (NUMERAL (BIT1 _0)))))
axiom thm_num_WF_DOWN [T : HOLTheory] : ∀ P : num -> Prop, ∀ m : num, (hand (∀ n : num, (Nat_le m n) -> P n) (∀ n : num, (hand (Nat_lt n m) (∀ p : num, (Nat_lt n p) -> P p)) -> P n)) -> ∀ n : num, P n
axiom thm_INT_REM_REM_POW_MIN [T : HOLTheory] : ∀ x : int, ∀ p : int, ∀ m : num, ∀ n : num, hol_eq (rem (rem x (int_pow p m)) (int_pow p n)) (rem x (int_pow p (MIN m n)))
axiom thm_NUM_GCD [T : HOLTheory] : ∀ a : num, ∀ b : num, hol_eq (int_of_num (num_gcd (@Prod_mk T num num _ _ a b))) (int_gcd (@Prod_mk T int int _ _ (int_of_num a) (int_of_num b)))
axiom thm_NUM_LCM [T : HOLTheory] : ∀ a : num, ∀ b : num, hol_eq (int_of_num (num_lcm (@Prod_mk T num num _ _ a b))) (int_lcm (@Prod_mk T int int _ _ (int_of_num a) (int_of_num b)))
axiom thm_CONG [T : HOLTheory] : ∀ x : num, ∀ y : num, ∀ n : num, hol_eq (@eq2 T num _ x y (num_mod n)) (hol_eq (MOD x n) (MOD y n))
axiom thm_CONG_LMOD [T : HOLTheory] : ∀ x : num, ∀ y : num, ∀ n : num, hol_eq (@eq2 T num _ (MOD x n) y (num_mod n)) (@eq2 T num _ x y (num_mod n))
axiom thm_CONG_RMOD [T : HOLTheory] : ∀ x : num, ∀ y : num, ∀ n : num, hol_eq (@eq2 T num _ x (MOD y n) (num_mod n)) (@eq2 T num _ x y (num_mod n))
axiom thm_CONG_DIV2 [T : HOLTheory] : ∀ a : num, ∀ b : num, ∀ m : num, ∀ n : num, (@eq2 T num _ a b (num_mod (Nat_mul m n))) -> @eq2 T num _ (DIV a m) (DIV b m) (num_mod n)
axiom thm_divides [T : HOLTheory] : ∀ (b : num) (a : num), hol_eq (num_divides a b) (∃ x : num, hol_eq b (Nat_mul a x))
axiom thm_DIVIDES_LE [T : HOLTheory] : ∀ m : num, ∀ n : num, (num_divides m n) -> hor (Nat_le m n) (hol_eq n (NUMERAL _0))
axiom thm_DIVIDES_LE_STRONG [T : HOLTheory] : ∀ m : num, ∀ n : num, (num_divides m n) -> hor (hand (Nat_le (NUMERAL (BIT1 _0)) m) (Nat_le m n)) (hol_eq n (NUMERAL _0))
axiom thm_DIVIDES_LE_IMP [T : HOLTheory] : ∀ m : num, ∀ n : num, (hand (num_divides m n) ((hol_eq n (NUMERAL _0)) -> hol_eq m (NUMERAL _0))) -> Nat_le m n
axiom thm_PROPERLY_DIVIDES_LE_IMP [T : HOLTheory] : ∀ m : num, ∀ n : num, (hand (num_divides m n) (hand (HOLTheory.not (hol_eq n (NUMERAL _0))) (HOLTheory.not (hol_eq m n)))) -> Nat_le (Nat_mul (NUMERAL (BIT0 (BIT1 _0))) m) n
axiom thm_DIVIDES_ANTISYM [T : HOLTheory] : ∀ m : num, ∀ n : num, hol_eq (hand (num_divides m n) (num_divides n m)) (hol_eq m n)
axiom thm_DIVIDES_ONE [T : HOLTheory] : ∀ n : num, hol_eq (num_divides n (NUMERAL (BIT1 _0))) (hol_eq n (NUMERAL (BIT1 _0)))
axiom thm_DIV_ADD [T : HOLTheory] : ∀ d : num, ∀ a : num, ∀ b : num, (hor (num_divides d a) (num_divides d b)) -> hol_eq (DIV (Nat_add a b) d) (Nat_add (DIV a d) (DIV b d))
axiom thm_DIVIDES_MOD [T : HOLTheory] : ∀ m : num, ∀ n : num, hol_eq (num_divides m n) (hol_eq (MOD n m) (NUMERAL _0))
axiom thm_DIVIDES_DIV_MULT [T : HOLTheory] : ∀ m : num, ∀ n : num, hol_eq (num_divides m n) (hol_eq (Nat_mul (DIV n m) m) n)
axiom thm_DIV_BY_DIV [T : HOLTheory] : ∀ m : num, ∀ n : num, (hand (HOLTheory.not (hol_eq n (NUMERAL _0))) (num_divides m n)) -> hol_eq (DIV n (DIV n m)) m
axiom thm_DIVIDES_DIV_DIVIDES [T : HOLTheory] : ∀ n : num, ∀ d : num, ∀ e : num, (hand (num_divides d n) ((hol_eq n (NUMERAL _0)) -> hol_eq e (NUMERAL _0))) -> hol_eq (num_divides (DIV n d) e) (num_divides n (Nat_mul d e))
axiom thm_DIVIDES_DIV_SELF [T : HOLTheory] : ∀ n : num, ∀ d : num, (num_divides d n) -> num_divides (DIV n d) n
axiom thm_DIVIDES_DIVIDES_DIV [T : HOLTheory] : ∀ n : num, ∀ d : num, ∀ e : num, (num_divides d n) -> hol_eq (num_divides e (DIV n d)) (num_divides (Nat_mul d e) n)
axiom thm_DIVIDES_DIVIDES_DIV_EQ [T : HOLTheory] : ∀ n : num, ∀ d : num, ∀ e : num, hol_eq (hand (num_divides d n) (num_divides e (DIV n d))) (num_divides (Nat_mul d e) n)
axiom thm_DIVIDES_DIVIDES_DIV_IMP [T : HOLTheory] : ∀ n : num, ∀ d : num, ∀ e : num, (num_divides (Nat_mul d e) n) -> num_divides e (DIV n d)
axiom thm_MULT_DIV [T : HOLTheory] : hand (∀ m : num, ∀ n : num, ∀ p : num, (num_divides p m) -> hol_eq (DIV (Nat_mul m n) p) (Nat_mul (DIV m p) n)) (∀ m : num, ∀ n : num, ∀ p : num, (num_divides p n) -> hol_eq (DIV (Nat_mul m n) p) (Nat_mul m (DIV n p)))
axiom thm_COPRIME_LMOD [T : HOLTheory] : ∀ a : num, ∀ n : num, hol_eq (num_coprime (@Prod_mk T num num _ _ (MOD a n) n)) (num_coprime (@Prod_mk T num num _ _ a n))
axiom thm_COPRIME_RMOD [T : HOLTheory] : ∀ a : num, ∀ n : num, hol_eq (num_coprime (@Prod_mk T num num _ _ n (MOD a n))) (num_coprime (@Prod_mk T num num _ _ n a))
axiom thm_INT_CONG_NUM_EXISTS [T : HOLTheory] : ∀ x : int, ∀ y : int, ((hol_eq y (int_of_num (NUMERAL _0))) -> int_le (int_of_num (NUMERAL _0)) x) -> ∃ n : num, @eq2 T int _ (int_of_num n) x (int_mod y)
axiom thm_GCD [T : HOLTheory] : ∀ a : num, ∀ b : num, hand (hand (num_divides (num_gcd (@Prod_mk T num num _ _ a b)) a) (num_divides (num_gcd (@Prod_mk T num num _ _ a b)) b)) (∀ e : num, (hand (num_divides e a) (num_divides e b)) -> num_divides e (num_gcd (@Prod_mk T num num _ _ a b)))
axiom thm_coprime [T : HOLTheory] : ∀ (a : num) (b : num), hol_eq (num_coprime (@Prod_mk T num num _ _ a b)) (∀ d : num, (hand (num_divides d a) (num_divides d b)) -> hol_eq d (NUMERAL (BIT1 _0)))
axiom thm_prime [T : HOLTheory] : ∀ p : num, hol_eq (prime p) (hand (HOLTheory.not (hol_eq p (NUMERAL (BIT1 _0)))) (∀ x : num, (num_divides x p) -> hor (hol_eq x (NUMERAL (BIT1 _0))) (hol_eq x p)))
axiom thm_ONE_OR_PRIME [T : HOLTheory] : ∀ p : num, hol_eq (hor (hol_eq p (NUMERAL (BIT1 _0))) (prime p)) (∀ n : num, (num_divides n p) -> hor (hol_eq n (NUMERAL (BIT1 _0))) (hol_eq n p))
axiom thm_ONE_OR_PRIME_DIVIDES_OR_COPRIME [T : HOLTheory] : ∀ p : num, hol_eq (hor (hol_eq p (NUMERAL (BIT1 _0))) (prime p)) (∀ n : num, hor (num_divides p n) (num_coprime (@Prod_mk T num num _ _ p n)))
axiom thm_PRIME_COPRIME_EQ_NONDIVISIBLE [T : HOLTheory] : ∀ p : num, hol_eq (prime p) (∀ n : num, hol_eq (num_coprime (@Prod_mk T num num _ _ p n)) (HOLTheory.not (num_divides p n)))
axiom thm_ZERO_ONE_OR_PRIME_DIVPROD [T : HOLTheory] : ∀ p : num, ∀ a : num, ∀ b : num, (hor (hol_eq p (NUMERAL _0)) (hor (hol_eq p (NUMERAL (BIT1 _0))) (prime p))) -> hol_eq (num_divides p (Nat_mul a b)) (hor (num_divides p a) (num_divides p b))
axiom thm_ZERO_ONE_OR_PRIME [T : HOLTheory] : ∀ p : num, hol_eq (hor (hol_eq p (NUMERAL _0)) (hor (hol_eq p (NUMERAL (BIT1 _0))) (prime p))) (∀ a : num, ∀ b : num, (num_divides p (Nat_mul a b)) -> hor (num_divides p a) (num_divides p b))
axiom thm_real_zpow [T : HOLTheory] : ∀ z : HOLTheory.Real, ∀ i : int, hol_eq (real_zpow z i) (@COND T HOLTheory.Real _ (int_le (int_of_num (NUMERAL _0)) i) (real_pow z (num_of_int i)) (real_inv (real_pow z (num_of_int (int_neg i)))))
axiom thm_REAL_POW_ZPOW [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ n : num, hol_eq (real_pow x n) (real_zpow x (int_of_num n))
axiom thm_REAL_ZPOW_NUM [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ n : num, hol_eq (real_zpow x (int_of_num n)) (real_pow x n)
axiom thm_REAL_ZPOW_0 [T : HOLTheory] : ∀ x : HOLTheory.Real, hol_eq (real_zpow x (int_of_num (NUMERAL _0))) (real_of_num (NUMERAL (BIT1 _0)))
axiom thm_REAL_ZPOW_1 [T : HOLTheory] : ∀ x : HOLTheory.Real, hol_eq (real_zpow x (int_of_num (NUMERAL (BIT1 _0)))) x
axiom thm_REAL_ZPOW_2 [T : HOLTheory] : ∀ x : HOLTheory.Real, hol_eq (real_zpow x (int_of_num (NUMERAL (BIT0 (BIT1 _0))))) (real_mul x x)
axiom thm_REAL_ZPOW_ONE [T : HOLTheory] : ∀ n : int, hol_eq (real_zpow (real_of_num (NUMERAL (BIT1 _0))) n) (real_of_num (NUMERAL (BIT1 _0)))
axiom thm_REAL_ZPOW_NEG [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ n : int, hol_eq (real_zpow x (int_neg n)) (real_inv (real_zpow x n))
axiom thm_REAL_ZPOW_MINUS1 [T : HOLTheory] : ∀ x : HOLTheory.Real, hol_eq (real_zpow x (int_neg (int_of_num (NUMERAL (BIT1 _0))))) (real_inv x)
axiom thm_REAL_ZPOW_ZERO [T : HOLTheory] : ∀ n : int, hol_eq (real_zpow (real_of_num (NUMERAL _0)) n) (@COND T HOLTheory.Real _ (hol_eq n (int_of_num (NUMERAL _0))) (real_of_num (NUMERAL (BIT1 _0))) (real_of_num (NUMERAL _0)))
axiom thm_REAL_ZPOW_POW [T : HOLTheory] : hand (∀ x : HOLTheory.Real, ∀ n : num, hol_eq (real_zpow x (int_of_num n)) (real_pow x n)) (∀ x : HOLTheory.Real, ∀ n : num, hol_eq (real_zpow x (int_neg (int_of_num n))) (real_inv (real_pow x n)))
axiom thm_REAL_INV_ZPOW [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ n : int, hol_eq (real_inv (real_zpow x n)) (real_zpow (real_inv x) n)
axiom thm_REAL_ZPOW_INV [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ n : int, hol_eq (real_zpow (real_inv x) n) (real_inv (real_zpow x n))
axiom thm_REAL_ZPOW_ZPOW [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ m : int, ∀ n : int, hol_eq (real_zpow (real_zpow x m) n) (real_zpow x (int_mul m n))
axiom thm_REAL_ZPOW_MUL [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ y : HOLTheory.Real, ∀ n : int, hol_eq (real_zpow (real_mul x y) n) (real_mul (real_zpow x n) (real_zpow y n))
axiom thm_REAL_ZPOW_DIV [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ y : HOLTheory.Real, ∀ n : int, hol_eq (real_zpow (real_div x y) n) (real_div (real_zpow x n) (real_zpow y n))
axiom thm_REAL_ZPOW_ADD [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ m : int, ∀ n : int, (HOLTheory.not (hol_eq x (real_of_num (NUMERAL _0)))) -> hol_eq (real_zpow x (int_add m n)) (real_mul (real_zpow x m) (real_zpow x n))
axiom thm_REAL_ZPOW_SUB [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ m : int, ∀ n : int, (HOLTheory.not (hol_eq x (real_of_num (NUMERAL _0)))) -> hol_eq (real_zpow x (int_sub m n)) (real_div (real_zpow x m) (real_zpow x n))
axiom thm_REAL_ZPOW_LE [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ n : int, (real_le (real_of_num (NUMERAL _0)) x) -> real_le (real_of_num (NUMERAL _0)) (real_zpow x n)
axiom thm_REAL_ZPOW_LT [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ n : int, (real_lt (real_of_num (NUMERAL _0)) x) -> real_lt (real_of_num (NUMERAL _0)) (real_zpow x n)
axiom thm_REAL_ZPOW_EQ_0 [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ n : int, hol_eq (hol_eq (real_zpow x n) (real_of_num (NUMERAL _0))) (hand (hol_eq x (real_of_num (NUMERAL _0))) (HOLTheory.not (hol_eq n (int_of_num (NUMERAL _0)))))
axiom thm_REAL_ABS_ZPOW [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ n : int, hol_eq (real_abs (real_zpow x n)) (real_zpow (real_abs x) n)
axiom thm_REAL_SGN_ZPOW [T : HOLTheory] : ∀ x : HOLTheory.Real, ∀ n : int, hol_eq (real_sgn (real_zpow x n)) (real_zpow (real_sgn x) n)
axiom thm_IN [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ x : A, hol_eq (@IN T A _ x P) (P x)
axiom thm_EXTENSION [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, ∀ t : A -> Prop, hol_eq (hol_eq s t) (∀ x : A, hol_eq (@IN T A _ x s) (@IN T A _ x t))
axiom thm_GSPEC [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ p : A -> Prop, hol_eq (@GSPEC T A _ p) p
axiom thm_SETSPEC [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ v : A, ∀ t : A, hol_eq (@SETSPEC T A _ v P t) (hand P (hol_eq v t))
axiom thm_IN_ELIM_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hand (∀ P : (Prop -> A -> Prop) -> Prop, ∀ x : A, hol_eq (@IN T A _ x (@GSPEC T A _ (fun v : A => P (@SETSPEC T A _ v)))) (P (fun p : Prop => fun t : A => hand p (hol_eq x t)))) (hand (∀ p : A -> Prop, ∀ x : A, hol_eq (@IN T A _ x (@GSPEC T A _ (fun v : A => ∃ y : A, @SETSPEC T A _ v (p y) y))) (p x)) (hand (∀ P : (Prop -> A -> Prop) -> Prop, ∀ x : A, hol_eq (@GSPEC T A _ (fun v : A => P (@SETSPEC T A _ v)) x) (P (fun p : Prop => fun t : A => hand p (hol_eq x t)))) (hand (∀ p : A -> Prop, ∀ x : A, hol_eq (@GSPEC T A _ (fun v : A => ∃ y : A, @SETSPEC T A _ v (p y) y) x) (p x)) (∀ p : A -> Prop, ∀ x : A, hol_eq (@IN T A _ x (fun y : A => p y)) (p x)))))
axiom thm_EMPTY [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hol_eq (@EMPTY T A _) (fun x : A => hfalse)
axiom thm_INSERT_DEF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, ∀ x : A, hol_eq (@INSERT T A _ x s) (fun y : A => hor (@IN T A _ y s) (hol_eq y x))
axiom thm_UNIV [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hol_eq (@UNIV T A _) (fun x : A => htrue)
axiom thm_UNION [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, ∀ t : A -> Prop, hol_eq (@UNION T A _ s t) (@GSPEC T A _ (fun GEN_PVAR_0 : A => ∃ x : A, @SETSPEC T A _ GEN_PVAR_0 (hor (@IN T A _ x s) (@IN T A _ x t)) x))
axiom thm_UNIONS [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : (A -> Prop) -> Prop, hol_eq (@UNIONS T A _ s) (@GSPEC T A _ (fun GEN_PVAR_1 : A => ∃ x : A, @SETSPEC T A _ GEN_PVAR_1 (∃ u : A -> Prop, hand (@IN T (A -> Prop) _ u s) (@IN T A _ x u)) x))
axiom thm_INTER [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, ∀ t : A -> Prop, hol_eq (@INTER T A _ s t) (@GSPEC T A _ (fun GEN_PVAR_2 : A => ∃ x : A, @SETSPEC T A _ GEN_PVAR_2 (hand (@IN T A _ x s) (@IN T A _ x t)) x))
axiom thm_INTERS [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : (A -> Prop) -> Prop, hol_eq (@INTERS T A _ s) (@GSPEC T A _ (fun GEN_PVAR_3 : A => ∃ x : A, @SETSPEC T A _ GEN_PVAR_3 (∀ u : A -> Prop, (@IN T (A -> Prop) _ u s) -> @IN T A _ x u) x))
axiom thm_DIFF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, ∀ t : A -> Prop, hol_eq (@DIFF T A _ s t) (@GSPEC T A _ (fun GEN_PVAR_4 : A => ∃ x : A, @SETSPEC T A _ GEN_PVAR_4 (hand (@IN T A _ x s) (HOLTheory.not (@IN T A _ x t))) x))
axiom thm_INSERT [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (s : A -> Prop) (x : A), hol_eq (@INSERT T A _ x s) (@GSPEC T A _ (fun GEN_PVAR_5 : A => ∃ y : A, @SETSPEC T A _ GEN_PVAR_5 (hor (@IN T A _ y s) (hol_eq y x)) y))
axiom thm_DELETE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, ∀ x : A, hol_eq (@DELETE T A _ s x) (@GSPEC T A _ (fun GEN_PVAR_6 : A => ∃ y : A, @SETSPEC T A _ GEN_PVAR_6 (hand (@IN T A _ y s) (HOLTheory.not (hol_eq y x))) y))
axiom thm_SUBSET [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, ∀ t : A -> Prop, hol_eq (@SUBSET T A _ s t) (∀ x : A, (@IN T A _ x s) -> @IN T A _ x t)
axiom thm_PSUBSET [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, ∀ t : A -> Prop, hol_eq (@PSUBSET T A _ s t) (hand (@SUBSET T A _ s t) (HOLTheory.not (hol_eq s t)))
axiom thm_DISJOINT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ s : A -> Prop, ∀ t : A -> Prop, hol_eq (@DISJOINT T A _ s t) (hol_eq (@INTER T A _ s t) (@EMPTY T A _))
