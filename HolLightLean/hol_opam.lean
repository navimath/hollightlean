import HolLightLean.hol_theory_record
import HolLightLean.hol_theory_inst
open HOLTheory

/-!
# HOL-Light theorem statements over `HOLTheory`

Copy of `hol2dk_export/stdlib/HolClass/Hol/hol_opam.lean`, adapted to the record in
`hol_theory_record.lean`:
* the export's `Hol.*` imports are replaced by the record (the `theory_hol`, `hol_types`
  and `hol_terms` modules of the export are empty);
* the field `hnot` is renamed `not`; it is written `HOLTheory.not` because a bare `not`
  would be ambiguous with `_root_.not : Bool → Bool`.

Only the record is imported, so `imp`, `FORALL` and `EXISTS` resolve to the `HOLTheory`
helpers and not to the homonymous root definitions of `conectors.lean`.
-/

namespace HolLightLean.hol_opam
set_option linter.unusedVariables false
axiom thm_T_DEF [T : HOLTheory] : hol_eq htrue (hol_eq (fun p : Prop => p) (fun p : Prop => p))
axiom thm_AND_DEF [T : HOLTheory] : hol_eq hand (fun p : Prop => fun q : Prop => hol_eq (fun f : Prop -> Prop -> Prop => f p q) (fun f : Prop -> Prop -> Prop => f htrue htrue))
axiom thm_IMP_DEF [T : HOLTheory] : hol_eq HOLTheory.imp (fun p : Prop => fun q : Prop => hol_eq (hand p q) p)
axiom thm_FORALL_DEF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hol_eq (@HOLTheory.FORALL A _) (fun P : A -> Prop => hol_eq P (fun x : A => htrue))
axiom thm_EXISTS_DEF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hol_eq (@HOLTheory.EXISTS A _) (fun P : A -> Prop => ∀ q : Prop, (∀ x : A, (P x) -> q) -> q)
axiom thm_OR_DEF [T : HOLTheory] : hol_eq hor (fun p : Prop => fun q : Prop => ∀ r : Prop, (p -> r) -> (q -> r) -> r)
axiom thm_F_DEF [T : HOLTheory] : hol_eq hfalse (∀ p : Prop, p)
axiom thm_NOT_DEF [T : HOLTheory] : hol_eq HOLTheory.not (fun p : Prop => p -> hfalse)
axiom thm_EXISTS_UNIQUE_DEF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hol_eq (@hexists_one T A _) (fun P : A -> Prop => hand (HOLTheory.EXISTS P) (∀ x : A, ∀ y : A, (hand (P x) (P y)) -> hol_eq x y))
axiom thm__FALSITY_ [T : HOLTheory] : hol_eq HOLTheory._FALSITY_ hfalse
axiom thm_EQ_REFL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ x : A, hol_eq x x
axiom thm_REFL_CLAUSE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ x : A, hol_eq (hol_eq x x) htrue
axiom thm_EQ_SYM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ x : A, ∀ y : A, (hol_eq x y) -> hol_eq y x
axiom thm_EQ_SYM_EQ [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ x : A, ∀ y : A, hol_eq (hol_eq x y) (hol_eq y x)
axiom thm_EQ_TRANS [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ x : A, ∀ y : A, ∀ z : A, (hand (hol_eq x y) (hol_eq y z)) -> hol_eq x z
axiom thm_BETA_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ y : A, hol_eq ((fun x : A => f x) y) (f y)
axiom thm_ABS_SIMP [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ t1 : A, ∀ t2 : B, hol_eq ((fun x : B => t1) t2) t1
axiom thm_CONJ_ASSOC [T : HOLTheory] : ∀ t1 : Prop, ∀ t2 : Prop, ∀ t3 : Prop, hol_eq (hand t1 (hand t2 t3)) (hand (hand t1 t2) t3)
axiom thm_CONJ_SYM [T : HOLTheory] : ∀ t1 : Prop, ∀ t2 : Prop, hol_eq (hand t1 t2) (hand t2 t1)
axiom thm_CONJ_ACI [T : HOLTheory] : ∀ (r : Prop) (p : Prop) (q : Prop), hand (hol_eq (hand p q) (hand q p)) (hand (hol_eq (hand (hand p q) r) (hand p (hand q r))) (hand (hol_eq (hand p (hand q r)) (hand q (hand p r))) (hand (hol_eq (hand p p) p) (hol_eq (hand p (hand p q)) (hand p q)))))
axiom thm_DISJ_ASSOC [T : HOLTheory] : ∀ t1 : Prop, ∀ t2 : Prop, ∀ t3 : Prop, hol_eq (hor t1 (hor t2 t3)) (hor (hor t1 t2) t3)
axiom thm_DISJ_SYM [T : HOLTheory] : ∀ t1 : Prop, ∀ t2 : Prop, hol_eq (hor t1 t2) (hor t2 t1)
axiom thm_DISJ_ACI [T : HOLTheory] : ∀ (r : Prop) (p : Prop) (q : Prop), hand (hol_eq (hor p q) (hor q p)) (hand (hol_eq (hor (hor p q) r) (hor p (hor q r))) (hand (hol_eq (hor p (hor q r)) (hor q (hor p r))) (hand (hol_eq (hor p p) p) (hol_eq (hor p (hor p q)) (hor p q)))))
axiom thm_IMP_CONJ [T : HOLTheory] : ∀ (p : Prop) (q : Prop) (r : Prop), hol_eq ((hand p q) -> r) (p -> q -> r)
axiom thm_IMP_CONJ_ALT [T : HOLTheory] : ∀ (q : Prop) (p : Prop) (r : Prop), hol_eq ((hand p q) -> r) (q -> p -> r)
axiom thm_LEFT_OR_DISTRIB [T : HOLTheory] : ∀ p : Prop, ∀ q : Prop, ∀ r : Prop, hol_eq (hand p (hor q r)) (hor (hand p q) (hand p r))
axiom thm_RIGHT_OR_DISTRIB [T : HOLTheory] : ∀ p : Prop, ∀ q : Prop, ∀ r : Prop, hol_eq (hand (hor p q) r) (hor (hand p r) (hand q r))
axiom thm_FORALL_SIMP [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ t : Prop, hol_eq (∀ x : A, t) t
axiom thm_EXISTS_SIMP [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ t : Prop, hol_eq (∃ x : A, t) t
axiom thm_EQ_CLAUSES [T : HOLTheory] : ∀ t : Prop, hand (hol_eq (hol_eq htrue t) t) (hand (hol_eq (hol_eq t htrue) t) (hand (hol_eq (hol_eq hfalse t) (HOLTheory.not t)) (hol_eq (hol_eq t hfalse) (HOLTheory.not t))))
axiom thm_NOT_CLAUSES_WEAK [T : HOLTheory] : hand (hol_eq (HOLTheory.not htrue) hfalse) (hol_eq (HOLTheory.not hfalse) htrue)
axiom thm_AND_CLAUSES [T : HOLTheory] : ∀ t : Prop, hand (hol_eq (hand htrue t) t) (hand (hol_eq (hand t htrue) t) (hand (hol_eq (hand hfalse t) hfalse) (hand (hol_eq (hand t hfalse) hfalse) (hol_eq (hand t t) t))))
axiom thm_OR_CLAUSES [T : HOLTheory] : ∀ t : Prop, hand (hol_eq (hor htrue t) htrue) (hand (hol_eq (hor t htrue) htrue) (hand (hol_eq (hor hfalse t) t) (hand (hol_eq (hor t hfalse) t) (hol_eq (hor t t) t))))
axiom thm_IMP_CLAUSES [T : HOLTheory] : ∀ t : Prop, hand (hol_eq (htrue -> t) t) (hand (hol_eq (t -> htrue) htrue) (hand (hol_eq (hfalse -> t) htrue) (hand (hol_eq (t -> t) htrue) (hol_eq (t -> hfalse) (HOLTheory.not t)))))
axiom thm_EXISTS_UNIQUE_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, hol_eq (@hexists_one T A _ (fun x : A => P x)) (hand (∃ x : A, P x) (∀ x : A, ∀ x' : A, (hand (P x) (P x')) -> hol_eq x x'))
axiom thm_EXISTS_REFL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ a : A, ∃ x : A, hol_eq x a
axiom thm_EXISTS_UNIQUE_REFL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ a : A, @hexists_one T A _ (fun x : A => hol_eq x a)
axiom thm_UNWIND_THM1 [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ a : A, hol_eq (∃ x : A, hand (hol_eq a x) (P x)) (P a)
axiom thm_UNWIND_THM2 [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ a : A, hol_eq (∃ x : A, hand (hol_eq x a) (P x)) (P a)
axiom thm_FORALL_UNWIND_THM2 [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ a : A, hol_eq (∀ x : A, (hol_eq x a) -> P x) (P a)
axiom thm_FORALL_UNWIND_THM1 [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ a : A, hol_eq (∀ x : A, (hol_eq a x) -> P x) (P a)
axiom thm_SWAP_FORALL_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, hol_eq (∀ x : A, ∀ y : B, P x y) (∀ y : B, ∀ x : A, P x y)
axiom thm_SWAP_EXISTS_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, hol_eq (∃ x : A, ∃ y : B, P x y) (∃ y : B, ∃ x : A, P x y)
axiom thm_FORALL_AND_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, hol_eq (∀ x : A, hand (P x) (Q x)) (hand (∀ x : A, P x) (∀ x : A, Q x))
axiom thm_AND_FORALL_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, hol_eq (hand (∀ x : A, P x) (∀ x : A, Q x)) (∀ x : A, hand (P x) (Q x))
axiom thm_LEFT_AND_FORALL_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, hol_eq (hand (∀ x : A, P x) Q) (∀ x : A, hand (P x) Q)
axiom thm_RIGHT_AND_FORALL_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, hol_eq (hand P (∀ x : A, Q x)) (∀ x : A, hand P (Q x))
axiom thm_EXISTS_OR_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, hol_eq (∃ x : A, hor (P x) (Q x)) (hor (∃ x : A, P x) (∃ x : A, Q x))
axiom thm_OR_EXISTS_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, hol_eq (hor (∃ x : A, P x) (∃ x : A, Q x)) (∃ x : A, hor (P x) (Q x))
axiom thm_LEFT_OR_EXISTS_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, hol_eq (hor (∃ x : A, P x) Q) (∃ x : A, hor (P x) Q)
axiom thm_RIGHT_OR_EXISTS_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, hol_eq (hor P (∃ x : A, Q x)) (∃ x : A, hor P (Q x))
axiom thm_LEFT_EXISTS_AND_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, hol_eq (∃ x : A, hand (P x) Q) (hand (∃ x : A, P x) Q)
axiom thm_RIGHT_EXISTS_AND_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, hol_eq (∃ x : A, hand P (Q x)) (hand P (∃ x : A, Q x))
axiom thm_TRIV_EXISTS_AND_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : Prop, hol_eq (∃ x : A, hand P Q) (hand (∃ x : A, P) (∃ x : A, Q))
axiom thm_LEFT_AND_EXISTS_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, hol_eq (hand (∃ x : A, P x) Q) (∃ x : A, hand (P x) Q)
axiom thm_RIGHT_AND_EXISTS_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, hol_eq (hand P (∃ x : A, Q x)) (∃ x : A, hand P (Q x))
axiom thm_TRIV_AND_EXISTS_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : Prop, hol_eq (hand (∃ x : A, P) (∃ x : A, Q)) (∃ x : A, hand P Q)
axiom thm_TRIV_FORALL_OR_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : Prop, hol_eq (∀ x : A, hor P Q) (hor (∀ x : A, P) (∀ x : A, Q))
axiom thm_TRIV_OR_FORALL_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : Prop, hol_eq (hor (∀ x : A, P) (∀ x : A, Q)) (∀ x : A, hor P Q)
axiom thm_RIGHT_IMP_FORALL_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, hol_eq (P -> ∀ x : A, Q x) (∀ x : A, P -> Q x)
axiom thm_RIGHT_FORALL_IMP_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, hol_eq (∀ x : A, P -> Q x) (P -> ∀ x : A, Q x)
axiom thm_LEFT_IMP_EXISTS_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, hol_eq ((∃ x : A, P x) -> Q) (∀ x : A, (P x) -> Q)
axiom thm_LEFT_FORALL_IMP_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, hol_eq (∀ x : A, (P x) -> Q) ((∃ x : A, P x) -> Q)
axiom thm_TRIV_FORALL_IMP_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : Prop, hol_eq (∀ x : A, P -> Q) ((∃ x : A, P) -> ∀ x : A, Q)
axiom thm_TRIV_EXISTS_IMP_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : Prop, hol_eq (∃ x : A, P -> Q) ((∀ x : A, P) -> ∃ x : A, Q)
axiom thm_MONO_FORALL [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (P : A -> Prop) (Q : A -> Prop), (∀ x : A, (P x) -> Q x) -> (∀ x : A, P x) -> ∀ x : A, Q x
axiom thm_MONO_EXISTS [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (P : A -> Prop) (Q : A -> Prop), (∀ x : A, (P x) -> Q x) -> (∃ x : A, P x) -> ∃ x : A, Q x
axiom thm_WLOG_RELATION [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ R' : A -> A -> Prop, ∀ P : A -> A -> Prop, (hand (∀ x : A, ∀ y : A, (P x y) -> P y x) (hand (∀ x : A, ∀ y : A, hor (R' x y) (R' y x)) (∀ x : A, ∀ y : A, (R' x y) -> P x y))) -> ∀ x : A, ∀ y : A, P x y
axiom thm_EXISTS_UNIQUE_ALT [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, hol_eq (@hexists_one T A _ (fun x : A => P x)) (∃ x : A, ∀ y : A, hol_eq (P y) (hol_eq x y))
axiom thm_EXISTS_UNIQUE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, hol_eq (@hexists_one T A _ (fun x : A => P x)) (∃ x : A, hand (P x) (∀ y : A, (P y) -> hol_eq y x))
axiom thm_ETA_AX [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ t : A -> B, hol_eq (fun x : A => t x) t
axiom thm_EQ_EXT [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ g : A -> B, (∀ x : A, hol_eq (f x) (g x)) -> hol_eq f g
axiom thm_FUN_EQ_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ g : A -> B, hol_eq (hol_eq f g) (∀ x : A, hol_eq (f x) (g x))
axiom thm_SELECT_AX [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ x : A, (P x) -> P (@epsilon T A _ P)
axiom thm_EXISTS_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hol_eq (@HOLTheory.EXISTS A _) (fun P : A -> Prop => P (@epsilon T A _ P))
axiom thm_SELECT_REFL [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ x : A, hol_eq (@epsilon T A _ (fun y : A => hol_eq y x)) x
axiom thm_SELECT_UNIQUE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ x : A, (∀ y : A, hol_eq (P y) (hol_eq y x)) -> hol_eq (@epsilon T A _ P) x
axiom thm_EXCLUDED_MIDDLE [T : HOLTheory] : ∀ t : Prop, hor t (HOLTheory.not t)
axiom thm_BOOL_CASES_AX [T : HOLTheory] : ∀ t : Prop, hor (hol_eq t htrue) (hol_eq t hfalse)
axiom thm_DE_MORGAN_THM [T : HOLTheory] : ∀ t1 : Prop, ∀ t2 : Prop, hand (hol_eq (HOLTheory.not (hand t1 t2)) (hor (HOLTheory.not t1) (HOLTheory.not t2))) (hol_eq (HOLTheory.not (hor t1 t2)) (hand (HOLTheory.not t1) (HOLTheory.not t2)))
axiom thm_NOT_CLAUSES [T : HOLTheory] : hand (∀ t : Prop, hol_eq (HOLTheory.not (HOLTheory.not t)) t) (hand (hol_eq (HOLTheory.not htrue) hfalse) (hol_eq (HOLTheory.not hfalse) htrue))
axiom thm_NOT_IMP [T : HOLTheory] : ∀ t1 : Prop, ∀ t2 : Prop, hol_eq (HOLTheory.not (t1 -> t2)) (hand t1 (HOLTheory.not t2))
axiom thm_CONTRAPOS_THM [T : HOLTheory] : ∀ t1 : Prop, ∀ t2 : Prop, hol_eq ((HOLTheory.not t1) -> HOLTheory.not t2) (t2 -> t1)
axiom thm_NOT_EXISTS_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, hol_eq (HOLTheory.not (∃ x : A, P x)) (∀ x : A, HOLTheory.not (P x))
axiom thm_EXISTS_NOT_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, hol_eq (∃ x : A, HOLTheory.not (P x)) (HOLTheory.not (∀ x : A, P x))
axiom thm_NOT_FORALL_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, hol_eq (HOLTheory.not (∀ x : A, P x)) (∃ x : A, HOLTheory.not (P x))
axiom thm_FORALL_NOT_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, hol_eq (∀ x : A, HOLTheory.not (P x)) (HOLTheory.not (∃ x : A, P x))
axiom thm_FORALL_BOOL_THM [T : HOLTheory] : ∀ (P : Prop -> Prop), hol_eq (∀ b : Prop, P b) (hand (P htrue) (P hfalse))
axiom thm_EXISTS_BOOL_THM [T : HOLTheory] : ∀ (P : Prop -> Prop), hol_eq (∃ b : Prop, P b) (hor (P htrue) (P hfalse))
axiom thm_LEFT_FORALL_OR_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, hol_eq (∀ x : A, hor (P x) Q) (hor (∀ x : A, P x) Q)
axiom thm_RIGHT_FORALL_OR_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, hol_eq (∀ x : A, hor P (Q x)) (hor P (∀ x : A, Q x))
axiom thm_LEFT_OR_FORALL_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, hol_eq (hor (∀ x : A, P x) Q) (∀ x : A, hor (P x) Q)
axiom thm_RIGHT_OR_FORALL_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, hol_eq (hor P (∀ x : A, Q x)) (∀ x : A, hor P (Q x))
axiom thm_LEFT_IMP_FORALL_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, hol_eq ((∀ x : A, P x) -> Q) (∃ x : A, (P x) -> Q)
axiom thm_LEFT_EXISTS_IMP_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, hol_eq (∃ x : A, (P x) -> Q) ((∀ x : A, P x) -> Q)
axiom thm_RIGHT_IMP_EXISTS_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, hol_eq (P -> ∃ x : A, Q x) (∃ x : A, P -> Q x)
axiom thm_RIGHT_EXISTS_IMP_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, hol_eq (∃ x : A, P -> Q x) (P -> ∃ x : A, Q x)
axiom thm_COND_DEF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hol_eq (@COND T A _) (fun t : Prop => fun t1 : A => fun t2 : A => @epsilon T A _ (fun x : A => hand ((hol_eq t htrue) -> hol_eq x t1) ((hol_eq t hfalse) -> hol_eq x t2)))
axiom thm_COND_CLAUSES [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ t1 : A, ∀ t2 : A, hand (hol_eq (@COND T A _ htrue t1 t2) t1) (hol_eq (@COND T A _ hfalse t1 t2) t2)
axiom thm_COND_EXPAND [T : HOLTheory] : ∀ b : Prop, ∀ t1 : Prop, ∀ t2 : Prop, hol_eq (@COND T Prop _ b t1 t2) (hand (hor (HOLTheory.not b) t1) (hor b t2))
axiom thm_COND_ID [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ b : Prop, ∀ t : A, hol_eq (@COND T A _ b t t) t
axiom thm_COND_RAND [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ b : Prop, ∀ f : A -> B, ∀ x : A, ∀ y : A, hol_eq (f (@COND T A _ b x y)) (@COND T B _ b (f x) (f y))
axiom thm_COND_RATOR [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ b : Prop, ∀ f : A -> B, ∀ g : A -> B, ∀ x : A, hol_eq (@COND T (A -> B) _ b f g x) (@COND T B _ b (f x) (g x))
axiom thm_COND_ABS [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ b : Prop, ∀ f : A -> B, ∀ g : A -> B, hol_eq (fun x : A => @COND T B _ b (f x) (g x)) (@COND T (A -> B) _ b f g)
axiom thm_COND_SWAP [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ p : Prop, ∀ x : A, ∀ y : A, hol_eq (@COND T A _ (HOLTheory.not p) x y) (@COND T A _ p y x)
axiom thm_MONO_COND [T : HOLTheory] : ∀ (A : Prop) (C : Prop) (b : Prop) (B : Prop) (D : Prop), (hand (A -> B) (C -> D)) -> (@COND T Prop _ b A C) -> @COND T Prop _ b B D
axiom thm_COND_ELIM_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A] (x : A) (c : Prop) (P : A -> Prop) (y : A), hol_eq (P (@COND T A _ c x y)) (hand (c -> P x) ((HOLTheory.not c) -> P y))
axiom thm_SKOLEM_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, hol_eq (∀ x : A, ∃ y : B, P x y) (∃ y : A -> B, ∀ x : A, P x (y x))
axiom thm_SKOLEM_THM_GEN [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> Prop, ∀ R' : A -> B -> Prop, hol_eq (∀ x : A, (P x) -> ∃ y : B, R' x y) (∃ f : A -> B, ∀ x : A, (P x) -> R' x (f x))
axiom thm_UNIQUE_SKOLEM_ALT [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, hol_eq (∀ x : A, @hexists_one T B _ (fun y : B => P x y)) (∃ f : A -> B, ∀ x : A, ∀ y : B, hol_eq (P x y) (hol_eq (f x) y))
axiom thm_UNIQUE_SKOLEM_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, hol_eq (∀ x : A, @hexists_one T B _ (fun y : B => P x y)) (@hexists_one T (A -> B) _ (fun f : A -> B => ∀ x : A, P x (f x)))
axiom thm_bool_INDUCT [T : HOLTheory] : ∀ P : Prop -> Prop, (hand (P hfalse) (P htrue)) -> ∀ x : Prop, P x
axiom thm_bool_RECURSION [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ a : A, ∀ b : A, ∃ f : Prop -> A, hand (hol_eq (f hfalse) a) (hol_eq (f htrue) b)
axiom thm_o_DEF [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : B -> C, ∀ g : A -> B, hol_eq (@o T A B C _ _ _ f g) (fun x : A => f (g x))
axiom thm_I_DEF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], hol_eq (@I T A _) (fun x : A => x)
axiom thm_o_THM [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : B -> C, ∀ g : A -> B, ∀ x : A, hol_eq (@o T A B C _ _ _ f g x) (f (g x))
axiom thm_o_ASSOC [T : HOLTheory] : ∀ {A B C D : Type} [Nonempty A] [Nonempty B] [Nonempty C] [Nonempty D], ∀ f : C -> D, ∀ g : B -> C, ∀ h : A -> B, hol_eq (@o T A C D _ _ _ f (@o T A B C _ _ _ g h)) (@o T A B D _ _ _ (@o T B C D _ _ _ f g) h)
axiom thm_I_THM [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ x : A, hol_eq (@I T A _ x) x
axiom thm_I_O_ID [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, hand (hol_eq (@o T A B B _ _ _ (@I T B _) f) f) (hol_eq (@o T A A B _ _ _ f (@I T A _)) f)
axiom thm_EXISTS_ONE_REP [T : HOLTheory] : ∃ b : Prop, b
axiom thm_one_DEF [T : HOLTheory] : hol_eq one (@epsilon T unit _ (fun x : unit => htrue))
axiom thm_one [T : HOLTheory] : ∀ v : unit, hol_eq v one
axiom thm_one_axiom [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ f : A -> unit, ∀ g : A -> unit, hol_eq f g
axiom thm_one_INDUCT [T : HOLTheory] : ∀ P : unit -> Prop, (P one) -> ∀ x : unit, P x
axiom thm_one_RECURSION [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ e : A, ∃ fn : unit -> A, hol_eq (fn one) e
axiom thm_one_Axiom [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ e : A, @hexists_one T (unit -> A) _ (fun fn : unit -> A => hol_eq (fn one) e)
axiom thm_FORALL_ONE_THM [T : HOLTheory] : ∀ (P : unit -> Prop), hol_eq (∀ x : unit, P x) (P one)
axiom thm_EXISTS_ONE_THM [T : HOLTheory] : ∀ (P : unit -> Prop), hol_eq (∃ x : unit, P x) (P one)
axiom thm_ETA_ONE [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ f : unit -> A, hol_eq (fun x : unit => f one) f
axiom thm_LET_DEF [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ x : A, hol_eq (@LET T A B _ _ f x) (f x)
axiom thm_LET_END_DEF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ t : A, hol_eq (@LET_END T A _ t) t
axiom thm_GABS_DEF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ P : A -> Prop, hol_eq (@GABS T A _ P) (@epsilon T A _ P)
axiom thm_GEQ_DEF [T : HOLTheory] : ∀ {A : Type} [Nonempty A], ∀ a : A, ∀ b : A, hol_eq (@GEQ T A _ a b) (hol_eq a b)
axiom thm__SEQPATTERN [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], hol_eq (@_SEQPATTERN T A B _ _) (fun r : A -> B -> Prop => fun s : A -> B -> Prop => fun x : A => @COND T (B -> Prop) _ (∃ y : B, r x y) (r x) (s x))
axiom thm__UNGUARDED_PATTERN [T : HOLTheory] : hol_eq HOLTheory._UNGUARDED_PATTERN (fun p : Prop => fun r : Prop => hand p r)
axiom thm__GUARDED_PATTERN [T : HOLTheory] : hol_eq HOLTheory._GUARDED_PATTERN (fun p : Prop => fun g : Prop => fun r : Prop => hand p (hand g r))
axiom thm__MATCH [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], hol_eq (@_MATCH T A B _ _) (fun e : A => fun r : A -> B -> Prop => @COND T B _ (@hexists_one T B _ (r e)) (@epsilon T B _ (r e)) (@epsilon T B _ (fun z : B => hfalse)))
axiom thm__FUNCTION [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], hol_eq (@_FUNCTION T A B _ _) (fun r : A -> B -> Prop => fun x : A => @COND T B _ (@hexists_one T B _ (r x)) (@epsilon T B _ (r x)) (@epsilon T B _ (fun z : B => hfalse)))
axiom thm_mk_pair_def [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ x : A, ∀ y : B, hol_eq (@mk_pair T A B _ _ x y) (fun a : A => fun b : B => hand (hol_eq a x) (hol_eq b y))
axiom thm_PAIR_EXISTS_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∃ x : A -> B -> Prop, ∃ a : A, ∃ b : B, hol_eq x (@mk_pair T A B _ _ a b)
axiom thm_REP_ABS_PAIR [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ x : A, ∀ y : B, hol_eq (@REP_prod T A B _ _ (@ABS_prod T A B _ _ (@mk_pair T A B _ _ x y))) (@mk_pair T A B _ _ x y)
axiom thm_COMMA_DEF [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ x : A, ∀ y : B, hol_eq (@Prod_mk T A B _ _ x y) (@ABS_prod T A B _ _ (@mk_pair T A B _ _ x y))
axiom thm_FST_DEF [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ p : HOLTheory.prod A B, hol_eq (@FST T A B _ _ p) (@epsilon T A _ (fun x : A => ∃ y : B, hol_eq p (@Prod_mk T A B _ _ x y)))
axiom thm_SND_DEF [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ p : HOLTheory.prod A B, hol_eq (@SND T A B _ _ p) (@epsilon T B _ (fun y : B => ∃ x : A, hol_eq p (@Prod_mk T A B _ _ x y)))
axiom thm_PAIR_EQ [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ x : A, ∀ y : B, ∀ a : A, ∀ b : B, hol_eq (hol_eq (@Prod_mk T A B _ _ x y) (@Prod_mk T A B _ _ a b)) (hand (hol_eq x a) (hol_eq y b))
axiom thm_PAIR_SURJECTIVE [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ p : HOLTheory.prod A B, ∃ x : A, ∃ y : B, hol_eq p (@Prod_mk T A B _ _ x y)
axiom thm_FST [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ x : A, ∀ y : B, hol_eq (@FST T A B _ _ (@Prod_mk T A B _ _ x y)) x
axiom thm_SND [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ x : A, ∀ y : B, hol_eq (@SND T A B _ _ (@Prod_mk T A B _ _ x y)) y
axiom thm_PAIR [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ x : HOLTheory.prod A B, hol_eq (@Prod_mk T A B _ _ (@FST T A B _ _ x) (@SND T A B _ _ x)) x
axiom thm_pair_INDUCT [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : (HOLTheory.prod A B) -> Prop, (∀ x : A, ∀ y : B, P (@Prod_mk T A B _ _ x y)) -> ∀ p : HOLTheory.prod A B, P p
axiom thm_pair_RECURSION [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ PAIR' : A -> B -> C, ∃ fn : (HOLTheory.prod A B) -> C, ∀ a0 : A, ∀ a1 : B, hol_eq (fn (@Prod_mk T A B _ _ a0 a1)) (PAIR' a0 a1)
axiom thm_CURRY_DEF [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : (HOLTheory.prod A B) -> C, ∀ x : A, ∀ y : B, hol_eq (@CURRY T A B C _ _ _ f x y) (f (@Prod_mk T A B _ _ x y))
axiom thm_UNCURRY_DEF [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : A -> B -> C, ∀ x : A, ∀ y : B, hol_eq (@UNCURRY T A B C _ _ _ f (@Prod_mk T A B _ _ x y)) (f x y)
axiom thm_PASSOC_DEF [T : HOLTheory] : ∀ {A B C D : Type} [Nonempty A] [Nonempty B] [Nonempty C] [Nonempty D], ∀ f : (HOLTheory.prod (HOLTheory.prod A B) C) -> D, ∀ x : A, ∀ y : B, ∀ z : C, hol_eq (@PASSOC T A B C D _ _ _ _ f (@Prod_mk T A (HOLTheory.prod B C) _ _ x (@Prod_mk T B C _ _ y z))) (f (@Prod_mk T (HOLTheory.prod A B) C _ _ (@Prod_mk T A B _ _ x y) z))
axiom thm_FORALL_PAIR_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : (HOLTheory.prod A B) -> Prop, hol_eq (∀ p : HOLTheory.prod A B, P p) (∀ p1 : A, ∀ p2 : B, P (@Prod_mk T A B _ _ p1 p2))
axiom thm_EXISTS_PAIR_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : (HOLTheory.prod A B) -> Prop, hol_eq (∃ p : HOLTheory.prod A B, P p) (∃ p1 : A, ∃ p2 : B, P (@Prod_mk T A B _ _ p1 p2))
axiom thm_LAMBDA_PAIR_THM [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ t : (HOLTheory.prod A B) -> C, hol_eq (fun p : HOLTheory.prod A B => t p) (@GABS T ((HOLTheory.prod A B) -> C) _ (fun f : (HOLTheory.prod A B) -> C => ∀ x : A, ∀ y : B, @GEQ T C _ (f (@Prod_mk T A B _ _ x y)) (t (@Prod_mk T A B _ _ x y))))
axiom thm_LAMBDA_PAIR [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : A -> B -> C, hol_eq (@GABS T ((HOLTheory.prod A B) -> C) _ (fun f' : (HOLTheory.prod A B) -> C => ∀ x : A, ∀ y : B, @GEQ T C _ (f' (@Prod_mk T A B _ _ x y)) (f x y))) (fun p : HOLTheory.prod A B => f (@FST T A B _ _ p) (@SND T A B _ _ p))
axiom thm_LAMBDA_TRIPLE_THM [T : HOLTheory] : ∀ {A B C D : Type} [Nonempty A] [Nonempty B] [Nonempty C] [Nonempty D], ∀ f : (HOLTheory.prod A (HOLTheory.prod B C)) -> D, hol_eq (fun t : HOLTheory.prod A (HOLTheory.prod B C) => f t) (@GABS T ((HOLTheory.prod A (HOLTheory.prod B C)) -> D) _ (fun f' : (HOLTheory.prod A (HOLTheory.prod B C)) -> D => ∀ x : A, ∀ y : B, ∀ z : C, @GEQ T D _ (f' (@Prod_mk T A (HOLTheory.prod B C) _ _ x (@Prod_mk T B C _ _ y z))) (f (@Prod_mk T A (HOLTheory.prod B C) _ _ x (@Prod_mk T B C _ _ y z)))))
axiom thm_LAMBDA_TRIPLE [T : HOLTheory] : ∀ {A B C D : Type} [Nonempty A] [Nonempty B] [Nonempty C] [Nonempty D], ∀ f : A -> B -> C -> D, hol_eq (@GABS T ((HOLTheory.prod A (HOLTheory.prod B C)) -> D) _ (fun f' : (HOLTheory.prod A (HOLTheory.prod B C)) -> D => ∀ x : A, ∀ y : B, ∀ z : C, @GEQ T D _ (f' (@Prod_mk T A (HOLTheory.prod B C) _ _ x (@Prod_mk T B C _ _ y z))) (f x y z))) (fun t : HOLTheory.prod A (HOLTheory.prod B C) => f (@FST T A (HOLTheory.prod B C) _ _ t) (@FST T B C _ _ (@SND T A (HOLTheory.prod B C) _ _ t)) (@SND T B C _ _ (@SND T A (HOLTheory.prod B C) _ _ t)))
axiom thm_PAIRED_ETA_THM [T : HOLTheory] : ∀ {A B C D E : Type} [Nonempty A] [Nonempty B] [Nonempty C] [Nonempty D] [Nonempty E], hand (∀ f : (HOLTheory.prod A B) -> C, hol_eq (@GABS T ((HOLTheory.prod A B) -> C) _ (fun f' : (HOLTheory.prod A B) -> C => ∀ x : A, ∀ y : B, @GEQ T C _ (f' (@Prod_mk T A B _ _ x y)) (f (@Prod_mk T A B _ _ x y)))) f) (hand (∀ f : (HOLTheory.prod A (HOLTheory.prod B C)) -> D, hol_eq (@GABS T ((HOLTheory.prod A (HOLTheory.prod B C)) -> D) _ (fun f' : (HOLTheory.prod A (HOLTheory.prod B C)) -> D => ∀ x : A, ∀ y : B, ∀ z : C, @GEQ T D _ (f' (@Prod_mk T A (HOLTheory.prod B C) _ _ x (@Prod_mk T B C _ _ y z))) (f (@Prod_mk T A (HOLTheory.prod B C) _ _ x (@Prod_mk T B C _ _ y z))))) f) (∀ f : (HOLTheory.prod A (HOLTheory.prod B (HOLTheory.prod C D))) -> E, hol_eq (@GABS T ((HOLTheory.prod A (HOLTheory.prod B (HOLTheory.prod C D))) -> E) _ (fun f' : (HOLTheory.prod A (HOLTheory.prod B (HOLTheory.prod C D))) -> E => ∀ w : A, ∀ x : B, ∀ y : C, ∀ z : D, @GEQ T E _ (f' (@Prod_mk T A (HOLTheory.prod B (HOLTheory.prod C D)) _ _ w (@Prod_mk T B (HOLTheory.prod C D) _ _ x (@Prod_mk T C D _ _ y z)))) (f (@Prod_mk T A (HOLTheory.prod B (HOLTheory.prod C D)) _ _ w (@Prod_mk T B (HOLTheory.prod C D) _ _ x (@Prod_mk T C D _ _ y z)))))) f))
axiom thm_FORALL_UNCURRY [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ P : (A -> B -> C) -> Prop, hol_eq (∀ f : A -> B -> C, P f) (∀ f : (HOLTheory.prod A B) -> C, P (fun a : A => fun b : B => f (@Prod_mk T A B _ _ a b)))
axiom thm_EXISTS_UNCURRY [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ P : (A -> B -> C) -> Prop, hol_eq (∃ f : A -> B -> C, P f) (∃ f : (HOLTheory.prod A B) -> C, P (fun a : A => fun b : B => f (@Prod_mk T A B _ _ a b)))
axiom thm_EXISTS_CURRY [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ P : ((HOLTheory.prod A B) -> C) -> Prop, hol_eq (∃ f : (HOLTheory.prod A B) -> C, P f) (∃ f : A -> B -> C, P (@GABS T ((HOLTheory.prod A B) -> C) _ (fun f' : (HOLTheory.prod A B) -> C => ∀ a : A, ∀ b : B, @GEQ T C _ (f' (@Prod_mk T A B _ _ a b)) (f a b))))
axiom thm_FORALL_CURRY [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ P : ((HOLTheory.prod A B) -> C) -> Prop, hol_eq (∀ f : (HOLTheory.prod A B) -> C, P f) (∀ f : A -> B -> C, P (@GABS T ((HOLTheory.prod A B) -> C) _ (fun f' : (HOLTheory.prod A B) -> C => ∀ a : A, ∀ b : B, @GEQ T C _ (f' (@Prod_mk T A B _ _ a b)) (f a b))))
axiom thm_FORALL_UNPAIR_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, hol_eq (∀ x : A, ∀ y : B, P x y) (∀ z : HOLTheory.prod A B, P (@FST T A B _ _ z) (@SND T A B _ _ z))
axiom thm_EXISTS_UNPAIR_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, hol_eq (∃ x : A, ∃ y : B, P x y) (∃ z : HOLTheory.prod A B, P (@FST T A B _ _ z) (@SND T A B _ _ z))
axiom thm_FORALL_PAIR_FUN_THM [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ P : (A -> HOLTheory.prod B C) -> Prop, hol_eq (∀ f : A -> HOLTheory.prod B C, P f) (∀ g : A -> B, ∀ h : A -> C, P (fun a : A => @Prod_mk T B C _ _ (g a) (h a)))
axiom thm_EXISTS_PAIR_FUN_THM [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ P : (A -> HOLTheory.prod B C) -> Prop, hol_eq (∃ f : A -> HOLTheory.prod B C, P f) (∃ g : A -> B, ∃ h : A -> C, P (fun a : A => @Prod_mk T B C _ _ (g a) (h a)))
axiom thm_FORALL_UNPAIR_FUN_THM [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ P : (A -> B) -> (A -> C) -> Prop, hol_eq (∀ f : A -> B, ∀ g : A -> C, P f g) (∀ h : A -> HOLTheory.prod B C, P (@o T A (HOLTheory.prod B C) B _ _ _ (@FST T B C _ _) h) (@o T A (HOLTheory.prod B C) C _ _ _ (@SND T B C _ _) h))
axiom thm_EXISTS_UNPAIR_FUN_THM [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ P : (A -> B) -> (A -> C) -> Prop, hol_eq (∃ f : A -> B, ∃ g : A -> C, P f g) (∃ h : A -> HOLTheory.prod B C, P (@o T A (HOLTheory.prod B C) B _ _ _ (@FST T B C _ _) h) (@o T A (HOLTheory.prod B C) C _ _ _ (@SND T B C _ _) h))
axiom thm_EXISTS_SWAP_FUN_THM [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ P : (A -> B -> C) -> Prop, hol_eq (∃ f : A -> B -> C, P f) (∃ f : B -> A -> C, P (fun a : A => fun b : B => f b a))
axiom thm_FORALL_PAIRED_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, hol_eq (HOLTheory.FORALL (@GABS T ((HOLTheory.prod A B) -> Prop) _ (fun f : (HOLTheory.prod A B) -> Prop => ∀ x : A, ∀ y : B, @GEQ T Prop _ (f (@Prod_mk T A B _ _ x y)) (P x y)))) (∀ x : A, ∀ y : B, P x y)
axiom thm_EXISTS_PAIRED_THM [T : HOLTheory] : ∀ {A B : Type} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, hol_eq (HOLTheory.EXISTS (@GABS T ((HOLTheory.prod A B) -> Prop) _ (fun f : (HOLTheory.prod A B) -> Prop => ∀ x : A, ∀ y : B, @GEQ T Prop _ (f (@Prod_mk T A B _ _ x y)) (P x y)))) (∃ x : A, ∃ y : B, P x y)
axiom thm_FORALL_TRIPLED_THM [T : HOLTheory] : ∀ {A B C : Type} [Nonempty A] [Nonempty B] [Nonempty C], ∀ P : A -> B -> C -> Prop, hol_eq (HOLTheory.FORALL (@GABS T ((HOLTheory.prod A (HOLTheory.prod B C)) -> Prop) _ (fun f : (HOLTheory.prod A (HOLTheory.prod B C)) -> Prop => ∀ x : A, ∀ y : B, ∀ z : C, @GEQ T Prop _ (f (@Prod_mk T A (HOLTheory.prod B C) _ _ x (@Prod_mk T B C _ _ y z))) (P x y z)))) (∀ x : A, ∀ y : B, ∀ z : C, P x y z)
