axiom thm_EXP_2_NE_0 : ∀ n : Nat, ¬ ((Nat.pow (NUMERAL (BIT0 (BIT1 Nat.zero))) n) = (NUMERAL Nat.zero))
axiom thm_INJ_INVERSE2 : ∀ {A B C : Type*} [Nonempty A] [Nonempty B] [Nonempty C], ∀ P : A -> B -> C, (∀ x1 : A, ∀ y1 : B, ∀ x2 : A, ∀ y2 : B, ((P x1 y1) = (P x2 y2)) = ((x1 = x2) ∧ (y1 = y2))) -> ∃ X : C -> A, ∃ Y : C -> B, ∀ x : A, ∀ y : B, ((X (P x y)) = x) ∧ ((Y (P x y)) = y)
