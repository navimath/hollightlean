axiom thm_NADD_MUL_ASSOC : ∀ x : nadd, ∀ y : nadd, ∀ z : nadd, nadd_eq (nadd_mul x (nadd_mul y z)) (nadd_mul (nadd_mul x y) z)
axiom thm_NADD_MUL_LID : ∀ x : nadd, nadd_eq (nadd_mul (nadd_of_num (NUMERAL (BIT1 Nat.zero))) x) x
axiom thm_NADD_LDISTRIB : ∀ x : nadd, ∀ y : nadd, ∀ z : nadd, nadd_eq (nadd_mul x (nadd_add y z)) (nadd_add (nadd_mul x y) (nadd_mul x z))
axiom thm_NADD_MUL_WELLDEF_LEMMA : ∀ x : nadd, ∀ y : nadd, ∀ y' : nadd, (nadd_eq y y') -> nadd_eq (nadd_mul x y) (nadd_mul x y')
axiom thm_NADD_MUL_WELLDEF : ∀ x : nadd, ∀ x' : nadd, ∀ y : nadd, ∀ y' : nadd, ((nadd_eq x x') ∧ (nadd_eq y y')) -> nadd_eq (nadd_mul x y) (nadd_mul x' y')
axiom thm_NADD_OF_NUM_MUL : ∀ m : Nat, ∀ n : Nat, nadd_eq (nadd_mul (nadd_of_num m) (nadd_of_num n)) (nadd_of_num (Nat.mul m n))
axiom thm_NADD_LE_0 : ∀ x : nadd, nadd_le (nadd_of_num (NUMERAL Nat.zero)) x
axiom thm_NADD_EQ_IMP_LE : ∀ x : nadd, ∀ y : nadd, (nadd_eq x y) -> nadd_le x y
