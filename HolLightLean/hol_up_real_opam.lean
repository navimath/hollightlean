axiom thm_NADD_LE_RADD : ∀ x : nadd, ∀ y : nadd, ∀ z : nadd, (nadd_le (nadd_add x z) (nadd_add y z)) = (nadd_le x y)
axiom thm_NADD_LE_LADD : ∀ x : nadd, ∀ y : nadd, ∀ z : nadd, (nadd_le (nadd_add x y) (nadd_add x z)) = (nadd_le y z)
axiom thm_NADD_RDISTRIB : ∀ x : nadd, ∀ y : nadd, ∀ z : nadd, nadd_eq (nadd_mul (nadd_add x y) z) (nadd_add (nadd_mul x z) (nadd_mul y z))
axiom thm_NADD_ARCH_MULT : ∀ x : nadd, ∀ k : Nat, (¬ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero)))) -> ∃ N' : Nat, nadd_le (nadd_of_num k) (nadd_mul (nadd_of_num N') x)
axiom thm_NADD_ARCH_ZERO : ∀ x : nadd, ∀ k : nadd, (∀ n : Nat, nadd_le (nadd_mul (nadd_of_num n) x) k) -> nadd_eq x (nadd_of_num (NUMERAL Nat.zero))
axiom thm_NADD_ARCH_LEMMA : ∀ x : nadd, ∀ y : nadd, ∀ z : nadd, (∀ n : Nat, nadd_le (nadd_mul (nadd_of_num n) x) (nadd_add (nadd_mul (nadd_of_num n) y) z)) -> nadd_le x y
axiom thm_NADD_COMPLETE : ∀ P : nadd -> Prop, ((∃ x : nadd, P x) ∧ (∃ M : nadd, ∀ x : nadd, (P x) -> nadd_le x M)) -> ∃ M : nadd, (∀ x : nadd, (P x) -> nadd_le x M) ∧ (∀ M' : nadd, (∀ x : nadd, (P x) -> nadd_le x M') -> nadd_le M M')
axiom thm_NADD_UBOUND : ∀ x : nadd, ∃ B : Nat, ∃ N' : Nat, ∀ n : Nat, (Nat.le N' n) -> Nat.le (dest_nadd x n) (Nat.mul B n)
axiom thm_NADD_NONZERO : ∀ x : nadd, (¬ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero)))) -> ∃ N' : Nat, ∀ n : Nat, (Nat.le N' n) -> ¬ ((dest_nadd x n) = (NUMERAL Nat.zero))
axiom thm_NADD_LBOUND : ∀ x : nadd, (¬ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero)))) -> ∃ A : Nat, ∃ N' : Nat, ∀ n : Nat, (Nat.le N' n) -> Nat.le n (Nat.mul A (dest_nadd x n))
axiom thm_nadd_rinv : ∀ x : nadd, (nadd_rinv x) = (fun n : Nat => Nat.div (Nat.mul n n) (dest_nadd x n))
axiom thm_NADD_MUL_LINV_LEMMA0 : ∀ x : nadd, (¬ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero)))) -> ∃ A : Nat, ∃ B : Nat, ∀ n : Nat, Nat.le (nadd_rinv x n) (Nat.add (Nat.mul A n) B)
axiom thm_NADD_MUL_LINV_LEMMA1 : ∀ x : nadd, ∀ n : Nat, (¬ ((dest_nadd x n) = (NUMERAL Nat.zero))) -> Nat.le (DIST (@prod_mk Nat Nat _ _ (Nat.mul (dest_nadd x n) (nadd_rinv x n)) (Nat.mul n n))) (dest_nadd x n)
axiom thm_NADD_MUL_LINV_LEMMA2 : ∀ x : nadd, (¬ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero)))) -> ∃ N' : Nat, ∀ n : Nat, (Nat.le N' n) -> Nat.le (DIST (@prod_mk Nat Nat _ _ (Nat.mul (dest_nadd x n) (nadd_rinv x n)) (Nat.mul n n))) (dest_nadd x n)
axiom thm_NADD_MUL_LINV_LEMMA3 : ∀ x : nadd, (¬ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero)))) -> ∃ N' : Nat, ∀ m : Nat, ∀ n : Nat, (Nat.le N' n) -> Nat.le (DIST (@prod_mk Nat Nat _ _ (Nat.mul m (Nat.mul (dest_nadd x m) (Nat.mul (dest_nadd x n) (nadd_rinv x n)))) (Nat.mul m (Nat.mul (dest_nadd x m) (Nat.mul n n))))) (Nat.mul m (Nat.mul (dest_nadd x m) (dest_nadd x n)))
axiom thm_NADD_MUL_LINV_LEMMA4 : ∀ x : nadd, (¬ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero)))) -> ∃ N' : Nat, ∀ m : Nat, ∀ n : Nat, ((Nat.le N' m) ∧ (Nat.le N' n)) -> Nat.le (Nat.mul (Nat.mul (dest_nadd x m) (dest_nadd x n)) (DIST (@prod_mk Nat Nat _ _ (Nat.mul m (nadd_rinv x n)) (Nat.mul n (nadd_rinv x m))))) (Nat.add (Nat.mul (Nat.mul m n) (DIST (@prod_mk Nat Nat _ _ (Nat.mul m (dest_nadd x n)) (Nat.mul n (dest_nadd x m))))) (Nat.mul (Nat.mul (dest_nadd x m) (dest_nadd x n)) (Nat.add m n)))
axiom thm_NADD_MUL_LINV_LEMMA5 : ∀ x : nadd, (¬ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero)))) -> ∃ B : Nat, ∃ N' : Nat, ∀ m : Nat, ∀ n : Nat, ((Nat.le N' m) ∧ (Nat.le N' n)) -> Nat.le (Nat.mul (Nat.mul (dest_nadd x m) (dest_nadd x n)) (DIST (@prod_mk Nat Nat _ _ (Nat.mul m (nadd_rinv x n)) (Nat.mul n (nadd_rinv x m))))) (Nat.mul B (Nat.mul (Nat.mul m n) (Nat.add m n)))
axiom thm_NADD_MUL_LINV_LEMMA6 : ∀ x : nadd, (¬ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero)))) -> ∃ B : Nat, ∃ N' : Nat, ∀ m : Nat, ∀ n : Nat, ((Nat.le N' m) ∧ (Nat.le N' n)) -> Nat.le (Nat.mul (Nat.mul m n) (DIST (@prod_mk Nat Nat _ _ (Nat.mul m (nadd_rinv x n)) (Nat.mul n (nadd_rinv x m))))) (Nat.mul B (Nat.mul (Nat.mul m n) (Nat.add m n)))
axiom thm_NADD_MUL_LINV_LEMMA7 : ∀ x : nadd, (¬ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero)))) -> ∃ B : Nat, ∃ N' : Nat, ∀ m : Nat, ∀ n : Nat, ((Nat.le N' m) ∧ (Nat.le N' n)) -> Nat.le (DIST (@prod_mk Nat Nat _ _ (Nat.mul m (nadd_rinv x n)) (Nat.mul n (nadd_rinv x m)))) (Nat.mul B (Nat.add m n))
axiom thm_NADD_MUL_LINV_LEMMA7a : ∀ x : nadd, (¬ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero)))) -> ∀ N' : Nat, ∃ A : Nat, ∃ B : Nat, ∀ m : Nat, ∀ n : Nat, (Nat.le m N') -> Nat.le (DIST (@prod_mk Nat Nat _ _ (Nat.mul m (nadd_rinv x n)) (Nat.mul n (nadd_rinv x m)))) (Nat.add (Nat.mul A n) B)
axiom thm_NADD_MUL_LINV_LEMMA8 : ∀ x : nadd, (¬ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero)))) -> ∃ B : Nat, ∀ m : Nat, ∀ n : Nat, Nat.le (DIST (@prod_mk Nat Nat _ _ (Nat.mul m (nadd_rinv x n)) (Nat.mul n (nadd_rinv x m)))) (Nat.mul B (Nat.add m n))
axiom thm_nadd_inv : ∀ x : nadd, (nadd_inv x) = (@COND nadd _ (nadd_eq x (nadd_of_num (NUMERAL Nat.zero))) (nadd_of_num (NUMERAL Nat.zero)) (mk_nadd (nadd_rinv x)))
