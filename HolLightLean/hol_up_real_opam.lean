axiom thm_NADD_LE_WELLDEF_LEMMA : ∀ x : nadd, ∀ x' : nadd, ∀ y : nadd, ∀ y' : nadd, ((nadd_eq x x') ∧ ((nadd_eq y y') ∧ (nadd_le x y))) -> nadd_le x' y'
axiom thm_NADD_LE_WELLDEF : ∀ x : nadd, ∀ x' : nadd, ∀ y : nadd, ∀ y' : nadd, ((nadd_eq x x') ∧ (nadd_eq y y')) -> (nadd_le x y) = (nadd_le x' y')
axiom thm_NADD_LE_REFL : ∀ x : nadd, nadd_le x x
axiom thm_NADD_LE_TRANS : ∀ x : nadd, ∀ y : nadd, ∀ z : nadd, ((nadd_le x y) ∧ (nadd_le y z)) -> nadd_le x z
axiom thm_NADD_LE_ANTISYM : ∀ x : nadd, ∀ y : nadd, ((nadd_le x y) ∧ (nadd_le y x)) = (nadd_eq x y)
axiom thm_NADD_LE_TOTAL_LEMMA : ∀ x : nadd, ∀ y : nadd, (¬ (nadd_le x y)) -> ∀ B : Nat, ∃ n : Nat, (¬ (n = (NUMERAL Nat.zero))) ∧ (Nat.lt (Nat.add (dest_nadd y n) B) (dest_nadd x n))
axiom thm_NADD_LE_TOTAL : ∀ x : nadd, ∀ y : nadd, (nadd_le x y) ∨ (nadd_le y x)
