axiom thm_nadd_add : ∀ x : nadd, ∀ y : nadd, (nadd_add x y) = (mk_nadd (fun n : Nat => Nat.add (dest_nadd x n) (dest_nadd y n)))
axiom thm_NADD_ADD : ∀ x : nadd, ∀ y : nadd, (dest_nadd (nadd_add x y)) = (fun n : Nat => Nat.add (dest_nadd x n) (dest_nadd y n))
axiom thm_NADD_ADD_WELLDEF : ∀ x : nadd, ∀ x' : nadd, ∀ y : nadd, ∀ y' : nadd, ((nadd_eq x x') ∧ (nadd_eq y y')) -> nadd_eq (nadd_add x y) (nadd_add x' y')
