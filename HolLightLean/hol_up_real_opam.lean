axiom thm_ZRECSPACE_RULES : ∀ {A : Type*} [Nonempty A], (@ZRECSPACE A _ (@ZBOT A _)) ∧ (∀ c : Nat, ∀ i : A, ∀ r : Nat -> Nat -> A -> Prop, (∀ n : Nat, @ZRECSPACE A _ (r n)) -> @ZRECSPACE A _ (@ZCONSTR A _ c i r))
axiom thm_ZRECSPACE_CASES : ∀ {A : Type*} [Nonempty A], ∀ a : Nat -> A -> Prop, (@ZRECSPACE A _ a) = ((a = (@ZBOT A _)) ∨ (∃ c : Nat, ∃ i : A, ∃ r : Nat -> Nat -> A -> Prop, (a = (@ZCONSTR A _ c i r)) ∧ (∀ n : Nat, @ZRECSPACE A _ (r n))))
axiom thm_ZRECSPACE_INDUCT : ∀ {A : Type*} [Nonempty A], ∀ ZRECSPACE' : (Nat -> A -> Prop) -> Prop, ((ZRECSPACE' (@ZBOT A _)) ∧ (∀ c : Nat, ∀ i : A, ∀ r : Nat -> Nat -> A -> Prop, (∀ n : Nat, ZRECSPACE' (r n)) -> ZRECSPACE' (@ZCONSTR A _ c i r))) -> ∀ a : Nat -> A -> Prop, (@ZRECSPACE A _ a) -> ZRECSPACE' a
axiom thm_BOTTOM : ∀ {A : Type*} [Nonempty A], (@BOTTOM A _) = (@_mk_rec A _ (@ZBOT A _))
axiom thm_CONSTR : ∀ {A : Type*} [Nonempty A], ∀ c : Nat, ∀ i : A, ∀ r : Nat -> recspace A, (@CONSTR A _ c i r) = (@_mk_rec A _ (@ZCONSTR A _ c i (fun n : Nat => @_dest_rec A _ (r n))))
axiom thm_MK_REC_INJ : ∀ {A : Type*} [Nonempty A], ∀ x : Nat -> A -> Prop, ∀ y : Nat -> A -> Prop, ((@_mk_rec A _ x) = (@_mk_rec A _ y)) -> ((@ZRECSPACE A _ x) ∧ (@ZRECSPACE A _ y)) -> x = y
axiom thm_DEST_REC_INJ : ∀ {A : Type*} [Nonempty A], ∀ x : recspace A, ∀ y : recspace A, ((@_dest_rec A _ x) = (@_dest_rec A _ y)) = (x = y)
axiom thm_CONSTR_BOT : ∀ {A : Type*} [Nonempty A], ∀ c : Nat, ∀ i : A, ∀ r : Nat -> recspace A, ¬ ((@CONSTR A _ c i r) = (@BOTTOM A _))
axiom thm_CONSTR_INJ : ∀ {A : Type*} [Nonempty A], ∀ c1 : Nat, ∀ i1 : A, ∀ r1 : Nat -> recspace A, ∀ c2 : Nat, ∀ i2 : A, ∀ r2 : Nat -> recspace A, ((@CONSTR A _ c1 i1 r1) = (@CONSTR A _ c2 i2 r2)) = ((c1 = c2) ∧ ((i1 = i2) ∧ (r1 = r2)))
axiom thm_CONSTR_IND : ∀ {A : Type*} [Nonempty A], ∀ P : (recspace A) -> Prop, ((P (@BOTTOM A _)) ∧ (∀ c : Nat, ∀ i : A, ∀ r : Nat -> recspace A, (∀ n : Nat, P (r n)) -> P (@CONSTR A _ c i r))) -> ∀ x : recspace A, P x
axiom thm_CONSTR_REC : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ Fn : Nat -> A -> (Nat -> recspace A) -> (Nat -> B) -> B, ∃ f : (recspace A) -> B, ∀ c : Nat, ∀ i : A, ∀ r : Nat -> recspace A, (f (@CONSTR A _ c i r)) = (Fn c i r (fun n : Nat => f (r n)))
axiom thm_FCONS : ∀ {A : Type*} [Nonempty A], (∀ a : A, ∀ f : Nat -> A, (@FCONS A _ a f (NUMERAL Nat.zero)) = a) ∧ (∀ a : A, ∀ f : Nat -> A, ∀ n : Nat, (@FCONS A _ a f (Nat.succ n)) = (f n))
axiom thm_FCONS_UNDO : ∀ {A : Type*} [Nonempty A], ∀ f : Nat -> A, f = (@FCONS A _ (f (NUMERAL Nat.zero)) (@o Nat Nat A _ _ _ f Nat.succ))
axiom thm_FNIL : ∀ {A : Type*} [Nonempty A], ∀ n : Nat, (@FNIL A _ n) = (@Classical.epsilon A _ (fun x : A => True))
axiom thm_sum_INDUCT : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : (SUM A B) -> Prop, ((∀ a : A, P (@INL A B _ _ a)) ∧ (∀ a : B, P (@INR A B _ _ a))) -> ∀ x : SUM A B, P x
axiom thm_sum_RECURSION : ∀ {A B Z' : Type*} [Nonempty A] [Nonempty B] [Nonempty Z'], ∀ INL' : A -> Z', ∀ INR' : B -> Z', ∃ fn : (SUM A B) -> Z', (∀ a : A, (fn (@INL A B _ _ a)) = (INL' a)) ∧ (∀ a : B, (fn (@INR A B _ _ a)) = (INR' a))
axiom thm_OUTL : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (x : A), (@OUTL A B _ _ (@INL A B _ _ x)) = x
axiom thm_OUTR : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (y : B), (@OUTR A B _ _ (@INR A B _ _ y)) = y
axiom thm_option_INDUCT : ∀ {A : Type*} [Nonempty A], ∀ P : (Option A) -> Prop, ((P (@NONE A _)) ∧ (∀ a : A, P (@SOME A _ a))) -> ∀ x : Option A, P x
axiom thm_option_RECURSION : ∀ {A Z' : Type*} [Nonempty A] [Nonempty Z'], ∀ NONE' : Z', ∀ SOME' : A -> Z', ∃ fn : (Option A) -> Z', ((fn (@NONE A _)) = NONE') ∧ (∀ a : A, (fn (@SOME A _ a)) = (SOME' a))
axiom thm_list_INDUCT : ∀ {A : Type*} [Nonempty A], ∀ P : (List A) -> Prop, ((P (@NIL A _)) ∧ (∀ a0 : A, ∀ a1 : List A, (P a1) -> P (@CONS A _ a0 a1))) -> ∀ x : List A, P x
axiom thm_list_RECURSION : ∀ {A Z' : Type*} [Nonempty A] [Nonempty Z'], ∀ NIL' : Z', ∀ CONS' : A -> (List A) -> Z' -> Z', ∃ fn : (List A) -> Z', ((fn (@NIL A _)) = NIL') ∧ (∀ a0 : A, ∀ a1 : List A, (fn (@CONS A _ a0 a1)) = (CONS' a0 a1 (fn a1)))
axiom thm_FORALL_OPTION_THM : ∀ {A : Type*} [Nonempty A], ∀ P : (Option A) -> Prop, (∀ x : Option A, P x) = ((P (@NONE A _)) ∧ (∀ a : A, P (@SOME A _ a)))
axiom thm_EXISTS_OPTION_THM : ∀ {A : Type*} [Nonempty A], ∀ P : (Option A) -> Prop, (∃ x : Option A, P x) = ((P (@NONE A _)) ∨ (∃ a : A, P (@SOME A _ a)))
axiom thm_option_DISTINCT : ∀ {A : Type*} [Nonempty A], ∀ a : A, ¬ ((@SOME A _ a) = (@NONE A _))
axiom thm_option_INJ : ∀ {A : Type*} [Nonempty A], ∀ a : A, ∀ b : A, ((@SOME A _ a) = (@SOME A _ b)) = (a = b)
axiom thm_ISO : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ g : B -> A, ∀ f : A -> B, (@ISO A B _ _ f g) = ((∀ x : B, (f (g x)) = x) ∧ (∀ y : A, (g (f y)) = y))
axiom thm_ISO_REFL : ∀ {A : Type*} [Nonempty A], @ISO A A _ _ (fun x : A => x) (fun x : A => x)
axiom thm_ISO_FUN : ∀ {A A' B B' : Type*} [Nonempty A] [Nonempty A'] [Nonempty B] [Nonempty B'] (g : B -> B') (f' : A' -> A) (g' : B' -> B) (f : A -> A'), ((@ISO A A' _ _ f f') ∧ (@ISO B B' _ _ g g')) -> @ISO (A -> B) (A' -> B') _ _ (fun h : A -> B => fun a' : A' => g (h (f' a'))) (fun h : A' -> B' => fun a : A => g' (h (f a)))
axiom thm_ISO_USAGE : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (g : B -> A) (f : A -> B), (@ISO A B _ _ f g) -> (∀ P : A -> Prop, (∀ x : A, P x) = (∀ x : B, P (g x))) ∧ ((∀ P : A -> Prop, (∃ x : A, P x) = (∃ x : B, P (g x))) ∧ (∀ a : A, ∀ b : B, (a = (g b)) = ((f a) = b)))
axiom thm_HD : ∀ {A : Type*} [Nonempty A] (t : List A) (h : A), (@HD A _ (@CONS A _ h t)) = h
axiom thm_TL : ∀ {A : Type*} [Nonempty A] (h : A) (t : List A), (@TL A _ (@CONS A _ h t)) = t
axiom thm_APPEND : ∀ {A : Type*} [Nonempty A], (∀ l : List A, (@APPEND A _ (@NIL A _) l) = l) ∧ (∀ h : A, ∀ t : List A, ∀ l : List A, (@APPEND A _ (@CONS A _ h t) l) = (@CONS A _ h (@APPEND A _ t l)))
axiom thm_REVERSE : ∀ {A : Type*} [Nonempty A] (l : List A) (x : A), ((@REVERSE A _ (@NIL A _)) = (@NIL A _)) ∧ ((@REVERSE A _ (@CONS A _ x l)) = (@APPEND A _ (@REVERSE A _ l) (@CONS A _ x (@NIL A _))))
axiom thm_LENGTH : ∀ {A : Type*} [Nonempty A], ((@LENGTH A _ (@NIL A _)) = (NUMERAL Nat.zero)) ∧ (∀ h : A, ∀ t : List A, (@LENGTH A _ (@CONS A _ h t)) = (Nat.succ (@LENGTH A _ t)))
axiom thm_MAP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], (∀ f : A -> B, (@MAP A B _ _ f (@NIL A _)) = (@NIL B _)) ∧ (∀ f : A -> B, ∀ h : A, ∀ t : List A, (@MAP A B _ _ f (@CONS A _ h t)) = (@CONS B _ (f h) (@MAP A B _ _ f t)))
axiom thm_LAST : ∀ {A : Type*} [Nonempty A] (h : A) (t : List A), (@LAST A _ (@CONS A _ h t)) = (@COND A _ (t = (@NIL A _)) h (@LAST A _ t))
axiom thm_BUTLAST : ∀ {A : Type*} [Nonempty A] (h : A) (t : List A), ((@BUTLAST A _ (@NIL A _)) = (@NIL A _)) ∧ ((@BUTLAST A _ (@CONS A _ h t)) = (@COND (List A) _ (t = (@NIL A _)) (@NIL A _) (@CONS A _ h (@BUTLAST A _ t))))
axiom thm_REPLICATE : ∀ {A : Type*} [Nonempty A] (n : Nat) (x : A), ((@REPLICATE A _ (NUMERAL Nat.zero) x) = (@NIL A _)) ∧ ((@REPLICATE A _ (Nat.succ n) x) = (@CONS A _ x (@REPLICATE A _ n x)))
axiom thm_NULL : ∀ {A : Type*} [Nonempty A] (h : A) (t : List A), ((@NULL A _ (@NIL A _)) = True) ∧ ((@NULL A _ (@CONS A _ h t)) = False)
axiom thm_ALL : ∀ {A : Type*} [Nonempty A] (h : A) (P : A -> Prop) (t : List A), ((@ALL A _ P (@NIL A _)) = True) ∧ ((@ALL A _ P (@CONS A _ h t)) = ((P h) ∧ (@ALL A _ P t)))
axiom thm_EX : ∀ {A : Type*} [Nonempty A] (h : A) (P : A -> Prop) (t : List A), ((@EX A _ P (@NIL A _)) = False) ∧ ((@EX A _ P (@CONS A _ h t)) = ((P h) ∨ (@EX A _ P t)))
axiom thm_ITLIST : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (h : A) (f : A -> B -> B) (t : List A) (b : B), ((@ITLIST A B _ _ f (@NIL A _) b) = b) ∧ ((@ITLIST A B _ _ f (@CONS A _ h t) b) = (f h (@ITLIST A B _ _ f t b)))
axiom thm_MEM : ∀ {A : Type*} [Nonempty A] (h : A) (x : A) (t : List A), ((@MEM A _ x (@NIL A _)) = False) ∧ ((@MEM A _ x (@CONS A _ h t)) = ((x = h) ∨ (@MEM A _ x t)))
axiom thm_ALL2_DEF : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (h1' : A) (P : A -> B -> Prop) (t1 : List A) (l2 : List B), ((@ALL2 A B _ _ P (@NIL A _) l2) = (l2 = (@NIL B _))) ∧ ((@ALL2 A B _ _ P (@CONS A _ h1' t1) l2) = (@COND Prop _ (l2 = (@NIL B _)) False ((P h1' (@HD B _ l2)) ∧ (@ALL2 A B _ _ P t1 (@TL B _ l2)))))
axiom thm_ALL2 : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (h1' : A) (h2' : B) (P : A -> B -> Prop) (t1 : List A) (t2 : List B), ((@ALL2 A B _ _ P (@NIL A _) (@NIL B _)) = True) ∧ (((@ALL2 A B _ _ P (@CONS A _ h1' t1) (@NIL B _)) = False) ∧ (((@ALL2 A B _ _ P (@NIL A _) (@CONS B _ h2' t2)) = False) ∧ ((@ALL2 A B _ _ P (@CONS A _ h1' t1) (@CONS B _ h2' t2)) = ((P h1' h2') ∧ (@ALL2 A B _ _ P t1 t2)))))
axiom thm_MAP2_DEF : ∀ {A B C : Type*} [Nonempty A] [Nonempty B] [Nonempty C] (h1' : A) (f : A -> B -> C) (t1 : List A) (l : List B), ((@MAP2 A B C _ _ _ f (@NIL A _) l) = (@NIL C _)) ∧ ((@MAP2 A B C _ _ _ f (@CONS A _ h1' t1) l) = (@CONS C _ (f h1' (@HD B _ l)) (@MAP2 A B C _ _ _ f t1 (@TL B _ l))))
axiom thm_MAP2 : ∀ {A B C : Type*} [Nonempty A] [Nonempty B] [Nonempty C] (h1' : A) (h2' : B) (f : A -> B -> C) (t1 : List A) (t2 : List B), ((@MAP2 A B C _ _ _ f (@NIL A _) (@NIL B _)) = (@NIL C _)) ∧ ((@MAP2 A B C _ _ _ f (@CONS A _ h1' t1) (@CONS B _ h2' t2)) = (@CONS C _ (f h1' h2') (@MAP2 A B C _ _ _ f t1 t2)))
axiom thm_EL : ∀ {A : Type*} [Nonempty A] (n : Nat) (l : List A), ((@EL A _ (NUMERAL Nat.zero) l) = (@HD A _ l)) ∧ ((@EL A _ (Nat.succ n) l) = (@EL A _ n (@TL A _ l)))
axiom thm_FILTER : ∀ {A : Type*} [Nonempty A] (h : A) (P : A -> Prop) (t : List A), ((@FILTER A _ P (@NIL A _)) = (@NIL A _)) ∧ ((@FILTER A _ P (@CONS A _ h t)) = (@COND (List A) _ (P h) (@CONS A _ h (@FILTER A _ P t)) (@FILTER A _ P t)))
axiom thm_ASSOC : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (h : prod A B) (a : A) (t : List (prod A B)), (@ASSOC A B _ _ a (@CONS (prod A B) _ h t)) = (@COND B _ ((@prod_fst A B _ _ h) = a) (@prod_snd A B _ _ h) (@ASSOC A B _ _ a t))
axiom thm_ITLIST2_DEF : ∀ {A B C : Type*} [Nonempty A] [Nonempty B] [Nonempty C] (h1' : A) (f : A -> B -> C -> C) (t1 : List A) (l2 : List B) (b : C), ((@ITLIST2 A B C _ _ _ f (@NIL A _) l2 b) = b) ∧ ((@ITLIST2 A B C _ _ _ f (@CONS A _ h1' t1) l2 b) = (f h1' (@HD B _ l2) (@ITLIST2 A B C _ _ _ f t1 (@TL B _ l2) b)))
axiom thm_ITLIST2 : ∀ {A B C : Type*} [Nonempty A] [Nonempty B] [Nonempty C] (h1' : A) (h2' : B) (f : A -> B -> C -> C) (t1 : List A) (t2 : List B) (b : C), ((@ITLIST2 A B C _ _ _ f (@NIL A _) (@NIL B _) b) = b) ∧ ((@ITLIST2 A B C _ _ _ f (@CONS A _ h1' t1) (@CONS B _ h2' t2) b) = (f h1' h2' (@ITLIST2 A B C _ _ _ f t1 t2 b)))
axiom thm_ZIP_DEF : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (h1' : A) (t1 : List A) (l2 : List B), ((@ZIP A B _ _ (@NIL A _) l2) = (@NIL (prod A B) _)) ∧ ((@ZIP A B _ _ (@CONS A _ h1' t1) l2) = (@CONS (prod A B) _ (@prod_mk A B _ _ h1' (@HD B _ l2)) (@ZIP A B _ _ t1 (@TL B _ l2))))
axiom thm_ZIP : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (h1' : A) (h2' : B) (t1 : List A) (t2 : List B), ((@ZIP A B _ _ (@NIL A _) (@NIL B _)) = (@NIL (prod A B) _)) ∧ ((@ZIP A B _ _ (@CONS A _ h1' t1) (@CONS B _ h2' t2)) = (@CONS (prod A B) _ (@prod_mk A B _ _ h1' h2') (@ZIP A B _ _ t1 t2)))
axiom thm_ALLPAIRS : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (h : A) (f : A -> B -> Prop) (t : List A) (l : List B), ((@ALLPAIRS A B _ _ f (@NIL A _) l) = True) ∧ ((@ALLPAIRS A B _ _ f (@CONS A _ h t) l) = ((@ALL B _ (f h) l) ∧ (@ALLPAIRS A B _ _ f t l)))
axiom thm_PAIRWISE : ∀ {A : Type*} [Nonempty A] (h : A) (r : A -> A -> Prop) (t : List A), ((@PAIRWISE A _ r (@NIL A _)) = True) ∧ ((@PAIRWISE A _ r (@CONS A _ h t)) = ((@ALL A _ (r h) t) ∧ (@PAIRWISE A _ r t)))
axiom thm_list_of_seq : ∀ {A : Type*} [Nonempty A] (s : Nat -> A) (n : Nat), ((@list_of_seq A _ s (NUMERAL Nat.zero)) = (@NIL A _)) ∧ ((@list_of_seq A _ s (Nat.succ n)) = (@APPEND A _ (@list_of_seq A _ s n) (@CONS A _ (s n) (@NIL A _))))
axiom thm_NOT_CONS_NIL : ∀ {A : Type*} [Nonempty A], ∀ h : A, ∀ t : List A, ¬ ((@CONS A _ h t) = (@NIL A _))
axiom thm_LAST_CLAUSES : ∀ {A : Type*} [Nonempty A] (h : A) (k : A) (t : List A), ((@LAST A _ (@CONS A _ h (@NIL A _))) = h) ∧ ((@LAST A _ (@CONS A _ h (@CONS A _ k t))) = (@LAST A _ (@CONS A _ k t)))
axiom thm_APPEND_NIL : ∀ {A : Type*} [Nonempty A], ∀ l : List A, (@APPEND A _ l (@NIL A _)) = l
axiom thm_APPEND_ASSOC : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ∀ m : List A, ∀ n : List A, (@APPEND A _ l (@APPEND A _ m n)) = (@APPEND A _ (@APPEND A _ l m) n)
axiom thm_REVERSE_APPEND : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ∀ m : List A, (@REVERSE A _ (@APPEND A _ l m)) = (@APPEND A _ (@REVERSE A _ m) (@REVERSE A _ l))
axiom thm_REVERSE_REVERSE : ∀ {A : Type*} [Nonempty A], ∀ l : List A, (@REVERSE A _ (@REVERSE A _ l)) = l
axiom thm_REVERSE_EQ_EMPTY : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ((@REVERSE A _ l) = (@NIL A _)) = (l = (@NIL A _))
axiom thm_CONS_11 : ∀ {A : Type*} [Nonempty A], ∀ h1' : A, ∀ h2' : A, ∀ t1 : List A, ∀ t2 : List A, ((@CONS A _ h1' t1) = (@CONS A _ h2' t2)) = ((h1' = h2') ∧ (t1 = t2))
axiom thm_list_CASES : ∀ {A : Type*} [Nonempty A], ∀ l : List A, (l = (@NIL A _)) ∨ (∃ h : A, ∃ t : List A, l = (@CONS A _ h t))
axiom thm_LIST_EQ : ∀ {A : Type*} [Nonempty A], ∀ l1 : List A, ∀ l2 : List A, (l1 = l2) = (((@LENGTH A _ l1) = (@LENGTH A _ l2)) ∧ (∀ n : Nat, (Nat.lt n (@LENGTH A _ l2)) -> (@EL A _ n l1) = (@EL A _ n l2)))
axiom thm_LENGTH_APPEND : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ∀ m : List A, (@LENGTH A _ (@APPEND A _ l m)) = (Nat.add (@LENGTH A _ l) (@LENGTH A _ m))
axiom thm_MAP_APPEND : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ l1 : List A, ∀ l2 : List A, (@MAP A B _ _ f (@APPEND A _ l1 l2)) = (@APPEND B _ (@MAP A B _ _ f l1) (@MAP A B _ _ f l2))
axiom thm_LENGTH_MAP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ l : List A, ∀ f : A -> B, (@LENGTH B _ (@MAP A B _ _ f l)) = (@LENGTH A _ l)
axiom thm_LENGTH_EQ_NIL : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ((@LENGTH A _ l) = (NUMERAL Nat.zero)) = (l = (@NIL A _))
axiom thm_LENGTH_EQ_CONS : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ∀ n : Nat, ((@LENGTH A _ l) = (Nat.succ n)) = (∃ h : A, ∃ t : List A, (l = (@CONS A _ h t)) ∧ ((@LENGTH A _ t) = n))
axiom thm_LENGTH_REVERSE : ∀ {A : Type*} [Nonempty A], ∀ l : List A, (@LENGTH A _ (@REVERSE A _ l)) = (@LENGTH A _ l)
axiom thm_MAP_o : ∀ {A B C : Type*} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : A -> B, ∀ g : B -> C, ∀ l : List A, (@MAP A C _ _ (@o A B C _ _ _ g f) l) = (@MAP B C _ _ g (@MAP A B _ _ f l))
axiom thm_MAP_EQ : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ g : A -> B, ∀ l : List A, (@ALL A _ (fun x : A => (f x) = (g x)) l) -> (@MAP A B _ _ f l) = (@MAP A B _ _ g l)
axiom thm_ALL_IMP : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, ∀ l : List A, ((∀ x : A, ((@MEM A _ x l) ∧ (P x)) -> Q x) ∧ (@ALL A _ P l)) -> @ALL A _ Q l
axiom thm_NOT_EX : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ l : List A, (¬ (@EX A _ P l)) = (@ALL A _ (fun x : A => ¬ (P x)) l)
axiom thm_NOT_ALL : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ l : List A, (¬ (@ALL A _ P l)) = (@EX A _ (fun x : A => ¬ (P x)) l)
axiom thm_ALL_MAP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : B -> Prop, ∀ f : A -> B, ∀ l : List A, (@ALL B _ P (@MAP A B _ _ f l)) = (@ALL A _ (@o A B Prop _ _ _ P f) l)
axiom thm_ALL_EQ : ∀ {A : Type*} [Nonempty A] (R' : A -> Prop) (P : A -> Prop) (Q : A -> Prop), ∀ l : List A, ((@ALL A _ R' l) ∧ (∀ x : A, (R' x) -> (P x) = (Q x))) -> (@ALL A _ P l) = (@ALL A _ Q l)
axiom thm_ALL_T : ∀ {A : Type*} [Nonempty A], ∀ l : List A, @ALL A _ (fun x : A => True) l
axiom thm_MAP_EQ_ALL2 : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ l : List A, ∀ m : List A, (@ALL2 A A _ _ (fun x : A => fun y : A => (f x) = (f y)) l m) -> (@MAP A B _ _ f l) = (@MAP A B _ _ f m)
axiom thm_ALL2_MAP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : B -> A -> Prop, ∀ f : A -> B, ∀ l : List A, (@ALL2 B A _ _ P (@MAP A B _ _ f l) l) = (@ALL A _ (fun a : A => P (f a) a) l)
axiom thm_MAP_EQ_DEGEN : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ∀ f : A -> A, (@ALL A _ (fun x : A => (f x) = x) l) -> (@MAP A A _ _ f l) = l
axiom thm_ALL2_AND_RIGHT : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ l : List A, ∀ m : List B, ∀ P : A -> Prop, ∀ Q : A -> B -> Prop, (@ALL2 A B _ _ (fun x : A => fun y : B => (P x) ∧ (Q x y)) l m) = ((@ALL A _ P l) ∧ (@ALL2 A B _ _ Q l m))
axiom thm_ITLIST_APPEND : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B -> B, ∀ a : B, ∀ l1 : List A, ∀ l2 : List A, (@ITLIST A B _ _ f (@APPEND A _ l1 l2) a) = (@ITLIST A B _ _ f l1 (@ITLIST A B _ _ f l2 a))
axiom thm_ITLIST_EXTRA : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (a : A) (b : B), ∀ f : A -> B -> B, ∀ l : List A, (@ITLIST A B _ _ f (@APPEND A _ l (@CONS A _ a (@NIL A _))) b) = (@ITLIST A B _ _ f l (f a b))
axiom thm_ALL_MP : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, ∀ l : List A, ((@ALL A _ (fun x : A => (P x) -> Q x) l) ∧ (@ALL A _ P l)) -> @ALL A _ Q l
axiom thm_AND_ALL : ∀ {A : Type*} [Nonempty A] (P : A -> Prop) (Q : A -> Prop), ∀ l : List A, ((@ALL A _ P l) ∧ (@ALL A _ Q l)) = (@ALL A _ (fun x : A => (P x) ∧ (Q x)) l)
axiom thm_EX_IMP : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, ∀ l : List A, ((∀ x : A, ((@MEM A _ x l) ∧ (P x)) -> Q x) ∧ (@EX A _ P l)) -> @EX A _ Q l
axiom thm_ALL_MEM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ l : List A, (∀ x : A, (@MEM A _ x l) -> P x) = (@ALL A _ P l)
axiom thm_LENGTH_REPLICATE : ∀ {A : Type*} [Nonempty A], ∀ n : Nat, ∀ x : A, (@LENGTH A _ (@REPLICATE A _ n x)) = n
axiom thm_MEM_REPLICATE : ∀ {A : Type*} [Nonempty A], ∀ n : Nat, ∀ x : A, ∀ y : A, (@MEM A _ x (@REPLICATE A _ n y)) = ((x = y) ∧ (¬ (n = (NUMERAL Nat.zero))))
axiom thm_EX_MAP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : B -> Prop, ∀ f : A -> B, ∀ l : List A, (@EX B _ P (@MAP A B _ _ f l)) = (@EX A _ (@o A B Prop _ _ _ P f) l)
axiom thm_EXISTS_EX : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, ∀ l : List B, (∃ x : A, @EX B _ (P x) l) = (@EX B _ (fun s : B => ∃ x : A, P x s) l)
axiom thm_FORALL_ALL : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, ∀ l : List B, (∀ x : A, @ALL B _ (P x) l) = (@ALL B _ (fun s : B => ∀ x : A, P x s) l)
axiom thm_MEM_APPEND : ∀ {A : Type*} [Nonempty A], ∀ x : A, ∀ l1 : List A, ∀ l2 : List A, (@MEM A _ x (@APPEND A _ l1 l2)) = ((@MEM A _ x l1) ∨ (@MEM A _ x l2))
axiom thm_MEM_MAP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ y : B, ∀ l : List A, (@MEM B _ y (@MAP A B _ _ f l)) = (∃ x : A, (@MEM A _ x l) ∧ (y = (f x)))
axiom thm_FILTER_APPEND : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ l1 : List A, ∀ l2 : List A, (@FILTER A _ P (@APPEND A _ l1 l2)) = (@APPEND A _ (@FILTER A _ P l1) (@FILTER A _ P l2))
axiom thm_FILTER_MAP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : B -> Prop, ∀ f : A -> B, ∀ l : List A, (@FILTER B _ P (@MAP A B _ _ f l)) = (@MAP A B _ _ f (@FILTER A _ (@o A B Prop _ _ _ P f) l))
axiom thm_MEM_FILTER : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ l : List A, ∀ x : A, (@MEM A _ x (@FILTER A _ P l)) = ((P x) ∧ (@MEM A _ x l))
axiom thm_LENGTH_FILTER : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ l : List A, Nat.le (@LENGTH A _ (@FILTER A _ P l)) (@LENGTH A _ l)
axiom thm_EX_MEM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ l : List A, (∃ x : A, (P x) ∧ (@MEM A _ x l)) = (@EX A _ P l)
axiom thm_MAP_FST_ZIP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ l1 : List A, ∀ l2 : List B, ((@LENGTH A _ l1) = (@LENGTH B _ l2)) -> (@MAP (prod A B) A _ _ (@prod_fst A B _ _) (@ZIP A B _ _ l1 l2)) = l1
axiom thm_MAP_SND_ZIP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ l1 : List A, ∀ l2 : List B, ((@LENGTH A _ l1) = (@LENGTH B _ l2)) -> (@MAP (prod A B) B _ _ (@prod_snd A B _ _) (@ZIP A B _ _ l1 l2)) = l2
axiom thm_LENGTH_ZIP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ l1 : List A, ∀ l2 : List B, ((@LENGTH A _ l1) = (@LENGTH B _ l2)) -> (@LENGTH (prod A B) _ (@ZIP A B _ _ l1 l2)) = (@LENGTH B _ l2)
axiom thm_MEM_ASSOC : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ l : List (prod A B), ∀ x : A, (@MEM (prod A B) _ (@prod_mk A B _ _ x (@ASSOC A B _ _ x l)) l) = (@MEM A _ x (@MAP (prod A B) A _ _ (@prod_fst A B _ _) l))
axiom thm_ALL_APPEND : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ l1 : List A, ∀ l2 : List A, (@ALL A _ P (@APPEND A _ l1 l2)) = ((@ALL A _ P l1) ∧ (@ALL A _ P l2))
axiom thm_MEM_EL : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ∀ n : Nat, (Nat.lt n (@LENGTH A _ l)) -> @MEM A _ (@EL A _ n l) l
axiom thm_MEM_EXISTS_EL : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ∀ x : A, (@MEM A _ x l) = (∃ i : Nat, (Nat.lt i (@LENGTH A _ l)) ∧ (x = (@EL A _ i l)))
axiom thm_ALL_EL : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ l : List A, (∀ i : Nat, (Nat.lt i (@LENGTH A _ l)) -> P (@EL A _ i l)) = (@ALL A _ P l)
axiom thm_ALL2_MAP2 : ∀ {A B C D : Type*} [Nonempty A] [Nonempty B] [Nonempty C] [Nonempty D] (P : B -> D -> Prop), ∀ f : A -> B, ∀ g : C -> D, ∀ l : List A, ∀ m : List C, (@ALL2 B D _ _ P (@MAP A B _ _ f l) (@MAP C D _ _ g m)) = (@ALL2 A C _ _ (fun x : A => fun y : C => P (f x) (g y)) l m)
axiom thm_AND_ALL2 : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, ∀ Q : A -> B -> Prop, ∀ l : List A, ∀ m : List B, ((@ALL2 A B _ _ P l m) ∧ (@ALL2 A B _ _ Q l m)) = (@ALL2 A B _ _ (fun x : A => fun y : B => (P x y) ∧ (Q x y)) l m)
axiom thm_ALLPAIRS_SYM : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, ∀ l : List A, ∀ m : List B, (@ALLPAIRS A B _ _ P l m) = (@ALLPAIRS B A _ _ (fun x : B => fun y : A => P y x) m l)
axiom thm_ALLPAIRS_MEM : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, ∀ l : List A, ∀ m : List B, (∀ x : A, ∀ y : B, ((@MEM A _ x l) ∧ (@MEM B _ y m)) -> P x y) = (@ALLPAIRS A B _ _ P l m)
axiom thm_ALLPAIRS_MAP : ∀ {A B C D : Type*} [Nonempty A] [Nonempty B] [Nonempty C] [Nonempty D], ∀ P : B -> D -> Prop, ∀ f : A -> B, ∀ g : C -> D, ∀ l : List A, ∀ m : List C, (@ALLPAIRS B D _ _ P (@MAP A B _ _ f l) (@MAP C D _ _ g m)) = (@ALLPAIRS A C _ _ (fun x : A => fun y : C => P (f x) (g y)) l m)
axiom thm_ALLPAIRS_EQ : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (R' : A -> B -> Prop) (R'' : A -> B -> Prop), ∀ l : List A, ∀ m : List B, ∀ P : A -> Prop, ∀ Q : B -> Prop, ((@ALL A _ P l) ∧ ((@ALL B _ Q m) ∧ (∀ p : A, ∀ q : B, ((P p) ∧ (Q q)) -> (R' p q) = (R'' p q)))) -> (@ALLPAIRS A B _ _ R' l m) = (@ALLPAIRS A B _ _ R'' l m)
axiom thm_ALL2_ALL : ∀ {A : Type*} [Nonempty A], ∀ P : A -> A -> Prop, ∀ l : List A, (@ALL2 A A _ _ P l l) = (@ALL A _ (fun x : A => P x x) l)
axiom thm_APPEND_EQ_NIL : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ∀ m : List A, ((@APPEND A _ l m) = (@NIL A _)) = ((l = (@NIL A _)) ∧ (m = (@NIL A _)))
axiom thm_APPEND_LCANCEL : ∀ {A : Type*} [Nonempty A], ∀ l1 : List A, ∀ l2 : List A, ∀ l3 : List A, ((@APPEND A _ l1 l2) = (@APPEND A _ l1 l3)) = (l2 = l3)
axiom thm_APPEND_RCANCEL : ∀ {A : Type*} [Nonempty A], ∀ l1 : List A, ∀ l2 : List A, ∀ l3 : List A, ((@APPEND A _ l1 l3) = (@APPEND A _ l2 l3)) = (l1 = l2)
axiom thm_LENGTH_MAP2 : ∀ {A B C : Type*} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : A -> B -> C, ∀ l : List A, ∀ m : List B, ((@LENGTH A _ l) = (@LENGTH B _ m)) -> (@LENGTH C _ (@MAP2 A B C _ _ _ f l m)) = (@LENGTH B _ m)
axiom thm_EL_MAP2 : ∀ {A B C : Type*} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : A -> B -> C, ∀ l : List A, ∀ m : List B, ∀ k : Nat, ((Nat.lt k (@LENGTH A _ l)) ∧ (Nat.lt k (@LENGTH B _ m))) -> (@EL C _ k (@MAP2 A B C _ _ _ f l m)) = (f (@EL A _ k l) (@EL B _ k m))
axiom thm_MAP_EQ_NIL : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ l : List A, ((@MAP A B _ _ f l) = (@NIL B _)) = (l = (@NIL A _))
axiom thm_INJECTIVE_MAP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, (∀ l : List A, ∀ m : List A, ((@MAP A B _ _ f l) = (@MAP A B _ _ f m)) -> l = m) = (∀ x : A, ∀ y : A, ((f x) = (f y)) -> x = y)
axiom thm_SURJECTIVE_MAP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, (∀ m : List B, ∃ l : List A, (@MAP A B _ _ f l) = m) = (∀ y : B, ∃ x : A, (f x) = y)
axiom thm_MAP_ID : ∀ {A : Type*} [Nonempty A], ∀ l : List A, (@MAP A A _ _ (fun x : A => x) l) = l
axiom thm_MAP_I : ∀ {A : Type*} [Nonempty A], (@MAP A A _ _ (@I A _)) = (@I (List A) _)
axiom thm_BUTLAST_CLAUSES : ∀ {A : Type*} [Nonempty A], ((@BUTLAST A _ (@NIL A _)) = (@NIL A _)) ∧ ((∀ a : A, (@BUTLAST A _ (@CONS A _ a (@NIL A _))) = (@NIL A _)) ∧ (∀ a : A, ∀ h : A, ∀ t : List A, (@BUTLAST A _ (@CONS A _ a (@CONS A _ h t))) = (@CONS A _ a (@BUTLAST A _ (@CONS A _ h t)))))
axiom thm_BUTLAST_APPEND : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ∀ m : List A, (@BUTLAST A _ (@APPEND A _ l m)) = (@COND (List A) _ (m = (@NIL A _)) (@BUTLAST A _ l) (@APPEND A _ l (@BUTLAST A _ m)))
axiom thm_APPEND_BUTLAST_LAST : ∀ {A : Type*} [Nonempty A], ∀ l : List A, (¬ (l = (@NIL A _))) -> (@APPEND A _ (@BUTLAST A _ l) (@CONS A _ (@LAST A _ l) (@NIL A _))) = l
axiom thm_LAST_APPEND : ∀ {A : Type*} [Nonempty A], ∀ p : List A, ∀ q : List A, (@LAST A _ (@APPEND A _ p q)) = (@COND A _ (q = (@NIL A _)) (@LAST A _ p) (@LAST A _ q))
axiom thm_LENGTH_TL : ∀ {A : Type*} [Nonempty A], ∀ l : List A, (¬ (l = (@NIL A _))) -> (@LENGTH A _ (@TL A _ l)) = (Nat.sub (@LENGTH A _ l) (NUMERAL (BIT1 Nat.zero)))
axiom thm_LAST_REVERSE : ∀ {A : Type*} [Nonempty A], ∀ l : List A, (¬ (l = (@NIL A _))) -> (@LAST A _ (@REVERSE A _ l)) = (@HD A _ l)
axiom thm_HD_REVERSE : ∀ {A : Type*} [Nonempty A], ∀ l : List A, (¬ (l = (@NIL A _))) -> (@HD A _ (@REVERSE A _ l)) = (@LAST A _ l)
axiom thm_EL_APPEND : ∀ {A : Type*} [Nonempty A], ∀ k : Nat, ∀ l : List A, ∀ m : List A, (@EL A _ k (@APPEND A _ l m)) = (@COND A _ (Nat.lt k (@LENGTH A _ l)) (@EL A _ k l) (@EL A _ (Nat.sub k (@LENGTH A _ l)) m))
axiom thm_EL_TL : ∀ {A : Type*} [Nonempty A] (l : List A), ∀ n : Nat, (@EL A _ n (@TL A _ l)) = (@EL A _ (Nat.add n (NUMERAL (BIT1 Nat.zero))) l)
axiom thm_EL_CONS : ∀ {A : Type*} [Nonempty A], ∀ n : Nat, ∀ h : A, ∀ t : List A, (@EL A _ n (@CONS A _ h t)) = (@COND A _ (n = (NUMERAL Nat.zero)) h (@EL A _ (Nat.sub n (NUMERAL (BIT1 Nat.zero))) t))
axiom thm_LAST_EL : ∀ {A : Type*} [Nonempty A], ∀ l : List A, (¬ (l = (@NIL A _))) -> (@LAST A _ l) = (@EL A _ (Nat.sub (@LENGTH A _ l) (NUMERAL (BIT1 Nat.zero))) l)
axiom thm_HD_APPEND : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ∀ m : List A, (@HD A _ (@APPEND A _ l m)) = (@COND A _ (l = (@NIL A _)) (@HD A _ m) (@HD A _ l))
axiom thm_CONS_HD_TL : ∀ {A : Type*} [Nonempty A], ∀ l : List A, (¬ (l = (@NIL A _))) -> l = (@CONS A _ (@HD A _ l) (@TL A _ l))
axiom thm_EL_MAP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ n : Nat, ∀ l : List A, (Nat.lt n (@LENGTH A _ l)) -> (@EL B _ n (@MAP A B _ _ f l)) = (f (@EL A _ n l))
axiom thm_MAP_REVERSE : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ l : List A, (@REVERSE B _ (@MAP A B _ _ f l)) = (@MAP A B _ _ f (@REVERSE A _ l))
axiom thm_ALL_FILTER : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, ∀ l : List A, (@ALL A _ P (@FILTER A _ Q l)) = (@ALL A _ (fun x : A => (Q x) -> P x) l)
axiom thm_APPEND_SING : ∀ {A : Type*} [Nonempty A], ∀ h : A, ∀ t : List A, (@APPEND A _ (@CONS A _ h (@NIL A _)) t) = (@CONS A _ h t)
axiom thm_MEM_APPEND_DECOMPOSE_LEFT : ∀ {A : Type*} [Nonempty A], ∀ x : A, ∀ l : List A, (@MEM A _ x l) = (∃ l1 : List A, ∃ l2 : List A, (¬ (@MEM A _ x l1)) ∧ (l = (@APPEND A _ l1 (@CONS A _ x l2))))
axiom thm_MEM_APPEND_DECOMPOSE : ∀ {A : Type*} [Nonempty A], ∀ x : A, ∀ l : List A, (@MEM A _ x l) = (∃ l1 : List A, ∃ l2 : List A, l = (@APPEND A _ l1 (@CONS A _ x l2)))
axiom thm_PAIRWISE_APPEND : ∀ {A : Type*} [Nonempty A], ∀ R' : A -> A -> Prop, ∀ l : List A, ∀ m : List A, (@PAIRWISE A _ R' (@APPEND A _ l m)) = ((@PAIRWISE A _ R' l) ∧ ((@PAIRWISE A _ R' m) ∧ (∀ x : A, ∀ y : A, ((@MEM A _ x l) ∧ (@MEM A _ y m)) -> R' x y)))
axiom thm_PAIRWISE_MAP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ R' : B -> B -> Prop, ∀ f : A -> B, ∀ l : List A, (@PAIRWISE B _ R' (@MAP A B _ _ f l)) = (@PAIRWISE A _ (fun x : A => fun y : A => R' (f x) (f y)) l)
axiom thm_PAIRWISE_IMPLIES : ∀ {A : Type*} [Nonempty A], ∀ R' : A -> A -> Prop, ∀ R'' : A -> A -> Prop, ∀ l : List A, ((@PAIRWISE A _ R' l) ∧ (∀ x : A, ∀ y : A, ((@MEM A _ x l) ∧ ((@MEM A _ y l) ∧ (R' x y))) -> R'' x y)) -> @PAIRWISE A _ R'' l
axiom thm_PAIRWISE_TRANSITIVE : ∀ {A : Type*} [Nonempty A], ∀ R' : A -> A -> Prop, ∀ x : A, ∀ y : A, ∀ l : List A, (∀ x' : A, ∀ y' : A, ∀ z : A, ((R' x' y') ∧ (R' y' z)) -> R' x' z) -> (@PAIRWISE A _ R' (@CONS A _ x (@CONS A _ y l))) = ((R' x y) ∧ (@PAIRWISE A _ R' (@CONS A _ y l)))
axiom thm_LENGTH_LIST_OF_SEQ : ∀ {A : Type*} [Nonempty A], ∀ s : Nat -> A, ∀ n : Nat, (@LENGTH A _ (@list_of_seq A _ s n)) = n
axiom thm_EL_LIST_OF_SEQ : ∀ {A : Type*} [Nonempty A], ∀ s : Nat -> A, ∀ m : Nat, ∀ n : Nat, (Nat.lt m n) -> (@EL A _ m (@list_of_seq A _ s n)) = (s m)
axiom thm_LIST_OF_SEQ_EQ_NIL : ∀ {A : Type*} [Nonempty A], ∀ s : Nat -> A, ∀ n : Nat, ((@list_of_seq A _ s n) = (@NIL A _)) = (n = (NUMERAL Nat.zero))
axiom thm_LIST_OF_SEQ_EQ_SELF : ∀ {A : Type*} [Nonempty A], ∀ l : List A, (@list_of_seq A _ (fun i : Nat => @EL A _ i l) (@LENGTH A _ l)) = l
axiom thm_LENGTH_EQ_LIST_OF_SEQ : ∀ {A : Type*} [Nonempty A], ∀ l : List A, ∀ n : Nat, ((@LENGTH A _ l) = n) = (l = (@list_of_seq A _ (fun i : Nat => @EL A _ i l) n))
axiom thm_MAP_LIST_OF_SEQ : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : Nat -> A, ∀ g : A -> B, ∀ n : Nat, (@MAP A B _ _ g (@list_of_seq A _ f n)) = (@list_of_seq B _ (@o Nat A B _ _ _ g f) n)
axiom thm_LIST_OF_SEQ : ∀ {A : Type*} [Nonempty A], (∀ f : Nat -> A, (@list_of_seq A _ f (NUMERAL Nat.zero)) = (@NIL A _)) ∧ (∀ f : Nat -> A, ∀ n : Nat, (@list_of_seq A _ f (Nat.succ n)) = (@CONS A _ (f (NUMERAL Nat.zero)) (@list_of_seq A _ (@o Nat Nat A _ _ _ f Nat.succ) n)))
axiom thm_MONO_ALL : ∀ {A : Type*} [Nonempty A] (P : A -> Prop) (Q : A -> Prop) (l : List A), (∀ x : A, (P x) -> Q x) -> (@ALL A _ P l) -> @ALL A _ Q l
axiom thm_MONO_ALL2 : ∀ {A B : Type*} [Nonempty A] [Nonempty B] (P : A -> B -> Prop) (Q : A -> B -> Prop) (l : List A) (l' : List B), (∀ x : A, ∀ y : B, (P x y) -> Q x y) -> (@ALL2 A B _ _ P l l') -> @ALL2 A B _ _ Q l l'
axiom thm_char_INDUCT : ∀ P : CHAR -> Prop, (∀ a0 : Prop, ∀ a1 : Prop, ∀ a2 : Prop, ∀ a3 : Prop, ∀ a4 : Prop, ∀ a5 : Prop, ∀ a6 : Prop, ∀ a7 : Prop, P (ASCII a0 a1 a2 a3 a4 a5 a6 a7)) -> ∀ x : CHAR, P x
axiom thm_char_RECURSION : ∀ {Z' : Type*} [Nonempty Z'], ∀ f : Prop -> Prop -> Prop -> Prop -> Prop -> Prop -> Prop -> Prop -> Z', ∃ fn : CHAR -> Z', ∀ a0 : Prop, ∀ a1 : Prop, ∀ a2 : Prop, ∀ a3 : Prop, ∀ a4 : Prop, ∀ a5 : Prop, ∀ a6 : Prop, ∀ a7 : Prop, (fn (ASCII a0 a1 a2 a3 a4 a5 a6 a7)) = (f a0 a1 a2 a3 a4 a5 a6 a7)
axiom thm_dist : ∀ n : Nat, ∀ m : Nat, (DIST (@prod_mk Nat Nat _ _ m n)) = (Nat.add (Nat.sub m n) (Nat.sub n m))
axiom thm_DIST_REFL : ∀ n : Nat, (DIST (@prod_mk Nat Nat _ _ n n)) = (NUMERAL Nat.zero)
axiom thm_DIST_LZERO : ∀ n : Nat, (DIST (@prod_mk Nat Nat _ _ (NUMERAL Nat.zero) n)) = n
axiom thm_DIST_RZERO : ∀ n : Nat, (DIST (@prod_mk Nat Nat _ _ n (NUMERAL Nat.zero))) = n
axiom thm_DIST_SYM : ∀ m : Nat, ∀ n : Nat, (DIST (@prod_mk Nat Nat _ _ m n)) = (DIST (@prod_mk Nat Nat _ _ n m))
axiom thm_DIST_LADD : ∀ m : Nat, ∀ p : Nat, ∀ n : Nat, (DIST (@prod_mk Nat Nat _ _ (Nat.add m n) (Nat.add m p))) = (DIST (@prod_mk Nat Nat _ _ n p))
axiom thm_DIST_RADD : ∀ m : Nat, ∀ p : Nat, ∀ n : Nat, (DIST (@prod_mk Nat Nat _ _ (Nat.add m p) (Nat.add n p))) = (DIST (@prod_mk Nat Nat _ _ m n))
axiom thm_DIST_LADD_0 : ∀ m : Nat, ∀ n : Nat, (DIST (@prod_mk Nat Nat _ _ (Nat.add m n) m)) = n
axiom thm_DIST_RADD_0 : ∀ m : Nat, ∀ n : Nat, (DIST (@prod_mk Nat Nat _ _ m (Nat.add m n))) = n
axiom thm_DIST_LMUL : ∀ m : Nat, ∀ n : Nat, ∀ p : Nat, (Nat.mul m (DIST (@prod_mk Nat Nat _ _ n p))) = (DIST (@prod_mk Nat Nat _ _ (Nat.mul m n) (Nat.mul m p)))
axiom thm_DIST_RMUL : ∀ m : Nat, ∀ n : Nat, ∀ p : Nat, (Nat.mul (DIST (@prod_mk Nat Nat _ _ m n)) p) = (DIST (@prod_mk Nat Nat _ _ (Nat.mul m p) (Nat.mul n p)))
axiom thm_DIST_EQ_0 : ∀ m : Nat, ∀ n : Nat, ((DIST (@prod_mk Nat Nat _ _ m n)) = (NUMERAL Nat.zero)) = (m = n)
axiom thm_DIST_ELIM_THM : ∀ (y : Nat) (x : Nat) (P : Nat -> Prop), (P (DIST (@prod_mk Nat Nat _ _ x y))) = (∀ d : Nat, ((x = (Nat.add y d)) -> P d) ∧ ((y = (Nat.add x d)) -> P d))
axiom thm_DIST_TRIANGLE_LE : ∀ m : Nat, ∀ n : Nat, ∀ p : Nat, ∀ q : Nat, (Nat.le (Nat.add (DIST (@prod_mk Nat Nat _ _ m n)) (DIST (@prod_mk Nat Nat _ _ n p))) q) -> Nat.le (DIST (@prod_mk Nat Nat _ _ m p)) q
axiom thm_DIST_TRIANGLES_LE : ∀ m : Nat, ∀ n : Nat, ∀ p : Nat, ∀ q : Nat, ∀ r : Nat, ∀ s : Nat, ((Nat.le (DIST (@prod_mk Nat Nat _ _ m n)) r) ∧ (Nat.le (DIST (@prod_mk Nat Nat _ _ p q)) s)) -> Nat.le (DIST (@prod_mk Nat Nat _ _ m p)) (Nat.add (DIST (@prod_mk Nat Nat _ _ n q)) (Nat.add r s))
axiom thm_BOUNDS_LINEAR : ∀ A : Nat, ∀ B : Nat, ∀ C : Nat, (∀ n : Nat, Nat.le (Nat.mul A n) (Nat.add (Nat.mul B n) C)) = (Nat.le A B)
axiom thm_BOUNDS_LINEAR_0 : ∀ A : Nat, ∀ B : Nat, (∀ n : Nat, Nat.le (Nat.mul A n) B) = (A = (NUMERAL Nat.zero))
axiom thm_BOUNDS_DIVIDED : ∀ P : Nat -> Nat, (∃ B : Nat, ∀ n : Nat, Nat.le (P n) B) = (∃ A : Nat, ∃ B : Nat, ∀ n : Nat, Nat.le (Nat.mul n (P n)) (Nat.add (Nat.mul A n) B))
axiom thm_BOUNDS_NOTZERO : ∀ P : Nat -> Nat -> Nat, ∀ A : Nat, ∀ B : Nat, (((P (NUMERAL Nat.zero) (NUMERAL Nat.zero)) = (NUMERAL Nat.zero)) ∧ (∀ m : Nat, ∀ n : Nat, Nat.le (P m n) (Nat.add (Nat.mul A (Nat.add m n)) B))) -> ∃ B' : Nat, ∀ m : Nat, ∀ n : Nat, Nat.le (P m n) (Nat.mul B' (Nat.add m n))
axiom thm_BOUNDS_IGNORE : ∀ P : Nat -> Nat, ∀ Q : Nat -> Nat, (∃ B : Nat, ∀ i : Nat, Nat.le (P i) (Nat.add (Q i) B)) = (∃ B : Nat, ∃ N' : Nat, ∀ i : Nat, (Nat.le N' i) -> Nat.le (P i) (Nat.add (Q i) B))
axiom thm_is_nadd : ∀ x : Nat -> Nat, (is_nadd x) = (∃ B : Nat, ∀ m : Nat, ∀ n : Nat, Nat.le (DIST (@prod_mk Nat Nat _ _ (Nat.mul m (x n)) (Nat.mul n (x m)))) (Nat.mul B (Nat.add m n)))
axiom thm_is_nadd_0 : is_nadd (fun n : Nat => NUMERAL Nat.zero)
axiom thm_NADD_CAUCHY : ∀ x : nadd, ∃ B : Nat, ∀ m : Nat, ∀ n : Nat, Nat.le (DIST (@prod_mk Nat Nat _ _ (Nat.mul m (dest_nadd x n)) (Nat.mul n (dest_nadd x m)))) (Nat.mul B (Nat.add m n))
axiom thm_NADD_BOUND : ∀ x : nadd, ∃ A : Nat, ∃ B : Nat, ∀ n : Nat, Nat.le (dest_nadd x n) (Nat.add (Nat.mul A n) B)
axiom thm_NADD_MULTIPLICATIVE : ∀ x : nadd, ∃ B : Nat, ∀ m : Nat, ∀ n : Nat, Nat.le (DIST (@prod_mk Nat Nat _ _ (dest_nadd x (Nat.mul m n)) (Nat.mul m (dest_nadd x n)))) (Nat.add (Nat.mul B m) B)
axiom thm_NADD_ADDITIVE : ∀ x : nadd, ∃ B : Nat, ∀ m : Nat, ∀ n : Nat, Nat.le (DIST (@prod_mk Nat Nat _ _ (dest_nadd x (Nat.add m n)) (Nat.add (dest_nadd x m) (dest_nadd x n)))) B
axiom thm_NADD_SUC : ∀ x : nadd, ∃ B : Nat, ∀ n : Nat, Nat.le (DIST (@prod_mk Nat Nat _ _ (dest_nadd x (Nat.succ n)) (dest_nadd x n))) B
axiom thm_NADD_DIST_LEMMA : ∀ x : nadd, ∃ B : Nat, ∀ m : Nat, ∀ n : Nat, Nat.le (DIST (@prod_mk Nat Nat _ _ (dest_nadd x (Nat.add m n)) (dest_nadd x m))) (Nat.mul B n)
axiom thm_NADD_DIST : ∀ x : nadd, ∃ B : Nat, ∀ m : Nat, ∀ n : Nat, Nat.le (DIST (@prod_mk Nat Nat _ _ (dest_nadd x m) (dest_nadd x n))) (Nat.mul B (DIST (@prod_mk Nat Nat _ _ m n)))
axiom thm_NADD_ALTMUL : ∀ x : nadd, ∀ y : nadd, ∃ A : Nat, ∃ B : Nat, ∀ n : Nat, Nat.le (DIST (@prod_mk Nat Nat _ _ (Nat.mul n (dest_nadd x (dest_nadd y n))) (Nat.mul (dest_nadd x n) (dest_nadd y n)))) (Nat.add (Nat.mul A n) B)
axiom thm_nadd_eq : ∀ x : nadd, ∀ y : nadd, (nadd_eq x y) = (∃ B : Nat, ∀ n : Nat, Nat.le (DIST (@prod_mk Nat Nat _ _ (dest_nadd x n) (dest_nadd y n))) B)
axiom thm_NADD_EQ_REFL : ∀ x : nadd, nadd_eq x x
axiom thm_NADD_EQ_SYM : ∀ x : nadd, ∀ y : nadd, (nadd_eq x y) = (nadd_eq y x)
axiom thm_NADD_EQ_TRANS : ∀ x : nadd, ∀ y : nadd, ∀ z : nadd, ((nadd_eq x y) ∧ (nadd_eq y z)) -> nadd_eq x z
axiom thm_nadd_of_num : ∀ k : Nat, (nadd_of_num k) = (mk_nadd (fun n : Nat => Nat.mul k n))
