axiom thm_NUMSUM : ∀ b : Prop, ∀ x : Nat, (NUMSUM b x) = (@COND Nat _ b (Nat.succ (Nat.mul (NUMERAL (BIT0 (BIT1 Nat.zero))) x)) (Nat.mul (NUMERAL (BIT0 (BIT1 Nat.zero))) x))
