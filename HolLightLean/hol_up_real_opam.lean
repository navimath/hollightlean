axiom thm_NADD_ADD_ASSOC : ∀ x : nadd, ∀ y : nadd, ∀ z : nadd, nadd_eq (nadd_add x (nadd_add y z)) (nadd_add (nadd_add x y) z)
axiom thm_NADD_ADD_LID : ∀ x : nadd, nadd_eq (nadd_add (nadd_of_num (NUMERAL Nat.zero)) x) x
axiom thm_NADD_ADD_LCANCEL : ∀ x : nadd, ∀ y : nadd, ∀ z : nadd, (nadd_eq (nadd_add x y) (nadd_add x z)) -> nadd_eq y z
axiom thm_NADD_LE_ADD : ∀ x : nadd, ∀ y : nadd, nadd_le x (nadd_add x y)
axiom thm_NADD_LE_EXISTS : ∀ x : nadd, ∀ y : nadd, (nadd_le x y) -> ∃ d : nadd, nadd_eq y (nadd_add x d)
axiom thm_NADD_OF_NUM_ADD : ∀ m : Nat, ∀ n : Nat, nadd_eq (nadd_add (nadd_of_num m) (nadd_of_num n)) (nadd_of_num (Nat.add m n))
axiom thm_nadd_mul : ∀ x : nadd, ∀ y : nadd, (nadd_mul x y) = (mk_nadd (fun n : Nat => dest_nadd x (dest_nadd y n)))
axiom thm_NADD_MUL : ∀ x : nadd, ∀ y : nadd, (dest_nadd (nadd_mul x y)) = (fun n : Nat => dest_nadd x (dest_nadd y n))
