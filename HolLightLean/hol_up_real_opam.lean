axiom thm_ARITH_MULT : (∀ m : Nat, ∀ n : Nat, (Nat.mul (NUMERAL m) (NUMERAL n)) = (NUMERAL (Nat.mul m n))) ∧ (((Nat.mul Nat.zero Nat.zero) = Nat.zero) ∧ ((∀ n : Nat, (Nat.mul Nat.zero (BIT0 n)) = Nat.zero) ∧ ((∀ n : Nat, (Nat.mul Nat.zero (BIT1 n)) = Nat.zero) ∧ ((∀ n : Nat, (Nat.mul (BIT0 n) Nat.zero) = Nat.zero) ∧ ((∀ n : Nat, (Nat.mul (BIT1 n) Nat.zero) = Nat.zero) ∧ ((∀ m : Nat, ∀ n : Nat, (Nat.mul (BIT0 m) (BIT0 n)) = (BIT0 (BIT0 (Nat.mul m n)))) ∧ ((∀ m : Nat, ∀ n : Nat, (Nat.mul (BIT0 m) (BIT1 n)) = (Nat.add (BIT0 m) (BIT0 (BIT0 (Nat.mul m n))))) ∧ ((∀ m : Nat, ∀ n : Nat, (Nat.mul (BIT1 m) (BIT0 n)) = (Nat.add (BIT0 n) (BIT0 (BIT0 (Nat.mul m n))))) ∧ (∀ m : Nat, ∀ n : Nat, (Nat.mul (BIT1 m) (BIT1 n)) = (Nat.add (BIT1 m) (Nat.add (BIT0 n) (BIT0 (BIT0 (Nat.mul m n))))))))))))))
