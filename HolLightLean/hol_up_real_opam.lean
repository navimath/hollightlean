axiom thm_T_DEF : True = ((fun p : Prop => p) = (fun p : Prop => p))
axiom thm_AND_DEF : And = (fun p : Prop => fun q : Prop => (fun f : Prop -> Prop -> Prop => f p q) = (fun f : Prop -> Prop -> Prop => f True True))
axiom thm_IMP_DEF : imp = (fun p : Prop => fun q : Prop => (p ∧ q) = p)
axiom thm_FORALL_DEF : ∀ {A : Type*} [Nonempty A], (@FORALL A _) = (fun P : A -> Prop => P = (fun x : A => True))
axiom thm_EXISTS_DEF : ∀ {A : Type*} [Nonempty A], (@EXISTS A _) = (fun P : A -> Prop => ∀ q : Prop, (∀ x : A, (P x) -> q) -> q)
axiom thm_OR_DEF : Or = (fun p : Prop => fun q : Prop => ∀ r : Prop, (p -> r) -> (q -> r) -> r)
axiom thm_F_DEF : False = (∀ p : Prop, p)
axiom thm_NOT_DEF : Not = (fun p : Prop => p -> False)
axiom thm_EXISTS_UNIQUE_DEF : ∀ {A : Type*} [Nonempty A], (@EXISTSUNIQUE A _) = (fun P : A -> Prop => (EXISTS P) ∧ (∀ x : A, ∀ y : A, ((P x) ∧ (P y)) -> x = y))
axiom thm__FALSITY_ : _FALSITY_ = False
axiom thm_EQ_REFL : ∀ {A : Type*} [Nonempty A], ∀ x : A, x = x
axiom thm_REFL_CLAUSE : ∀ {A : Type*} [Nonempty A], ∀ x : A, (x = x) = True
axiom thm_EQ_SYM : ∀ {A : Type*} [Nonempty A], ∀ x : A, ∀ y : A, (x = y) -> y = x
axiom thm_EQ_SYM_EQ : ∀ {A : Type*} [Nonempty A], ∀ x : A, ∀ y : A, (x = y) = (y = x)
axiom thm_EQ_TRANS : ∀ {A : Type*} [Nonempty A], ∀ x : A, ∀ y : A, ∀ z : A, ((x = y) ∧ (y = z)) -> x = z
axiom thm_BETA_THM : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ y : A, ((fun x : A => f x) y) = (f y)
axiom thm_ABS_SIMP : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ t1 : A, ∀ t2 : B, ((fun x : B => t1) t2) = t1
axiom thm_CONJ_ASSOC : ∀ t1 : Prop, ∀ t2 : Prop, ∀ t3 : Prop, (t1 ∧ (t2 ∧ t3)) = ((t1 ∧ t2) ∧ t3)
axiom thm_CONJ_SYM : ∀ t1 : Prop, ∀ t2 : Prop, (t1 ∧ t2) = (t2 ∧ t1)
axiom thm_CONJ_ACI : ∀ (r : Prop) (p : Prop) (q : Prop), ((p ∧ q) = (q ∧ p)) ∧ ((((p ∧ q) ∧ r) = (p ∧ (q ∧ r))) ∧ (((p ∧ (q ∧ r)) = (q ∧ (p ∧ r))) ∧ (((p ∧ p) = p) ∧ ((p ∧ (p ∧ q)) = (p ∧ q)))))
axiom thm_DISJ_ASSOC : ∀ t1 : Prop, ∀ t2 : Prop, ∀ t3 : Prop, (t1 ∨ (t2 ∨ t3)) = ((t1 ∨ t2) ∨ t3)
axiom thm_DISJ_SYM : ∀ t1 : Prop, ∀ t2 : Prop, (t1 ∨ t2) = (t2 ∨ t1)
axiom thm_DISJ_ACI : ∀ (r : Prop) (p : Prop) (q : Prop), ((p ∨ q) = (q ∨ p)) ∧ ((((p ∨ q) ∨ r) = (p ∨ (q ∨ r))) ∧ (((p ∨ (q ∨ r)) = (q ∨ (p ∨ r))) ∧ (((p ∨ p) = p) ∧ ((p ∨ (p ∨ q)) = (p ∨ q)))))
axiom thm_IMP_CONJ : ∀ (p : Prop) (q : Prop) (r : Prop), ((p ∧ q) -> r) = (p -> q -> r)
axiom thm_IMP_CONJ_ALT : ∀ (q : Prop) (p : Prop) (r : Prop), ((p ∧ q) -> r) = (q -> p -> r)
axiom thm_LEFT_OR_DISTRIB : ∀ p : Prop, ∀ q : Prop, ∀ r : Prop, (p ∧ (q ∨ r)) = ((p ∧ q) ∨ (p ∧ r))
axiom thm_RIGHT_OR_DISTRIB : ∀ p : Prop, ∀ q : Prop, ∀ r : Prop, ((p ∨ q) ∧ r) = ((p ∧ r) ∨ (q ∧ r))
axiom thm_FORALL_SIMP : ∀ {A : Type*} [Nonempty A], ∀ t : Prop, (∀ x : A, t) = t
axiom thm_EXISTS_SIMP : ∀ {A : Type*} [Nonempty A], ∀ t : Prop, (∃ x : A, t) = t
axiom thm_EQ_CLAUSES : ∀ t : Prop, ((True = t) = t) ∧ (((t = True) = t) ∧ (((False = t) = (¬ t)) ∧ ((t = False) = (¬ t))))
axiom thm_NOT_CLAUSES_WEAK : ((¬ True) = False) ∧ ((¬ False) = True)
axiom thm_AND_CLAUSES : ∀ t : Prop, ((True ∧ t) = t) ∧ (((t ∧ True) = t) ∧ (((False ∧ t) = False) ∧ (((t ∧ False) = False) ∧ ((t ∧ t) = t))))
axiom thm_OR_CLAUSES : ∀ t : Prop, ((True ∨ t) = True) ∧ (((t ∨ True) = True) ∧ (((False ∨ t) = t) ∧ (((t ∨ False) = t) ∧ ((t ∨ t) = t))))
axiom thm_IMP_CLAUSES : ∀ t : Prop, ((True -> t) = t) ∧ (((t -> True) = True) ∧ (((False -> t) = True) ∧ (((t -> t) = True) ∧ ((t -> False) = (¬ t)))))
axiom thm_EXISTS_UNIQUE_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, (@EXISTSUNIQUE A _ (fun x : A => P x)) = ((∃ x : A, P x) ∧ (∀ x : A, ∀ x' : A, ((P x) ∧ (P x')) -> x = x'))
axiom thm_EXISTS_REFL : ∀ {A : Type*} [Nonempty A], ∀ a : A, ∃ x : A, x = a
axiom thm_EXISTS_UNIQUE_REFL : ∀ {A : Type*} [Nonempty A], ∀ a : A, @EXISTSUNIQUE A _ (fun x : A => x = a)
axiom thm_UNWIND_THM1 : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ a : A, (∃ x : A, (a = x) ∧ (P x)) = (P a)
axiom thm_UNWIND_THM2 : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ a : A, (∃ x : A, (x = a) ∧ (P x)) = (P a)
axiom thm_FORALL_UNWIND_THM2 : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ a : A, (∀ x : A, (x = a) -> P x) = (P a)
axiom thm_FORALL_UNWIND_THM1 : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ a : A, (∀ x : A, (a = x) -> P x) = (P a)
axiom thm_SWAP_FORALL_THM : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, (∀ x : A, ∀ y : B, P x y) = (∀ y : B, ∀ x : A, P x y)
axiom thm_SWAP_EXISTS_THM : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, (∃ x : A, ∃ y : B, P x y) = (∃ y : B, ∃ x : A, P x y)
axiom thm_FORALL_AND_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, (∀ x : A, (P x) ∧ (Q x)) = ((∀ x : A, P x) ∧ (∀ x : A, Q x))
axiom thm_AND_FORALL_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, ((∀ x : A, P x) ∧ (∀ x : A, Q x)) = (∀ x : A, (P x) ∧ (Q x))
axiom thm_LEFT_AND_FORALL_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, ((∀ x : A, P x) ∧ Q) = (∀ x : A, (P x) ∧ Q)
axiom thm_RIGHT_AND_FORALL_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, (P ∧ (∀ x : A, Q x)) = (∀ x : A, P ∧ (Q x))
axiom thm_EXISTS_OR_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, (∃ x : A, (P x) ∨ (Q x)) = ((∃ x : A, P x) ∨ (∃ x : A, Q x))
axiom thm_OR_EXISTS_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : A -> Prop, ((∃ x : A, P x) ∨ (∃ x : A, Q x)) = (∃ x : A, (P x) ∨ (Q x))
axiom thm_LEFT_OR_EXISTS_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, ((∃ x : A, P x) ∨ Q) = (∃ x : A, (P x) ∨ Q)
axiom thm_RIGHT_OR_EXISTS_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, (P ∨ (∃ x : A, Q x)) = (∃ x : A, P ∨ (Q x))
axiom thm_LEFT_EXISTS_AND_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, (∃ x : A, (P x) ∧ Q) = ((∃ x : A, P x) ∧ Q)
axiom thm_RIGHT_EXISTS_AND_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, (∃ x : A, P ∧ (Q x)) = (P ∧ (∃ x : A, Q x))
axiom thm_TRIV_EXISTS_AND_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : Prop, (∃ x : A, P ∧ Q) = ((∃ x : A, P) ∧ (∃ x : A, Q))
axiom thm_LEFT_AND_EXISTS_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, ((∃ x : A, P x) ∧ Q) = (∃ x : A, (P x) ∧ Q)
axiom thm_RIGHT_AND_EXISTS_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, (P ∧ (∃ x : A, Q x)) = (∃ x : A, P ∧ (Q x))
axiom thm_TRIV_AND_EXISTS_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : Prop, ((∃ x : A, P) ∧ (∃ x : A, Q)) = (∃ x : A, P ∧ Q)
axiom thm_TRIV_FORALL_OR_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : Prop, (∀ x : A, P ∨ Q) = ((∀ x : A, P) ∨ (∀ x : A, Q))
axiom thm_TRIV_OR_FORALL_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : Prop, ((∀ x : A, P) ∨ (∀ x : A, Q)) = (∀ x : A, P ∨ Q)
axiom thm_RIGHT_IMP_FORALL_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, (P -> ∀ x : A, Q x) = (∀ x : A, P -> Q x)
axiom thm_RIGHT_FORALL_IMP_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, (∀ x : A, P -> Q x) = (P -> ∀ x : A, Q x)
axiom thm_LEFT_IMP_EXISTS_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, ((∃ x : A, P x) -> Q) = (∀ x : A, (P x) -> Q)
axiom thm_LEFT_FORALL_IMP_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, (∀ x : A, (P x) -> Q) = ((∃ x : A, P x) -> Q)
axiom thm_TRIV_FORALL_IMP_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : Prop, (∀ x : A, P -> Q) = ((∃ x : A, P) -> ∀ x : A, Q)
axiom thm_TRIV_EXISTS_IMP_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : Prop, (∃ x : A, P -> Q) = ((∀ x : A, P) -> ∃ x : A, Q)
axiom thm_MONO_FORALL : ∀ {A : Type*} [Nonempty A] (P : A -> Prop) (Q : A -> Prop), (∀ x : A, (P x) -> Q x) -> (∀ x : A, P x) -> ∀ x : A, Q x
axiom thm_MONO_EXISTS : ∀ {A : Type*} [Nonempty A] (P : A -> Prop) (Q : A -> Prop), (∀ x : A, (P x) -> Q x) -> (∃ x : A, P x) -> ∃ x : A, Q x
axiom thm_WLOG_RELATION : ∀ {A : Type*} [Nonempty A], ∀ R' : A -> A -> Prop, ∀ P : A -> A -> Prop, ((∀ x : A, ∀ y : A, (P x y) -> P y x) ∧ ((∀ x : A, ∀ y : A, (R' x y) ∨ (R' y x)) ∧ (∀ x : A, ∀ y : A, (R' x y) -> P x y))) -> ∀ x : A, ∀ y : A, P x y
axiom thm_EXISTS_UNIQUE_ALT : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, (@EXISTSUNIQUE A _ (fun x : A => P x)) = (∃ x : A, ∀ y : A, (P y) = (x = y))
axiom thm_EXISTS_UNIQUE : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, (@EXISTSUNIQUE A _ (fun x : A => P x)) = (∃ x : A, (P x) ∧ (∀ y : A, (P y) -> y = x))
axiom thm_ETA_AX : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ t : A -> B, (fun x : A => t x) = t
axiom thm_EQ_EXT : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ g : A -> B, (∀ x : A, (f x) = (g x)) -> f = g
axiom thm_FUN_EQ_THM : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, ∀ g : A -> B, (f = g) = (∀ x : A, (f x) = (g x))
axiom thm_SELECT_AX : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ x : A, (P x) -> P (@Classical.epsilon A _ P)
axiom thm_EXISTS_THM : ∀ {A : Type*} [Nonempty A], (@EXISTS A _) = (fun P : A -> Prop => P (@Classical.epsilon A _ P))
axiom thm_SELECT_REFL : ∀ {A : Type*} [Nonempty A], ∀ x : A, (@Classical.epsilon A _ (fun y : A => y = x)) = x
axiom thm_SELECT_UNIQUE : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ x : A, (∀ y : A, (P y) = (y = x)) -> (@Classical.epsilon A _ P) = x
axiom thm_EXCLUDED_MIDDLE : ∀ t : Prop, t ∨ (¬ t)
axiom thm_BOOL_CASES_AX : ∀ t : Prop, (t = True) ∨ (t = False)
axiom thm_DE_MORGAN_THM : ∀ t1 : Prop, ∀ t2 : Prop, ((¬ (t1 ∧ t2)) = ((¬ t1) ∨ (¬ t2))) ∧ ((¬ (t1 ∨ t2)) = ((¬ t1) ∧ (¬ t2)))
axiom thm_NOT_CLAUSES : (∀ t : Prop, (¬ (¬ t)) = t) ∧ (((¬ True) = False) ∧ ((¬ False) = True))
axiom thm_NOT_IMP : ∀ t1 : Prop, ∀ t2 : Prop, (¬ (t1 -> t2)) = (t1 ∧ (¬ t2))
axiom thm_CONTRAPOS_THM : ∀ t1 : Prop, ∀ t2 : Prop, ((¬ t1) -> ¬ t2) = (t2 -> t1)
axiom thm_NOT_EXISTS_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, (¬ (∃ x : A, P x)) = (∀ x : A, ¬ (P x))
axiom thm_EXISTS_NOT_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, (∃ x : A, ¬ (P x)) = (¬ (∀ x : A, P x))
axiom thm_NOT_FORALL_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, (¬ (∀ x : A, P x)) = (∃ x : A, ¬ (P x))
axiom thm_FORALL_NOT_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, (∀ x : A, ¬ (P x)) = (¬ (∃ x : A, P x))
axiom thm_FORALL_BOOL_THM : ∀ (P : Prop -> Prop), (∀ b : Prop, P b) = ((P True) ∧ (P False))
axiom thm_EXISTS_BOOL_THM : ∀ (P : Prop -> Prop), (∃ b : Prop, P b) = ((P True) ∨ (P False))
axiom thm_LEFT_FORALL_OR_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, (∀ x : A, (P x) ∨ Q) = ((∀ x : A, P x) ∨ Q)
axiom thm_RIGHT_FORALL_OR_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, (∀ x : A, P ∨ (Q x)) = (P ∨ (∀ x : A, Q x))
axiom thm_LEFT_OR_FORALL_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, ((∀ x : A, P x) ∨ Q) = (∀ x : A, (P x) ∨ Q)
axiom thm_RIGHT_OR_FORALL_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, (P ∨ (∀ x : A, Q x)) = (∀ x : A, P ∨ (Q x))
axiom thm_LEFT_IMP_FORALL_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, ((∀ x : A, P x) -> Q) = (∃ x : A, (P x) -> Q)
axiom thm_LEFT_EXISTS_IMP_THM : ∀ {A : Type*} [Nonempty A], ∀ P : A -> Prop, ∀ Q : Prop, (∃ x : A, (P x) -> Q) = ((∀ x : A, P x) -> Q)
axiom thm_RIGHT_IMP_EXISTS_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, (P -> ∃ x : A, Q x) = (∃ x : A, P -> Q x)
axiom thm_RIGHT_EXISTS_IMP_THM : ∀ {A : Type*} [Nonempty A], ∀ P : Prop, ∀ Q : A -> Prop, (∃ x : A, P -> Q x) = (P -> ∃ x : A, Q x)
axiom thm_COND_DEF : ∀ {A : Type*} [Nonempty A], (@COND A _) = (fun t : Prop => fun t1 : A => fun t2 : A => @Classical.epsilon A _ (fun x : A => ((t = True) -> x = t1) ∧ ((t = False) -> x = t2)))
axiom thm_COND_CLAUSES : ∀ {A : Type*} [Nonempty A], ∀ t1 : A, ∀ t2 : A, ((@COND A _ True t1 t2) = t1) ∧ ((@COND A _ False t1 t2) = t2)
axiom thm_COND_EXPAND : ∀ b : Prop, ∀ t1 : Prop, ∀ t2 : Prop, (@COND Prop _ b t1 t2) = (((¬ b) ∨ t1) ∧ (b ∨ t2))
axiom thm_COND_ID : ∀ {A : Type*} [Nonempty A], ∀ b : Prop, ∀ t : A, (@COND A _ b t t) = t
axiom thm_COND_RAND : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ b : Prop, ∀ f : A -> B, ∀ x : A, ∀ y : A, (f (@COND A _ b x y)) = (@COND B _ b (f x) (f y))
axiom thm_COND_RATOR : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ b : Prop, ∀ f : A -> B, ∀ g : A -> B, ∀ x : A, (@COND (A -> B) _ b f g x) = (@COND B _ b (f x) (g x))
axiom thm_COND_ABS : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ b : Prop, ∀ f : A -> B, ∀ g : A -> B, (fun x : A => @COND B _ b (f x) (g x)) = (@COND (A -> B) _ b f g)
axiom thm_COND_SWAP : ∀ {A : Type*} [Nonempty A], ∀ p : Prop, ∀ x : A, ∀ y : A, (@COND A _ (¬ p) x y) = (@COND A _ p y x)
axiom thm_MONO_COND : ∀ (A : Prop) (C : Prop) (b : Prop) (B : Prop) (D : Prop), ((A -> B) ∧ (C -> D)) -> (@COND Prop _ b A C) -> @COND Prop _ b B D
axiom thm_COND_ELIM_THM : ∀ {A : Type*} [Nonempty A] (x : A) (c : Prop) (P : A -> Prop) (y : A), (P (@COND A _ c x y)) = ((c -> P x) ∧ ((¬ c) -> P y))
axiom thm_SKOLEM_THM : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, (∀ x : A, ∃ y : B, P x y) = (∃ y : A -> B, ∀ x : A, P x (y x))
axiom thm_SKOLEM_THM_GEN : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : A -> Prop, ∀ R' : A -> B -> Prop, (∀ x : A, (P x) -> ∃ y : B, R' x y) = (∃ f : A -> B, ∀ x : A, (P x) -> R' x (f x))
axiom thm_UNIQUE_SKOLEM_ALT : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, (∀ x : A, @EXISTSUNIQUE B _ (fun y : B => P x y)) = (∃ f : A -> B, ∀ x : A, ∀ y : B, (P x y) = ((f x) = y))
axiom thm_UNIQUE_SKOLEM_THM : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ P : A -> B -> Prop, (∀ x : A, @EXISTSUNIQUE B _ (fun y : B => P x y)) = (@EXISTSUNIQUE (A -> B) _ (fun f : A -> B => ∀ x : A, P x (f x)))
axiom thm_bool_INDUCT : ∀ P : Prop -> Prop, ((P False) ∧ (P True)) -> ∀ x : Prop, P x
axiom thm_bool_RECURSION : ∀ {A : Type*} [Nonempty A], ∀ a : A, ∀ b : A, ∃ f : Prop -> A, ((f False) = a) ∧ ((f True) = b)
axiom thm_o_DEF : ∀ {A B C : Type*} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : B -> C, ∀ g : A -> B, (@o A B C _ _ _ f g) = (fun x : A => f (g x))
axiom thm_I_DEF : ∀ {A : Type*} [Nonempty A], (@I A _) = (fun x : A => x)
axiom thm_o_THM : ∀ {A B C : Type*} [Nonempty A] [Nonempty B] [Nonempty C], ∀ f : B -> C, ∀ g : A -> B, ∀ x : A, (@o A B C _ _ _ f g x) = (f (g x))
axiom thm_o_ASSOC : ∀ {A B C D : Type*} [Nonempty A] [Nonempty B] [Nonempty C] [Nonempty D], ∀ f : C -> D, ∀ g : B -> C, ∀ h : A -> B, (@o A C D _ _ _ f (@o A B C _ _ _ g h)) = (@o A B D _ _ _ (@o B C D _ _ _ f g) h)
axiom thm_I_THM : ∀ {A : Type*} [Nonempty A], ∀ x : A, (@I A _ x) = x
axiom thm_I_O_ID : ∀ {A B : Type*} [Nonempty A] [Nonempty B], ∀ f : A -> B, ((@o A B B _ _ _ (@I B _) f) = f) ∧ ((@o A A B _ _ _ f (@I A _)) = f)
axiom thm_EXISTS_ONE_REP : ∃ b : Prop, b
axiom thm_one_DEF : () = (@Classical.epsilon Unit _ (fun x : Unit => True))
axiom thm_one : ∀ v : Unit, v = ()
axiom thm_one_axiom : ∀ {A : Type*} [Nonempty A], ∀ f : A -> Unit, ∀ g : A -> Unit, f = g
axiom thm_one_INDUCT : ∀ P : Unit -> Prop, (P ()) -> ∀ x : Unit, P x
axiom thm_one_RECURSION : ∀ {A : Type*} [Nonempty A], ∀ e : A, ∃ fn : Unit -> A, (fn ()) = e
axiom thm_one_Axiom : ∀ {A : Type*} [Nonempty A], ∀ e : A, @EXISTSUNIQUE (Unit -> A) _ (fun fn : Unit -> A => (fn ()) = e)
