axiom thm_ARITH_EQ : (∀ m : Nat, ∀ n : Nat, ((NUMERAL m) = (NUMERAL n)) = (m = n)) ∧ (((Nat.zero = Nat.zero) = True) ∧ ((∀ n : Nat, ((BIT0 n) = Nat.zero) = (n = Nat.zero)) ∧ ((∀ n : Nat, ((BIT1 n) = Nat.zero) = False) ∧ ((∀ n : Nat, (Nat.zero = (BIT0 n)) = (Nat.zero = n)) ∧ ((∀ n : Nat, (Nat.zero = (BIT1 n)) = False) ∧ ((∀ m : Nat, ∀ n : Nat, ((BIT0 m) = (BIT0 n)) = (m = n)) ∧ ((∀ m : Nat, ∀ n : Nat, ((BIT0 m) = (BIT1 n)) = False) ∧ ((∀ m : Nat, ∀ n : Nat, ((BIT1 m) = (BIT0 n)) = False) ∧ (∀ m : Nat, ∀ n : Nat, ((BIT1 m) = (BIT1 n)) = (m = n))))))))))
