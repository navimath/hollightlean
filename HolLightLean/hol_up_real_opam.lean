axiom thm_ZBOT : ∀ {A : Type*} [Nonempty A], (@ZBOT A _) = (@INJP A _ (@INJN A _ (NUMERAL Nat.zero)) (@Classical.epsilon (Nat -> A -> Prop) _ (fun z : Nat -> A -> Prop => True)))
