theorem or_elim {p q : Prop} (h : p ∨ q) {r : Prop} (h1 : p -> r) (h2: q -> r) : r := Or.elim h h1 h2


theorem ex_elim {a : Type*} {p : a -> Prop} (h1 : exists x, p x)
    {r : Prop} (h2 : forall x : a, (p x) -> r) : r := Exists.elim h1 h2

