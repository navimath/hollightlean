/-- `1` is the unique two-sided unit of multiplication, so it is what `neutral` picks. -/
theorem neutral_mul {M : Type _} [CommMonoid M] [Nonempty M] :
    @neutral M _ (fun x y : M => x * y) = 1 := by
  symm
  unfold neutral
  apply align_epsilon
  · intro y ; exact ⟨one_mul y, mul_one y⟩
  · intro x _ hx
    have h := (hx 1).1
    dsimp only at h
    rw [mul_one] at h
    exact h.symm

