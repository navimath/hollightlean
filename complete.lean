theorem MK_COMB {α β : Type*} {s t : α -> β } {u v : α } (h1 : s = t) (h2 : u = v) : s u = t v := by
    rw [h1, h2]

theorem EQ_MP {p q : Prop} (e : p = q) (h : p) : q := by
 subst e ; exact h

